test_dump_report.py
test_build_version.py
test_ui_live_smoke_lib.py
test_ui_live_smoke_footage.py
test_ui_live_smoke_failure.py
# Integration finding (#455): the two halves of the backend active span were
# briefed from the issue text, not from each other, so the UI read
# `backend_activity_span` / `start_observed` / `executions_count` while the
# server emits `backend_activity: {span}` / `start_ns` / `exec_starts` -- and
# the Queries cell drew "Not measured" over a measured, closed, 420 ms span
# while every Node unit test stayed green on the UI half's own placeholder
# shape. tests/web_unit/backend-span-wire.test.mjs renders the REAL shape
# from a checked-in fixture; this guard keeps that fixture equal to what
# tests/mock_server.py serves, because a stale fixture is how the gate would
# go blind a second time. It REFUSES (never approves) on a missing, empty,
# unparseable or vacuous fixture and on a mock that cannot answer.
test_mock_backend_activity_fixture.py
# Offline multi-window CLI gate: production ring/output driven by scripted
# cumulative snapshots; literal expectations for each horizon, plus three
# mutation refusals. Also guards #202's cross-tick parser contamination.
test_multi_window_lib.py
test_demo_rehearsal_lib.py
test_rehearsal_verdict_hardening.py
test_harness_ownership.py
test_run_all_tier_skip.sh
test_rehearsal_workload_lifetime.py
# #384: the per-frame panel-data probe (--diag-data) is reached FROM the
# rehearsal's own run_tab call site, not merely present in ui_live_smoke.py.
# The hazard is an instrument that exists, is documented, and is called by
# nothing -- which is how it shipped: the flag threads through
# tests/ui_live_smoke.sh but demo_rehearsal.py had its own call site.
test_demo_rehearsal_diag.py
# #386: the Off-CPU* residual decomposition (tests/schedstat_lib.py +
# tests/schedstat_probe.py's /proc reader, driven against a fixture /proc
# tree). The hazard is a FALSE NEGATIVE, not a false alarm: run_delay only
# accumulates when kernel.sched_schedstats=1, which is 0 by default on both
# gate boxes, and a reader that reports 0 in that state credits the entire
# residual to "unexplained" on no evidence. Every blinding path -- sysctl
# off/unknown/toggled mid-window, no samples, one sample, no backends,
# missing /proc, unparseable field, vanished pid, reused pid, partial
# window coverage, mismatched clock domain -- must refuse, and the suite
# also pins that NOTHING here gates a rehearsal verdict.
test_schedstat_lib.py
test_demo_rehearsal_orchestrator_lib.py
test_workload_verify_flag.py
# #214: per-tab "is this populated" checkers for tests/demo_workload_coverage.py
# (companion to tests/live_loop_workload.py). Pure Python; its import chain
# (server_harness lazily inside main(), ui_live_smoke_lib for numpy/PIL only)
# needs no Playwright, verified in a Playwright-free venv and pinned by
# test_import_needs_no_playwright (see #205/3e66b31 for why that matters:
# make check and make box-check both have Playwright, so only CI's
# build-and-unit job -- which runs this list -- can catch a module-scope leak).
test_demo_workload_coverage.py
# #205: the blindness guard in tests/timeline_window_probe.py -- every way
# the live-window measurement can be starved (nothing recorded, info ticking
# while the tab never fetched, a partial run, an unparseable frame) must
# refuse. The pre-guard version silently ACCEPTED a frame whose cmd was not
# a string.
test_timeline_window_probe.py
test_hetzner_sweep.sh
test_unit_import_guard.py
test_push_guard.py
# #277: the summary writer's daemon-tick flush wrote the second still in
# progress and did not reset the accumulator, so the rest of that second was
# written again as a superset and the reader summed both. One logical second
# must contribute its events exactly once to a reader-side sum. Includes a
# bypass suite: an empty dir, a disabled writer, an unparseable file, a
# missing dir and a hand-built duplicate second must each be refused or go
# red, never read as agreement.
test_summary_tick_flush
# 2026-10-06, the owner's timer-sleep rule ("there is DB time when database
# doing smth - not just waiting for timer"). Six Timeout events are pure pacing
# sleeps and leave DB Time / AAS while staying VISIBLE; Timeout:PgSleep,
# SpinDelay, RegisterSyncRequest and VacuumTruncate stay in DB Time. The rule
# lives in src/idle_rule.c (one table, derived from resolved NAMES because the
# Timeout ids INVERT between PG13 and PG18 -- id 1 is CheckpointWriteDelay on 18
# and PgSleep on 13).
#   test_idle_accounting: the RAW compute path -- DB Time, the Timeout class row
#   as a strict subset, the named Idle sub-rows (so 807 s of
#   CheckpointWriteDelay is explained rather than anonymous), conservation
#   asserted by COMPONENT, and CPU measured on/adjacent to a pacing wait.
#   test_idle_summary: the SUMMARY path, which is what the demo's 900 s window
#   takes -- a predicate-only change would have left it reporting the old
#   number. Raw-vs-summary agreement under three filters, the writer-side v3
#   exclusion, and the accounting-version preflight that turns a refused v2 file
#   into a raw recompute instead of a plausible EMPTY window. Section 13 adds
#   the ROUTING gate (#402, #403): a window no summary file resolves into is
#   refused rather than answered with 0.0 ms labelled exact (keyed on
#   `considered`, because the failure as it occurred had nfiles == 2 and
#   considered == 0, so an `nfiles == 0` guard would have approved it), and an
#   archived file is found in its window on a reader whose timezone is not the
#   capture box's -- a file label parsed with mktime() where it was written
#   with localtime_r answered 240.1 ms of a 2,612,758.3 ms window.
# Both carry a bypass suite: "time was excluded" is satisfied by 0 == 0, so the
# empty fixture, the absent-rather-than-wrong event, the clipped window, the
# starved summary read and an empty pacing mask each have their own case.
test_idle_accounting
test_idle_summary
# The AGGREGATE-vs-RAW differential gate, built BEFORE more views move onto the
# aggregate side. pgwt-server answers every UI question two ways -- from
# pre-aggregated per-second summary records (~50 ms at any width) or by
# materialising every raw event (3-5 s at millions) -- and should_use_summaries
# picks one, so the two never answer the same request and a disagreement is
# invisible. FID-2 shipped exactly that (docs/ROADMAP_AND_STATUS.md:579).
# For EVERY pgwt_compute_*_from_summaries() declared in src/compute.h this
# computes both paths over the same committed blocks and the same window and
# asserts BIT-EXACT agreement field by field -- no blanket epsilon, because a
# blanket epsilon is how this class of bug hides; every field that genuinely
# cannot be compared is excluded with its reason and its source line (N1..N11
# in the file header). The registry is checked against src/compute.h itself, so
# a new aggregate path with no differential turns this red, and a header it
# cannot read or parse REFUSES rather than reporting full coverage.
# Bypass suite: an empty dir, a missing dir, a window with no overlap, a
# partially-decodable file, a filter that matches nothing, and a header with no
# declarations must each be REFUSED -- "0 == 0" satisfies every assertion in
# the file, so non-vacuity is pinned before any agreement is asserted. Plus
# mutation probes proving each comparator can see one nanosecond, one count,
# one grid cell and one missing row.
test_agg_raw_crosscheck
# io_workers on the SUMMARY path (#315, #376; summary format v6). The raw paths
# put io_worker time outside DB Time AND outside Idle
# (docs/AAS_SEMANTICS_DECISION.md: the requesting backend already shows
# AioIoCompletion for the same logical I/O); src/summary_writer.c counted it,
# so one window gave two answers -- measured +23.36% on the whole-capture Idle
# of the PG18 demo capture and +308.16% on a window containing the capture end,
# where an io_worker's single Activity:IoWorkerMain interval closes.
# test_agg_raw_crosscheck CANNOT see this: its fixture is deliberately
# io_worker-free (hole N7), because a PRE-FLAGGED fixture event greens a writer
# check on evt->flags that is dead in the daemon -- nothing on the live path
# sets that bit. So this file pushes UNFLAGGED events and lets the producer's
# resolved category be the only cause: all five accumulators (class_ns,
# idle_ns, events[] with its histograms, sessions[], queries[]), busy AND idle
# io_worker records, the capture-end flush record src/escalation.c synthesizes
# by a path that never touches src/event_stream.c, and raw-vs-summary agreement
# on the time model AND the heatmap (events[] feeds the summary heatmap, so the
# matching pgwt_compute_heatmap exclusion has to agree or a >= 120 s window and
# a shorter one disagree cell for cell).
# It also reads both producers' SOURCE: the daemon needs BPF and cannot be
# linked here, and the one thing a writer-level test cannot see is a producer
# that passes 0. Bypass suite: a missing summary dir, a writer that wrote
# nothing, an io_worker-FREE fixture, a PRE-FLAGGED fixture, a v5 file in the
# window, and -- for the source gate -- a missing file, absent symbols, a
# literal 0 argument, a resolve placed after the push, and an unexpected
# producer count. Each must REFUSE; a gate that cannot see must never approve.
test_io_worker_summary
# #376 + #315: the RAW-vs-SUMMARY parity gate for io_worker time. It landed
# EXPECTED RED (as its own commit, with no product change) and is GREEN from
# the summary-v6 writer fix in this same branch -- the KNOWN_FAILING entry
# tests/run_all.sh carried for it is deleted by that fix, because a gate that
# no longer fails the build when it should is not a gate.
# pgwt_compute_time_model skips a record carrying PGWT_EVENT_FLAG_IO_WORKER --
# io_worker time is in neither DB Time nor Idle, the decision
# docs/AAS_SEMANTICS_DECISION.md records -- while accum_event in
# src/summary_writer.c has no io_worker test at all, so the same window
# answers Idle and DB Time two different ways. Measured on a real PG18
# io_method=worker capture (1852 s): Idle +23.36% over the full span, +50.11%
# on a 900 s window ending AT the capture end, +0.15% on the same width ending
# one second earlier -- which is why three window cases are reported and why a
# single interior window would have read as agreement.
# The io_worker property is produced the way PRODUCTION produces it: unflagged
# events into the real pgwt_summary_push_event (exactly as src/event_stream.c
# pushes them, before any category is resolved) and pgwt_tag_events against a
# backends.jsonl registry resolved through pgwt_backend_type_flag (exactly as
# src/server.c tags every raw window). It never pre-sets the flag bit -- the
# trap commit 8705412 records, where a fixture that set it greened a writer
# guard DEAD IN THE DAEMON -- and a pre-flagged stream is REFUSED outright.
# Scope, deliberately narrow: green here would NOT mean "summary equals raw on
# any window". The writer buckets every record whole into its closing second
# while the raw path clips to the window, so a long NON-io_worker idle record
# diverges by the same mechanism; section 7 measures that residual and does
# not assert it.
# Also pins handle_heatmap's two routes against each other cell by cell (the
# one raw aggregate that still counts io_workers, and the one an earlier
# attempt broke into disagreement), plus the bypass suite: an empty, missing
# or header-less summary dir, a non-overlapping window, a partial commit
# range, an absent or unresolvable registry, a registry resolving no
# io_worker, a raw side with no io_worker record, a window with no io_worker
# time, and a pre-flagged fixture must each REFUSE -- every one of them is a
# shape in which both paths agree while the product is broken.
test_io_worker_parity
# #408: the RAW-vs-SUMMARY parity gate for the CPU ROWS, and the gate for
# summary v7. Two defects, both writer-side, both visible on any unfiltered
# window of 120 s or more -- which is every window the demo shows. (1) The
# per-second record stored no measured-CPU scalars, so the summary path
# reported has_measured_cpu = 0 and collapsed "CPU (running)" +
# "CPU (waiting for a core)" into one "CPU*": the runqueue signal #386 is
# about simply disappeared. (2) The writer never applied the non-command
# relabel -- a foreground we == 0 interval outside a command is idle, not CPU,
# and both raw paths file it under PGWT_WEI_NONCMD_CPU -- so that time sat
# inside the summary's DB Time. Measured on the PG18 demo capture run.id
# 1791973533: at the full span raw CPU 340,625.997 + 225,927.106 against one
# summary row of 586,586.148, DB Time +20,033.044 ms, which is mechanism (2)
# to three decimals; after v7 the two paths agree to 0.000 ms
# (tests/results/issue408-measurement).
# Neither property is pre-cooked into the fixture (the 8705412 trap): the
# relabel is resolved by the production classifier on both sides, and the
# fixture's per-pid intervals are CONTIGUOUS because both command gates bank
# command-open time onto the next record -- a gapped fixture makes every
# interval look in-command and the relabel never fires, which section 2
# refuses. Bypass suite: an all-UNKNOWN-cpu_ns fixture, a fixture with
# nothing to relabel, a producer that resolves NOTHING (the reachability
# probe: it must go RED, or the eff_event parameter is dead code in the
# daemon), a window holding no records, a deleted summary dir, a v6 file in
# the window, a truncated v7 record, and an illegal eff_event. Each must
# refuse or diverge; a gate that cannot see must never approve.
test_cpu_split_parity
# #379 / summary v8: the writer charged a wait's WHOLE duration to the second
# it closed in, while the raw path clips every record to the requested window
# (event_window_ns). A window holding a long record's closing second but not
# its span therefore over-reported by the outside part, and a window holding
# the span but not the closing second reported none of it: on the #410 parity
# fixture, a 130 s window straddling a 100 s Client:ClientRead's close read
# DB Time +60,000 ms = +23.80% across 29 fields; dragging the time range over
# that boundary moves DB Time by a quarter with the workload unchanged.
# v8 spreads the DURATION across the seconds the interval occupied, by
# WATERMARK: the producer notes what each pid has open (the daemon from
# state_map, src/map_reader.c) and the writer credits each second's share as
# that second is written, the closing record contributing only the remainder.
# This test asserts placement (ten seconds, 1 s each), CONSERVATION (exactly
# the duration, ONCE -- never 1+2+...+10, which is what the live view's
# open-stretch rule gives a persistent writer), that count/histogram/max_ns
# stay whole and once at close, both tick/close orders, and the two
# deliberate refusals: queries[] (open-interval query attribution is
# unresolved at credit time; Queries raw-loads, #324) and an on-CPU gap
# (no cpu_ns exists until close, so spreading its wall would clamp v7's
# measured split to zero -- the residual #379 leaves open, counted as
# cpu_open_uncredited_ns_total). Bypass suite: NO producer notes (the
# reachability probe -- it must fall back to v7, or the credit path is dead
# code), a stale note, an exit, a mismatched note, an io_worker pid, a full
# table, a missing trace dir (the read-back must REFUSE, not agree with
# nothing) and a late first note. A gate that cannot see must never approve.
test_straddler_accounting
# #424 / summary v9: an OPEN ON-CPU interval must be credited to the seconds
# it occupies WITHOUT destroying v7's measured-CPU split -- the residual v8
# deliberately left open, which made an in-flight pure-CPU statement absent
# from the CPU rows of the 15-minute Overview until it ended. The producer
# supplies the observation v8 said could not exist (cumulative measured CPU
# over the open prefix, plus its own command-gate classification) through
# pgwt_summary_note_open_ex. Asserted: placement (ten seconds, 1 s each) AND
# the split surviving (6000 ms measured, 0 clamped) in the same fixture;
# conservation with the two sides read off DISK and out of the fixture's
# literals, never one sum against itself; either order of (tick, close)
# including a tick crediting past the close; the CLASSIFICATION FREEZE (the
# open-prefix command-majority answer can flip before close, and a written
# second is immutable, so one interval must carry ONE label -- divergence
# counted in ns); the unknown tier and a tier flip (CPU* is measured +
# unknown, so a flip must not double count); and NON-VACUITY -- a fixture
# with no open CPU is BIT-IDENTICAL through the new entry point. Bypass
# suite: the observation WITHHELD (the reachability probe -- it must degrade
# to v8 exactly, or the gate measures nothing), a stale observation, an exit,
# a mismatched note, an io_worker pid, an illegal eff_we, a full table, a
# missing/empty trace dir and a PREVIOUS-VERSION file (the reader must
# REFUSE, so evidence from the old accounting rule cannot green this one), a
# disabled writer, a sub-second gap, and the open-credit-only round trip (an
# events[] row with time and no count must survive, or the block header
# desynchronises and whole seconds fail to decode).
test_open_cpu_accounting
# #430: an hourly ROTATION must not PAUSE open-interval crediting.
# pgwt_summary_check_rotation archives the file and leaves w->fp NULL for a
# lazy reopen on the next PUSHED record, and writer_seal_through refused
# outright on a NULL fp -- so every daemon tick in that window sealed nothing
# and the per-second credit of every open interval simply stopped. #430 filed
# this as "attribution-only, totals over a window containing the close are
# unaffected"; that is FALSE, and this test is the measurement.
# pgwt_summary_close() also returns early on a NULL fp, so a capture that
# STOPS inside the pause never writes those seconds at all: on this fixture
# 11 s of a continuously-waiting backend elapse and the parent tree puts
# 5000 ms of it on disk. Rotation is hourly on the wall clock and the demo
# rehearsal capture is 35 minutes, so whether a demo hits this was decided by
# the MINUTE it started -- an intermittent, unreproducible-after-the-fact
# accounting fault in a recorded GIF.
#
# The gate is a CONSERVATION identity, not a floor: sigma of the pid's
# db_time_ns summed off DISK through the shipping reader == the wall of the
# completed seconds the fixture's literal tick schedule could seal, EXACTLY.
# The two sides come from different places, so it cannot be satisfied by
# comparing one sum with itself, and "PgSleep > 2000 ms"-shaped floors (the
# assertion that let #416 live for months) would have passed on the parent
# tree. It is also placement-sensitive: every record must carry exactly
# 1000 ms, and the per-FILE split must be 5 s in the archived hour and 6 s in
# the file the seal reopened -- so a catch-up pass that dumped the whole
# pause into one second, a re-credit from the interval's start, or a
# double-counted boundary second fails here rather than passing on the total.
#
# THE INPUT THAT GREENS A CARELESS FIXTURE is included deliberately as the
# reachability probe: push a record right after the rotation and the lazy
# reopen happens on the PUSH path, the owed seconds are caught up in one
# pass, and the total is exact with the defect fully present. That is
# precisely what test_open_cpu_accounting's rotation leg (3c) does, which is
# why it could not see #430 -- verified by running it on both trees, 89
# checks 0 failures and byte-identical numbers either way. If this probe were
# red too, the conservation leg's red would be the harness and not the pause.
#
# #447, THE OTHER HALF, and the reason crediting the seconds was not enough
# on its own. A file is placed by its header's start_time_ns and
# summary_file_in_window prunes any file starting after the window's end --
# but a reopened file's header is written at the reopen instant, ~1.1 s AFTER
# the second the seal is writing (a second is complete only
# PGWT_SUMMARY_FLUSH_LAG_NS + 1 s after it begins). So the recovered second
# was computed, written, and still pruned out of a query for its own second,
# which is how every view reads. widen_file_start now moves the header start
# back to cover it, from flush_accum -- the single funnel every record passes
# through, so no path can bypass it. BOTH header clock fields move by the same
# delta, because the reader derives mono_to_wall = start_time_ns -
# clock_offset_ns and that difference must not change: the pair is re-anchored
# to an earlier instant on the same two clocks, which is a true statement
# about both rather than a lie about either.
#
# This class is INVISIBLE to a pinned-clock fixture (a pinned writer does not
# re-read the clock on reopen, so no header can be later than its own
# records) and invisible to an unbounded read. So §10 runs UNPINNED -- the
# daemon's real lifecycle -- and queries a BOUNDED window equal to exactly the
# recovered second, with the bound read out of the file rather than predicted.
# §12 pins the anchor so start - clock_offset is literally 0 and asserts the
# widening leaves it at 0 exactly, with no tolerance, while placing the record
# BEFORE the anchor so the widening actually fires.
#
# Bypass suite, one leg per way this gate's DETECTION could be made
# unreachable, each demonstrated red against a one-edit mutant of the fix: a
# writer that never opened a file (no clock anchor exists, so it must invent
# nothing and create no file); nothing open after the rotation (no file, no
# empty record -- an idle daemon must not churn one file per hour); a reopen
# that FAILS (a directory planted at current.summary, which fails as root
# too) -- nothing credited, the failure COUNTED, and the seconds still OWED
# so a later tick places all of them; a note that goes stale mid-pause (a pid
# that died without an EXIT record: crediting stops inside the freshness
# window and the expiry is counted); the rotation ABSENT rather than wrong
# (same schedule, same 11 s, so the rotation is the only variable); a
# missing dir, an empty dir and a PREVIOUS-VERSION file (the read-back must
# REFUSE -- a gate that sums zero records agrees with everything); and a
# disabled writer; a bounded window containing none of the records (so the
# bound is doing work); a PUSH-path open failure, which kept its own uncounted
# open and so stopped recording with no number moving; and a FIRST open
# failure, which must not be reported as a mid-capture stall. The refusal
# lives in exactly ONE place for this reason: the first draft kept a
# `if (!w->fp && !w->file_ever_opened) return` early out as well, and deleting
# the real refusal then left the never-anchored leg fully GREEN.
test_rotation_open_credit
# Paint-latency Phase 1 (docs/PAINT_LATENCY_PLAN.md): the per-committed-block
# transition aggregate, src/block_agg.c. `transitions` loads the full raw event
# window on every request (~0.68 s per million records) because a per-second
# summary record cannot express WHICH event followed which. A committed block
# is immutable, so a (old_event, new_event) -> {count, summed duration} table
# can be precomputed per block and MERGED; a request merges the blocks wholly
# inside the window and decodes raw only at the two edges.
# The oracle is the SHIPPING raw path, pgwt_compute_transitions(), not a copy
# and not this module's own accumulator — if both sides came from the same
# code the comparison could not fail. Bit-exact, no epsilon: 378 windows over
# a 5-block fixture, each compared pair by pair and node by node, plus merge
# associativity/commutativity over all 6 orderings, and the straddle rule (a
# transition whose old_event began in an EARLIER block is counted once, in the
# block holding the record, with its duration unclipped).
# §1 caught a real divergence before this shipped: pgwt_filter_matches()
# refuses a record whose duration exceeds its own end timestamp, and the
# aggregate did not.
# C7 is the clause to read first: TIME is half-open, but RECORD SELECTION is
# inclusive at both ends, because a trace event's timestamp is when the wait
# ENDED — an event ending exactly at `to` lies wholly inside the window, and
# the raw loader selects it then clips the contribution. An earlier draft read
# "half-open throughout" as applying to the END key, changed the loader to
# match, and zeroed test_data_aas (Total AAS 4.0 -> 0) and
# test_data_categories on the gate box. §6b now pins BOTH directions with the
# same 163 ns literal: zero divergence from the loader, and exactly one lost
# record under a half-open end bound.
# §9 goes through the REAL writer and reader: a multi-block trace on disk,
# driving the same pgwt_block_agg_window_from_reader() src/server.c's
# handle_transitions() calls, swept twice so the cache's contract ("a merged
# aggregate equals a fresh decode, to the nanosecond") is exercised rather
# than assumed. §3b/§3c pin the readout's TOTAL order on both sides, which is
# what makes a row-by-row comparison between the paths mean anything.
# Bypass suite: an empty block, an absent aggregate, a SAMPLES block, an
# uncommitted block, an unresolvable trace identity, a version mismatch, a
# rotation, a rewritten block (every header field perturbed in a loop), a
# double merge, injected allocation failures, every filter field, an
# empty/inverted/unparseable window, a frozen or freed aggregate, a window
# where NOTHING qualifies, a cache that can never answer, an overlapping
# SAMPLES block and an unopenable trace file — each must REFUSE, because
# "0 == 0" satisfies every assertion in the file.
# tests/results/block-agg/run_mutations.py breaks one guard at a time across
# src/block_agg.c and src/compute.c (20 mutations, all RED, control green). It
# earned its keep three times: it found the tie-order check vacuous (M13), an
# unreachable guard that was deleted rather than left looking like protection
# (M18), and M20's converse -- nothing required a wholly-inside block to MERGE,
# so the fast path could have degraded to always-DECODE with every number still
# right.
# M22 is the one to read: it restores `mono_first >= to_m`, the FILE-level form
# of M21's off-by-one that actually shipped. M21 pinned that comparison per
# BLOCK, the identical error was hand-written again per FILE, and the suite let
# it through -- which is why the rule is now one shared predicate
# (pgwt_block_agg_file_can_contribute) with §1b's literals and a 5565-case
# boundary sweep against the raw loader's rule transcribed independently.
# Known limit, tracked as #339: M22 mutates the PREDICATE, and
# transitions_from_block_aggs() is static, so no C unit can reach the call
# site -- a re-hand-written comparison there would still ship green.
test_block_agg
test_transitions_loader
# #319: handle_top_sessions and handle_top_queries backfill top_wait from a
# raw computation over the same window the summary path already answered
# everything else from (the per-second summary record keeps only the single
# longest wait, the raw definition is the largest per-event TOTAL -- a
# different question, not a looser one; see the issue and the comment at
# each call site). Pins the Sessions backfill (a session whose summary-only
# answer is provably different from raw), the Sessions fail-safe (a raw
# load small enough to overload reports absence with a reason and
# top_wait: null, never the summary-only name and never a silent blank),
# and the matching Queries backfill on the same fixture.
test_top_wait_backfill
# #294: cross_validate drops pgwt_is_idle_event() time from BOTH sides before
# any share is computed, so when the sampled tier reads less CPU than the exact
# tier the missing nanoseconds have no visible destination -- "it became
# ClientRead/idle" could only be INFERRED. --show-idle prints it, from a
# hand-built trace whose expected nanoseconds are literal constants (not a
# re-traversal of the tool's own loop). Bypass suite: an empty pacing mask must
# REFUSE (exit 4) rather than print zeros that read as measured; a genuine
# absence of idle events must say so in words; an empty dir and a
# sampled-only (no exact tier) capture must error; idle present on one tier
# only must still print a row; a missing/non-executable comparator and a
# generator too old to reach the refusal path must fail, never skip.
test_cross_validate_idle.sh
# Paint-latency plan Phase 3: the EXECUTIONS INDEX (src/exec_index.c). Six
# detail commands reload the full raw event window on every request at
# ~0.68 s per million records; this indexes execution BOUNDARIES once per
# committed block, with per-pid open-row state carried across block
# boundaries, so a request costs O(chunks + executions in window).
#   The whole safety argument is that one window query equals
#   pgwt_compute_executions over the array src/server.c actually builds
#   (markers-only prefix below `from` ++ every record in [from, to]) --
#   BIT-EXACTLY, on ten boundary fields, no epsilon. So this is a
#   differential against the real function over EVERY block split of 13
#   fixtures (424 cut sets, 21,625 fixture/split/window triples): a
#   one-block suite would never exercise carry-over at all, which is this
#   phase's whole point. Literal expectations pin the #222 double-EXEC_START
#   orphan closed by CMD_END, three orphans closed by one CMD_END, an
#   execution spanning seven blocks, one open at capture end, a window that
#   opens mid-execution, a zero-length execution, a plan discarded by
#   CMD_END, a plan whose query_id does not match, and a query_id that
#   arrives only on EXEC_END.
#   Bypass suite, because a boundary index's failure mode is answering
#   "no executions" when it simply cannot see: an empty index, an unsealed
#   one, an unknown version, a skipped or reordered block, an out-of-order
#   record, a record outside its block's bounds, a window not fully covered
#   and every injected allocation failure must each REFUSE with their own
#   reason and no rows -- plus a fixture with NO markers that must come back
#   as 0 rows with refused=OK, the one encoding of a genuinely empty window.
#   n_events/n_workers/matches_event_filter cannot come from a boundary
#   index, so they are POISONED to -1 rather than left at 0.
#   Companion: tests/exec_index_mutations.py injects all 16 silent-wrong
#   risks one at a time and requires this test to catch each (16/16); it is
#   not in this list because it recompiles the module 17 times (~16 s) and
#   is evidence, not a gate.
test_exec_index

# test_interval_index: the CONCURRENCY INTERVAL INDEX (paint-latency plan,
#   Phase 4, src/interval_index.{c,h}). `concurrency` is the one detail view
#   per-second summaries can never reconstruct: peak is max over
#   (bucket, event) of |distinct pids|, and SETS UNION, THEY DO NOT ADD, so a
#   per-block "peak per bucket" is unmergeable. The index therefore stores the
#   wait INTERVALS themselves -- each one ONCE, in the block holding its END
#   record, with its true start_ns UNCLIPPED -- and answers a window by
#   calling the SHIPPING pgwt_compute_concurrency over the compacted set.
#   VERSION 2 (#424): a window selects every interval that OVERLAPS it
#   (end >= from AND start <= to, inclusive at both ends) and CLIPS one that
#   is still open at `to` to the window edge, which is the corrected loader's
#   rule; version 1 keyed on the end timestamp alone and lost those waits.
#   Removing the row-level exclusion is only half of it -- the chunk
#   prefilter's high side must test the chunk's earliest START, because a
#   chunk whose intervals all END past `to` can still hold one that began
#   before it, and keying on min_end_ns throws the same records away one
#   level up.
#   This test is a differential against that same function over the full raw
#   record array as the CORRECTED loader hands it over -- one linear
#   clip-at-`to` pass, sharing no selection code with the module -- over
#   EVERY block
#   cut of every fixture x six windows x two bucket resolutions, asserting
#   peak_sessions[], peak_event[], bursts_total, num_bursts and every burst's
#   timestamp/event/name/session count/pid list bit-exactly. Comparing peaks
#   alone is refused: two of the three silent-wrong modes are invisible in
#   peaks.
#   The three modes, each with its own literal expectation: a CLIPPED start_ns
#   (lower peaks in earlier buckets, onsets shifted later, bursts vanish); an
#   interval counted TWICE (peaks survive via pid dedup, but one pid
#   double-counts toward the burst threshold); and LOSING a wait still open
#   at `to`, at the row level, at the chunk prefilter, in the clip itself or
#   in the materialisation ORDER (the clipped row's own timestamp is no
#   longer its end, so re-sorting the array by it, or by start_ns, changes
#   which event owns a bucket). fx_faredge pins the far edge the way fx_edge
#   pins the near one: a 4-pid burst whose members are all still waiting at
#   `to`, one of them STARTING exactly at `to` -- a case peaks cannot see at
#   all, because such a wait contributes to no bucket.
#   Bypass suite, because this index's failure mode is answering "no
#   concurrency" when it simply cannot see: a FILTERED request (version 1
#   indexes the unfiltered set), an empty index, an unsealed one, an unknown
#   version, a skipped or reordered block, an out-of-order record, a record
#   outside its block's bounds, inverted block bounds, a row order corrupted
#   WITHIN one chunk (where every chunk bound is still right, so only the
#   sort check can see it), each of the four chunk prefilter bounds corrupted
#   in the direction that loses rows, a window not fully covered, an inverted
#   window, num_buckets <= 0, a window selecting NOTHING, and every injected
#   allocation failure must each REFUSE with their own reason and no result.
#   Non-vacuity ledger: counters for cross-block intervals, intervals starting
#   before coverage, same pid selected from two blocks inside one bucket,
#   intervals still open at `to` and clipped there, intervals rejected for
#   STARTING after `to`, chunk scans stopped on the `to + max_duration`
#   bound, chunks a version-1 end-range prefilter would have skipped whole,
#   bursts whose members live in two or more blocks, and bursts_total each
#   FAIL the test when zero.
#   `./test_interval_index oneblock` feeds every fixture as a SINGLE block and
#   MUST exit nonzero -- the ledger's own falsification. It is not a separate
#   list entry because it is a deliberate failure, not a gate.
#   Companion: tests/interval_index_mutations.py injects all 36 silent-wrong
#   risks one at a time and requires this test to catch each (36/36), scoring
#   BUILD-FAILED, NOT-APPLIED, TOOL-MISSING, BASELINE-RED and STAYED-GREEN as
#   five distinct FAILURES; `--self-test` drives all five deliberately. Two
#   of the 36 (M06i, M06j) corrupt the SHARED chunk-bound helper, so seal's
#   own cross-check agrees with the corruption and only the differential can
#   see them -- which is the point of keeping that arithmetic in one place
#   rather than writing it twice and calling the agreement a check. Not in
#   this list because it recompiles the module 37 times (~1 min) and is
#   evidence, not a gate.
test_interval_index
# The allocator tuning pgwt-server applies at startup (src/alloc_tune.h): the
# per-request ~274 MB event arrays stay on an already-faulted heap instead of
# being mmap'd fresh (measured -15% top_queries / -35% executions / -20%
# concurrency on a 6.96M-event 900 s window). test_alloc_tune proves the
# property -- heap-served, not trimmed on free, second touch costs no faults --
# always against an untuned control in the same process, and REFUSES when a
# pre-tuned environment, too small an allocation, or an unreadable sbrk() would
# make it blind. test_server_alloc_tune.py proves main() actually CALLS it (no
# unit test can link server.c), requiring the default and PGWT_ALLOC_TUNE=0
# masks to disagree, and carries stub binaries for every way that check could
# fail to see: silent output, no line, an unparseable mask, exit 127 and a
# non-executable binary must each refuse rather than approve.
test_alloc_tune
test_server_alloc_tune.py

test_backend_lifecycle

# THE SUMMARY-vs-RAW PARITY GATE's pure comparison core (#408, #379, #319).
# pgwt-server answers an unfiltered window >= 120 s from per-second summaries
# and everything shorter from raw events, and nothing had ever compared the
# two answers on the SAME window -- the single reason those three, plus #402
# and #403, survived three clean rehearsals whose conservation checks use a
# 60 s window (raw path only). The live half needs the server binary and runs
# in tests/run_all.sh's synthetic-data tier; THIS entry is the false-negative
# suite over tests/summary_raw_parity_lib.py, which is where that gate can
# actually fail silently: both sides taking the same route (including via a
# summary accounting-version refusal, the v6->v7 case), an oracle that never
# took effect, two empty answers agreeing, an absent field read as equal, an
# unparseable field, a missing/non-executable dependency (126/127), an empty
# expected-divergence table approving everything, and a known divergence
# whose magnitude changed. Pure Python, milliseconds -- so a regression in
# the gate's own logic does not need a 40-minute box run to surface.
test_summary_raw_parity_lib.py

# #424 live half: the request-scoped OPEN-INTERVAL OVERLAY (src/open_overlay.c)
# -- the client of the daemon's {"cmd":"open_intervals"} snapshot, the span
# arithmetic ([max(open_start, from), min(to, T_snap)] through the daemon's own
# (now_mono, now_wall) anchor), the uniform precedence rule (any admitted
# non-marker record for that pid past the open stamp IS the close -- so a
# window that ends before the open stamp empties itself through the clip
# alone, and there is no near-now test anywhere in the module to regress),
# the mandatory span filter for a filtered request, the refusal of a window
# the snapshot never covered (unknown is not zero), the three-step command
# classification (cmd_sweep_open, NOT the instantaneous cmd_open, with the
# two fallbacks that are rules rather than derivations -- 144 gate states,
# each also driven with the daemon's verdict flipped so the table cannot be
# satisfied by copying it), the cross-checks against the producer's own
# figures (cmd_in_window, cmd_open_ns, cpu_ns, open_count and the wall-vs-
# anchor identity), the RAW-route
# and EXACT-tier refusals (summary v8 already credits open waits per sealed
# second, so synthesizing there double counts), and the degraded contract: when
# the overlay is unavailable the in-flight contribution is ABSENT and labelled,
# never a zero. Positive numbers come from a hand-computed oracle, not from a
# second call of the code under test; additivity is deliberately not the
# primary assertion because it accepts an all-zero overlay.
test_open_overlay
# The false-negative suite over the entry above: 34 mutations of
# src/open_overlay.c, each of which must turn test_open_overlay RED, plus a
# comment-only control that must leave it GREEN (otherwise "every edit fails"
# would look exactly like "every guard works"). A mutation that does not
# apply, does not compile, or HANGS is a failure, and a missing compiler
# refuses instead of skipping. It found four blind spots in the unit test
# itself before any of them was committed: an unmeasured-CPU sentinel that
# survived the arithmetic by accident, a wall stamp that happened to be
# exactly representable as a double, a sub-window CPU clamp that was
# unreachable (deleted), and the gate reduction's CLAMP, which cannot change
# the majority verdict and so was invisible until the fixture started
# carrying the daemon's cmd_open_ns as well.
test_open_overlay_mutations.sh
# #424: `--replay --from/--to` was the last reader still adding duration_ns
# WHOLE (left straddlers over-reported) and selecting on the close timestamp
# alone (waits still running at --to contributed 0 -- and src/replay.c also
# stopped at the last block before --to, so the record rule could never see
# them). Time is now overlap-selected and clipped; count/histogram/min/max
# stay selected by the record's own close, so widening admission cannot
# double-count one close in two windows. Includes the bypass suite for the
# budgeted right-edge scan: exhausted budget, unreadable block header, a
# SAMPLES tail that must cost no budget, bad arguments, empty input.
#
# #429: and the lookup underneath all of that. block_index[] is written
# in COMMIT order and nothing sorts it, so pgwt_reader_find_block's
# binary search had no precondition -- on a lagging --mode full drain a
# SAMPLES block commits with a far-future first timestamp and the next
# TRANSITIONS block commits after it with an earlier one. The search then
# returns an ARBITRARY block, and a window can come back EMPTY while
# reporting itself complete. The fixture here interleaves the two streams
# so commit order and timestamp order genuinely disagree, and ASSERTS
# that they do before asserting anything else -- a fixture where the two
# orders coincide passes while the code is broken.
test_replay_window
# #424 daemon half: the live open-interval snapshot. Pins (a) that the
# per-pid open-stretch arithmetic shared by the de-escalation flush, the
# shutdown flush and the new {"cmd":"open_intervals"} command is byte-for-byte
# the pre-refactor arithmetic -- a differential against a verbatim copy of the
# deleted loop body, with a coverage assertion so the comparison cannot be
# vacuous and two mutation probes proving it can go red; (b) the frozen wire
# shape the live server half codes against, including an unmeasured cpu_ns
# being ABSENT rather than 0 and a degraded status carrying NO pids array;
# (c) the transport -- 1024 backends serialise to ~390 KB, so the superseded
# 64 KB buffer is demonstrably insufficient, and the old drop-on-EAGAIN
# sender truncates a reply the queued sender delivers whole.
test_open_interval

# test_trace_closure (#424 deliverable 1): can a reader tell that a capture
# ended uncleanly? A footer could never answer that -- rotation, crash
# recovery and a clean close all write one -- so the writer now records WHY a
# file ended in spare header flag bits. Three groups: the pure bit->verdict
# mapping (a legacy file reads UNKNOWN, never clean; contradictory bits
# resolve to UNCLEAN); the real lifecycle on real files (clean close,
# rotation, mid-capture, SIGKILL + recovery, SIGKILL twice, a clean label
# surviving the recovery that archives it, a CLEAN label contradicted by the
# committed watermark, and a close whose flush was made to FAIL -- which is
# the only case that distinguishes "checked and durable" from "always set the
# bit"); and the bypass suite -- missing file, empty file, truncated header,
# wrong magic with every bit set, a directory, and a capture that never
# opened a file at all. A gate that cannot see must refuse, never approve.
test_trace_closure

# test_open_ckpt (#424 deliverable 2): the open-interval checkpoint as ONE
# contract -- identity, durable publication, recovery, suppression. Covers the
# standard CRC-32 check value (a sidecar must validate for any reader), every
# named refusal reason, the suppression predicate on inputs where it must say
# yes AND no (with an exact recovered-ns total, so "suppress everything" and
# "suppress nothing" both fail), publish-before-watermark, a crash carrying the
# sidecar to its archive, a clean close and a rotation DROPPING it (both would
# double count against real closing records), an uncertified close KEEPING it,
# and the bypass suite: a sidecar from another file, a flipped bit, a chopped
# record array, an insane count, a text file, no sidecar at all, an empty
# checkpoint superseding a non-empty one, and retention taking the sidecar with
# its archive.
test_open_ckpt

# #416: a display tick must contain every record the producer has already
# emitted. handle_timer built the display from the cumulative accumulator
# plus a LIVE state_map read and did NOT drain the event ringbuf -- the epoll
# loop drained afterwards, 64 callbacks at a time, against ~37,700 records/s.
# A long wait's whole contribution rides on ONE record, so Timeout:PgSleep
# lost 100% of an 8.6 s sleep (DB Time 50.1% short) while CPU* moved -0.6%,
# i.e. invisibly. The trace on disk was correct throughout; the live-tier
# assertion that should have caught it was a FLOOR (PgSleep > 2000 ms), which
# passes on a 3 s truncation of the same 8.6 s record. This drives the REAL
# pgwt_handle_timer with only ring_buffer__consume wrapped, and asserts
# CONSERVATION: display total == emitted total, exactly. Includes a backlog
# deeper than one 64-callback budget pass (a one-pass fix fails it), a second
# tick proving the new drain site does not double count, and the bypass suite
# -- a drain that delivers nothing (the positive case must be drain-sensitive
# or this stays green), a handler that returns early (skip read as pass), an
# empty ring (0 == 0 is not evidence), no ring at all, an endless producer
# (the drain must stop BOUNDED, count the truncation and log it), and a
# second truncation that must still be counted after the one-shot log.
test_tick_drain
# #455: the BACKEND ACTIVE SPAN. Queries' top row read DB Time 720.4 s beside
# Execs 91 / Avg Exec 33 us because the 714 s pre-executor Lock:relation is
# taken before query__execute__start, where no latency column can see it --
# and the only arithmetic the response offered, DB Time / Execs = 7.9 s,
# divides one session's wait by ninety-one OTHER sessions' executions. This
# test reproduces that exact shape, asserts the span's identity, boundaries,
# status and zero contained executions, and requires five mutations of the
# fix (including deriving the duration from DB Time / Execs) to fail the same
# oracle. Its bypass suite requires a refusal, never an approval, from every
# way the pass can be made blind.
test_backend_span
# #497: lock_chains presents an on-CPU-OVERLAP pick as the "blocker". No lock
# identity is compared and the candidate set is on-CPU intervals only, so a
# holder that is itself waiting, idle-in-transaction, or a prepared
# transaction cannot be returned however certainly it holds the lock. Scope
# is disclosure, not correctness: the response must carry a per-ROW basis
# (a note only at the top of the response is one a row renderer never reads)
# and prose naming both structural limits. Bypass suite: the note must also
# ship on a result with zero chains (otherwise "every row carries the field"
# is vacuously true), the response must be shown to be neither an error nor a
# fidelity refusal, and an empty trace dir must refuse rather than approve.
test_lock_chain_disclosure
# #498: the system_event view had no Off-CPU* row, so its %DB column could
# not sum to 100% while time_model's -- same trace, same numbers -- did.
# Off-CPU* is the on-CPU interval's wall minus its measured cpu ns and is not
# a wait event, so it lives only in the time model. Drives the real printers
# with stdout captured and sums the printed column against the literal 100.0.
# Bypass suite: an empty accumulator must make the conservation verdict
# REFUSE rather than approve, a zero DB Time must read short, the 20-row cap
# must not hide the row, and a zero residual (legacy/sampled tier) must print
# NO row rather than a 0.0% one.
test_system_event_offcpu
# #499 + #500: the trace sidecar and who can read a trace.
#   #499 is a startup ORDER bug — discovery writes wait_event_names.json
#   before the trace directory exists, so every -T run lost the capture's
#   wait-event name provenance. Every pre-existing test created its trace
#   dir with mktemp -d first, which is exactly why none of them saw it.
#   #500 is reader ACCESS, not mode bits: the default group "dba" exists
#   on almost no host, so traces were root:root 0640 and no non-root
#   replay or demo service could open them. 0640 is the mode in both the
#   broken and the fixed case, so this test opens the file as a real
#   non-root uid (root only) and checks a root:root control file in the
#   same directory stays refused.
test_trace_perms

# Real replay-over-UI comparator: empty fixture, unit/value/count REDs.
test_replay_ui.py

# #567: box-check.sh's up-rsync must never send tests/*.o (or *.a/*.so) to
# the Linux box, and a stale object already there must not survive either.
test_box_check_object_excludes.sh
