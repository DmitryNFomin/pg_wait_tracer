new file mode 100644
index 00000000..87f86b93
--- /dev/null
+++ b/tests/discovery_lifecycle_observer.py
@@ -0,0 +1,228 @@
+"""Read-only live-test witnesses; never consume or advance the product ring."""
+import ctypes
+import ctypes.util
+import json
+import mmap
+import os
+from pathlib import Path
+import subprocess
+import struct
+import threading
+import time
+
+
+def decode_l_record(payload):
+    assert len(payload) >= 32, ('short lifecycle wire record', payload.hex())
+    version, kind, flags, size, cpu, seq, cookie, q = struct.unpack_from('<HBBHHQQQ', payload)
+    assert version == 2 and kind in (2, 3, 4) and len(payload) == 32 + size, (
+        'unexpected lifecycle wire record', payload.hex())
+    row = dict(kind=kind, cpu=cpu, seq=seq, cookie=cookie, raw=payload.hex(), observed_ns=time.monotonic_ns())
+    if kind == 2:
+        event, exit_flags, pid, addr, stamp = struct.unpack_from('<HHIQQ', payload, 32)
+        row.update(event=event, pid=pid, timestamp_ns=stamp)
+    elif kind == 3:
+        event, pid = struct.unpack_from('<II', payload, 32)
+        row.update(event=event, pid=pid)  # text carries no kernel timestamp
+    else:
+        cutoff, round_number, dest = struct.unpack_from('<QII', payload, 32)
+        row.update(cutoff_ns=cutoff, round=round_number, dest=dest)
+    return row
+
+
+class ProcIdentities:
+    def __init__(self, postmaster):
+        self.postmaster = postmaster
+        self.identities = {}
+        self.stop = threading.Event()
+        self.thread = threading.Thread(target=self.watch, daemon=True)
+        self.thread.start()
+
+    def read(self, pid):
+        try:
+            root = Path(f'/proc/{pid}')
+            stat = (root / 'stat').read_text()
+            fields = stat[stat.rindex(')') + 2:].split()
+            value = dict(pid=pid, start_ticks=int(fields[19]), parent=int(fields[1]),
+                         comm=stat[stat.index('(') + 1:stat.rindex(')')],
+                         cmdline=(root / 'cmdline').read_bytes().replace(b'\0', b' ').decode(errors='replace').strip(),
+                         observed_ns=time.monotonic_ns())
+            # Do not combine a stat from one holder with another's title.
+            later = (root / 'stat').read_text()
+            if later[later.rindex(')') + 2:].split()[19] != fields[19]:
+                return self.identities.get(pid)
+            previous = self.identities.get(pid)
+            if previous and previous['start_ticks'] == value['start_ticks']:
+                value['last_nonempty_cmdline'] = value['cmdline'] or previous.get('last_nonempty_cmdline', previous['cmdline'])
+                value['cmdline_observed_ns'] = (value['observed_ns'] if value['cmdline'] else previous['cmdline_observed_ns'])
+            else:
+                value['last_nonempty_cmdline'] = value['cmdline']
+                value['cmdline_observed_ns'] = value['observed_ns'] if value['cmdline'] else 0
+            self.identities[pid] = value
+            return value
+        except (OSError, ValueError):
+            return self.identities.get(pid)
+
+    def watch(self):
+        while not self.stop.is_set():
+            try:
+                children = Path(f'/proc/{self.postmaster}/task/{self.postmaster}/children').read_text()
+                for pid in children.split():
+                    self.read(int(pid))
+            except OSError:
+                pass
+            self.stop.wait(0.001)
+
+    def close(self):
+        self.stop.set()
+        self.thread.join()
+
+
+class ForkWitness:
+    """Snapshot short-lived children before they run, only in the stopped arm.
+
+    PTRACE_SEIZE does not stop the postmaster at attachment. TRACEFORK gives
+    a stopped newborn whose /proc identity can be read before release. The
+    capture consumer is already stopped, so this cannot give it extra time
+    to attach a watchpoint. No product program or ring position is changed.
+    """
+    def __init__(self, identities):
+        self.identities = identities
+        self.stop = threading.Event()
+        self.ready = threading.Event()
+        self.error = None
+        self.thread = threading.Thread(target=self.watch, daemon=True)
+        self.thread.start()
+        assert self.ready.wait(5), 'fork witness readiness'
+        if self.error:
+            raise self.error
+
+    def watch(self):
+        libc = ctypes.CDLL(None, use_errno=True)
+        libc.ptrace.argtypes = [ctypes.c_uint, ctypes.c_int, ctypes.c_void_p, ctypes.c_void_p]
+        libc.ptrace.restype = ctypes.c_long
+        parent = self.identities.postmaster
+        wall = 0x40000000  # __WALL: include ptraced children
+        seized = stopped = interrupted = False
+        pending_signal = 0
+        child = None
+
+        def ptrace(request, pid, data=0):
+            argument = ctypes.c_void_p(data) if isinstance(data, int) else ctypes.cast(data, ctypes.c_void_p)
+            if libc.ptrace(request, pid, None, argument) == -1:
+                raise OSError(ctypes.get_errno(), f'fork witness ptrace {request} pid={pid}')
+
+        try:
+            ptrace(0x4206, parent, 2)  # SEIZE, O_TRACEFORK
+            seized = True
+            self.ready.set()
+            while True:
+                if self.stop.is_set() and not interrupted:
+                    ptrace(0x4207, parent)  # INTERRUPT for clean detach
+                    interrupted = True
+                pid, status = os.waitpid(parent, wall | os.WNOHANG)
+                if not pid:
+                    time.sleep(0.0005)
+                    continue
+                assert os.WIFSTOPPED(status), ('postmaster witness status', status)
+                stopped = True
+                event = status >> 16
+                pending_signal = os.WSTOPSIG(status) if event == 0 else 0
+                if event == 1:  # PTRACE_EVENT_FORK
+                    message = ctypes.c_ulong()
+                    ptrace(0x4201, parent, ctypes.byref(message))  # GETEVENTMSG
+                    child = message.value
+                    _, child_status = os.waitpid(child, wall)
+                    assert os.WIFSTOPPED(child_status), ('newborn witness status', child_status)
+                    identity = self.identities.read(child)
+                    assert identity, ('newborn /proc identity required', child)
+                    print('FORK-PROC-WITNESS ' + json.dumps(identity, sort_keys=True), flush=True)
+                    ptrace(17, child)  # DETACH and release immediately
+                    child = None
+                if self.stop.is_set():
+                    ptrace(17, parent, pending_signal)
+                    seized = False
+                    break
+                ptrace(7, parent, pending_signal)  # CONT; preserve real signals
+                pending_signal = 0
+                stopped = False
+        except BaseException as error:
+            self.error = error
+        finally:
+            try:
+                if child is not None:
+                    ptrace(17, child)
+                if seized:
+                    if not stopped:
+                        ptrace(0x4207, parent)
+                        _, status = os.waitpid(parent, wall)
+                        pending_signal = os.WSTOPSIG(status) if status >> 16 == 0 else 0
+                    ptrace(17, parent, pending_signal)
+            except OSError as error:
+                self.error = self.error or error
+            self.ready.set()
+
+    def close(self):
+        self.stop.set()
+        self.thread.join(timeout=10)
+        assert not self.thread.is_alive(), 'fork witness detaches'
+        if self.error:
+            raise self.error
+
+
+class LifecycleRing:
+    def __init__(self, map_number):
+        maps = json.loads(subprocess.check_output(
+            ['bpftool', '-j', 'map', 'show', 'id', str(map_number)], text=True))
+        info = maps[0] if isinstance(maps, list) else maps
+        self.capacity = info['max_entries']
+        lib = ctypes.CDLL(ctypes.util.find_library('bpf'), use_errno=True)
+        self.fd = lib.bpf_map_get_fd_by_id(map_number)
+        assert self.fd >= 0, ('ring witness fd', ctypes.get_errno())
+        page = mmap.PAGESIZE
+        self.consumer = mmap.mmap(self.fd, page, flags=mmap.MAP_SHARED, prot=mmap.PROT_READ)
+        self.producer = mmap.mmap(self.fd, page + 2 * self.capacity, flags=mmap.MAP_SHARED,
+                                  prot=mmap.PROT_READ, offset=page)
+        self.position = struct.unpack_from('=Q', self.consumer)[0]
+
+    def records(self):
+        end = struct.unpack_from('=Q', self.producer)[0]
+        assert end - self.position <= self.capacity, 'lifecycle witness ring overwritten'
+        result = []
+        while self.position < end:
+            offset = mmap.PAGESIZE + (self.position & (self.capacity - 1))
+            length = struct.unpack_from('=I', self.producer, offset)[0]
+            assert not length & (1 << 31), 'unfinished lifecycle reservation'
+            discarded = bool(length & (1 << 30))
+            length &= (1 << 30) - 1
+            payload = self.producer[offset + 8:offset + 8 + length]
+            self.position += (length + 8 + 7) & ~7
+            assert not discarded, 'discarded lifecycle attempt needs attribution'
+            result.append(decode_l_record(payload))
+        return result
+
+    def close(self):
+        self.consumer.close()
+        self.producer.close()
+        os.close(self.fd)
+
+
+def attributable_attempts(records, before, after, identities):
+    selected = [r for r in records if before[r['cpu']] < r['seq'] <= after[r['cpu']]]
+    expected = {(cpu, seq) for cpu, (a, b) in enumerate(zip(before, after)) for seq in range(a + 1, b + 1)}
+    assert len(selected) == len(expected) and {(r['cpu'], r['seq']) for r in selected} == expected, (
+        'every lifecycle attempt attributed', before, after, selected)
+    for row in selected:
+        if 'pid' in row:
+            row['proc'] = identities.read(row['pid'])
+        print('LIFECYCLE-WITNESS ' + json.dumps(row, sort_keys=True), flush=True)
+    assert all(row.get('proc') for row in selected if 'pid' in row), (
+        'lifecycle process identity unavailable', selected)
+    return selected
+
+
+def assert_subject_unchanged(subject, subject_cookie, records, journal_before, journal_after):
+    assert subject_cookie > 0, ('subject lifetime cookie required', subject_cookie)
+    assert not any(row.get('pid') == subject or row.get('cookie') == subject_cookie for row in records), (
+        'unrelated reuse emitted subject L record', subject, records)
+    assert journal_before == journal_after, (
+        'unrelated reuse wrote terminal journal', journal_before, journal_after)
