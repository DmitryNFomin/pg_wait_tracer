+#!/usr/bin/env python3
+"""Build the real EXIT producer and prove the subject guard catches its mutant."""
+from pathlib import Path
+import inspect
+import signal
+import tempfile
+import textwrap
+import threading
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import discovery_lifecycle_observer as observer
+from discovery_lifecycle_observer import assert_subject_unchanged, decode_l_record
+from test_discovery_producer import compile_run
+from transport_producers_host import ROOT, FUNCTIONS, function, replace_once
+
+
+def detach_signal_case(watch):
+    for event, signum in ((0, signal.SIGCHLD), (128, signal.SIGTRAP)):
+        witness = observer.ForkWitness.__new__(observer.ForkWitness)
+        witness.identities = SimpleNamespace(postmaster=12345)
+        witness.stop = threading.Event()
+        witness.ready = threading.Event()
+        witness.error = None
+        calls = []
+
+        class Ptrace:
+            def __call__(self, request, pid, address, data):
+                calls.append((request, pid, data.value or 0))
+                return 0
+
+        def stopped(pid, options):
+            witness.stop.set()  # close races with this signal-delivery stop
+            return pid, (event << 16) | (signum << 8) | 0x7f
+
+        with patch.object(observer.ctypes, 'CDLL', return_value=SimpleNamespace(ptrace=Ptrace())), \
+             patch.object(observer.os, 'waitpid', side_effect=stopped):
+            watch(witness)
+        assert witness.error is None, witness.error
+        expected = signum if event == 0 else 0
+        assert calls[-1] == (17, 12345, expected), 'observer detach preserves pending signal'
+
+
+def main():
+    source = (ROOT / 'src/bpf/pg_wait_tracer.bpf.c').read_text()
+    harness = (ROOT / 'tests/transport_bpf_harness.h').read_text()
+    harness = harness[:harness.index('int main(void)')]
+    # The retained discovery tombstone belongs to the old backend; the
+    # current holder has a different parent and must not emit an EXIT.
+    case = r'''
+int main(void) {
+    reset(); exact_perf_discovery=true; state_present=false; identity_present=true;
+    current_task.real_parent=&current_task;
+    struct trace_event_raw_sched_process_template ex={.pid=42}; on_exit(&ex);
+    for (int i=0;i<reservations;++i) {
+        struct record *r=&records[i];
+        if(r->dest!=PGWT_WIRE_DEST_L || r->done!=1) continue;
+        printf("WIRE ");
+        for(size_t b=0;b<r->length;++b) printf("%02x",r->bytes[b]);
+        putchar(10);
+    }
+    return 0;
+}
+'''
+    mutant = replace_once(source, 'if (pid != tgid || owner != target_postmaster_pid)', 'if (pid != tgid)')
+    with tempfile.TemporaryDirectory(prefix='pgwt-lifecycle-guard-') as temp:
+        for name, body in (('production', source), ('unrelated-exit-mutant', mutant)):
+            unit = harness.replace('/* PRODUCTION_FUNCTIONS */', '\n'.join(function(body, n) for n in FUNCTIONS)) + case
+            result = compile_run(Path(temp), name, [('producer', unit)])
+            assert result.returncode == 0, result.stdout + result.stderr
+            records = []
+            for line in result.stdout.splitlines():
+                if line.startswith('WIRE '):
+                    records.append(decode_l_record(bytes.fromhex(line[5:])))
+            if name == 'production':
+                assert_subject_unchanged(42, 1 << 63, records, ['old lifetime'], ['old lifetime'])
+                print('subject guard: production unrelated EXIT suppressed PASS')
+            else:
+                assert len(records) == 1 and records[0]['pid'] == 42 and records[0]['event'] == 3, records
+                print('subject guard built mutant emitted ' + repr(records), flush=True)
+                try:
+                    assert_subject_unchanged(42, 1 << 63, records, ['old lifetime'], ['old lifetime'])
+                except AssertionError as error:
+                    assert error.args[0][0] == 'unrelated reuse emitted subject L record', error
+                    print('subject guard mutant: RED (unrelated reuse emitted subject L record)')
+                else:
+                    raise AssertionError('subject guard accepted the built unrelated-EXIT mutant')
+    # A real worker elsewhere may change global counters without touching
+    # either the reused PID or its retained terminal witness.
+    assert_subject_unchanged(42, 1 << 63, [dict(pid=43, cookie=2, event=1), dict(pid=43, cookie=2, event=3)], ['old'], ['old'])
+    try:
+        assert_subject_unchanged(42, 1 << 63, [dict(pid=43, cookie=1 << 63, event=3)], ['old'], ['old'])
+    except AssertionError as error:
+        assert error.args[0][0] == 'unrelated reuse emitted subject L record', error
+    else:
+        raise AssertionError('subject guard accepted the subject cookie under another PID')
+    try:
+        assert_subject_unchanged(42, 1 << 63, [], ['old'], ['changed'])
+    except AssertionError as error:
+        assert error.args[0][0] == 'unrelated reuse wrote terminal journal', error
+    else:
+        raise AssertionError('subject guard accepted a changed subject journal')
+    print('subject guard: independent worker permitted; subject cookie and journal mutation rejected PASS')
+    detach_signal_case(observer.ForkWitness.watch)
+    print('fork witness: detach preserves real signals and suppresses synthetic traps PASS')
+    body = textwrap.dedent(inspect.getsource(observer.ForkWitness.watch))
+    assert 'ptrace(17, parent, pending_signal)' in body
+    namespace = {}
+    exec(compile(body.replace('ptrace(17, parent, pending_signal)', 'ptrace(17, parent)'),
+                 '<drop-detach-signal-mutant>', 'exec'), observer.__dict__, namespace)
+    try:
+        detach_signal_case(namespace['watch'])
+    except AssertionError as error:
+        assert str(error) == 'observer detach preserves pending signal', error
+        print('fork witness mutant: RED (observer detach preserves pending signal)')
+    else:
+        raise AssertionError('fork witness accepted dropped pending signal')
+
+
+if __name__ == '__main__':
+    main()
