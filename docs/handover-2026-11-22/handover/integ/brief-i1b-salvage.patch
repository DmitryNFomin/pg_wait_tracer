+        t.terminal_transport_known=true;t.terminal_cpu=0;t.terminal_dest=2;t.terminal_seq=100;
+        t.terminal_ns=DB+18;t.terminal_start_ns=t.lifetime_start_ns;t.terminal_cookie=DG;t.terminal_match=(fact){true,true};
+        s->joined=o;s->join_result=PGWT_DI_JOIN_UNIQUE;o_send(s,&t,1);
