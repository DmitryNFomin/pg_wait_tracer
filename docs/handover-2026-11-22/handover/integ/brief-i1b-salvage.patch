+#ifndef PGWT_DISCOVERY_INTEGRATION_H
+#define PGWT_DISCOVERY_INTEGRATION_H
+
+#include "discovery_admission.h"
+#include "merge_capture.h"
+#include "pgwt_transport_wire.h"
+
+/* Portable I1 boundary. One instance owns one capture; all clocks and I/O are
+ * supplied by the caller. No operation returns a fatal poll result.
+ * Callbacks may append producer handoff; they must not reenter this instance. */
+struct pgwt_discovery_integration;
+struct pgwt_wire_record;
+struct pgwt_di_construction {
+    /* Qualification of the named constructions in frozen B. Unknown by
+     * default; these are not inferred from cookie presence or elapsed time. */
+    struct pgwt_producer_fact emission_identity, isolated_seed;
+    struct pgwt_producer_fact ordered_operations, staged_reconciled;
+};
+enum pgwt_di_variant { PGWT_DI_CHECKED_SUPPORT, PGWT_DI_NO_SUPPORT };
+enum pgwt_di_attachment {
+    PGWT_DI_BOUND_UNINSTALLED, PGWT_DI_INSTALLED_PENDING, PGWT_DI_POINTER_PENDING,
+    PGWT_DI_ATTEMPTING, PGWT_DI_ADMITTED_NUMERICAL, PGWT_DI_ADMITTED_NO_WORD,
+    PGWT_DI_ABANDONED
+};
+enum pgwt_di_coverage {
+    PGWT_DI_PENDING, PGWT_DI_BOUND_COMMITTED, PGWT_DI_TERMINAL_COMMITTED,
+    PGWT_DI_REVOKED_PENDING
+};
+enum pgwt_di_terminal { PGWT_DI_UNDECIDED, PGWT_DI_MATCHED, PGWT_DI_UNRESOLVED };
+enum pgwt_di_operation {
+    PGWT_DI_OPTIONAL_REJECTION, PGWT_DI_REQUIRED_FAILURE, PGWT_DI_CONTRADICTION,
+    PGWT_DI_TRANSIENT, PGWT_DI_PERMANENT, PGWT_DI_CAPACITY, PGWT_DI_TRANSPORT,
+    PGWT_DI_WRITER, PGWT_DI_SUPPORT_UNAVAILABLE, PGWT_DI_SUPPORT_REJECTED,
+    PGWT_DI_DEADLINE, PGWT_DI_UNCLASSIFIED, PGWT_DI_FAULT_REJECTED,
+    PGWT_DI_OPERATION_COUNT
+};
+/* Decoded terminal receipt, before DATA feed. Reader position is independent
+ * of sequence. inventory_cookie names an obligation, not a matching claim. */
+struct pgwt_di_terminal_observation {
+    uint32_t cpu, destination;
+    uint64_t sequence, source, position, pid, cookie, time, inventory_cookie;
+};
+enum pgwt_di_join { PGWT_DI_JOIN_PENDING, PGWT_DI_JOIN_UNIQUE, PGWT_DI_JOIN_CONTRADICTION };
+struct pgwt_di_observation { uint64_t detected; ma_snapshot counters; };
+struct pgwt_di_ops {
+    void *ctx;
+    struct pgwt_discovery_checkpoint (*refresh_until)(void *, uint64_t deadline);
+    void (*checkpoint)(void *, struct pgwt_discovery_checkpoint *);
+    bool (*next)(void *, size_t *, struct pgwt_discovery_attempt *);
+    bool (*binding)(void *, uint64_t, struct pgwt_discovery_binding_snapshot *);
+    void (*stop_attempts)(void *);
+    /* Full current 15-component snapshot, also after checked publication. */
+    int (*counters)(void *, struct pgwt_di_observation *);
+    void (*barrier)(void *, bool blocked);
+    /* Observe the checked startup-gap publisher's acknowledgement. The
+     * capture's coverage_begin return alone does not expose publication. */
+    bool (*startup_gap_ready)(void *);
+    enum pgwt_di_join (*terminal_join)(void *, const struct pgwt_discovery_attempt *,
+                                       struct pgwt_di_terminal_observation *);
+    /* I2 supplies actual retained B membership. Unknown must return false. */
+    bool (*generation_member)(void *, uint64_t pid, uint64_t cookie,
+                               uint64_t generation, const struct pgwt_wire_record *);
+    /* Return 0 only for checked success. Absent support is pending in (a).
+     * revoke persists support revocation (a), or a boot-wide gap (b). */
+    int (*support)(void *, uint64_t pid, uint64_t cookie,
+                   const pgwt_discovery_no_word *, ma_snapshot *);
+    int (*revoke)(void *, enum pgwt_di_variant, uint64_t boot, uint64_t pid,
+                  uint64_t cookie, uint64_t detected, ma_snapshot *);
+    /* Observation only: attempted delivery, never an acceptance signal. */
+    void (*control_attempted)(void *, const pgwt_discovery_attempt *);
+};
+struct pgwt_di_report;
+struct pgwt_di_config {
+    struct pgwt_merge_capture *capture;
+    size_t capacity, cpu_count;
+    uint64_t f0, baseline_time;
+    ma_snapshot baseline;
+    struct pgwt_discovery_checkpoint failure_baseline;
+    struct pgwt_di_construction construction;
+    struct pgwt_di_ops ops;
+    enum pgwt_di_variant variant; /* zero is (a) */
+    /* Optional calloc/free injection. Both must be supplied together.
+     * Creation failure is also recorded in caller-owned storage and capture. */
+    void *(*allocate)(void *, size_t count, size_t size);
+    void (*deallocate)(void *, void *);
+    struct pgwt_di_report *creation_outcome;
+};
+struct pgwt_di_lifetime {
+    enum pgwt_di_attachment attachment;
+    enum pgwt_di_coverage coverage;
+    uint64_t attempted_controls, delivered_controls;
+    /* A missing acceptance_known bit is unavailable, not a refused control.
+     * In particular the frozen core accessor does not expose quiet_pending. */
+    uint64_t acceptance_known, accepted_controls;
+    bool registered, installed, attempts_ended, sticky_nonnull, sticky_break;
+    uint32_t maximum_attempts;
+    bool maximum_attempts_known;
+    pgwt_discovery_state committed; /* copied from capture, never derived */
+};
+struct pgwt_di_report {
+    pgwt_capture_discovery_report pending; /* merge/capture authority */
+    uint64_t outcomes[PGWT_DI_OPERATION_COUNT], kernel_delivered, user_delivered;
+    uint64_t reconciliation_ns, reconciliation_count;
+    size_t lifetimes, numbers, terminals, append_cursor, staged_records, undecided_terminals;
+    int last_error;
+    bool permanent_failure, attempts_stopped, tracking_failed;
+    bool incomplete, unclean, certification_blocked, barrier_active, pending_totals_available;
+    bool terminal_finalisation_incomplete;
+};
+struct pgwt_di_translation {
+    pgwt_discovery_facts proof;
+    pgwt_discovery_witness quiet;
+    pgwt_discovery_no_word no_word;
+    pgwt_discovery_resolution resolution;
+};
+void pgwt_di_translate(const struct pgwt_discovery_attempt *,
+                       const struct pgwt_di_construction *, struct pgwt_di_translation *);
+struct pgwt_discovery_integration *pgwt_di_create(const struct pgwt_di_config *);
+void pgwt_di_destroy(struct pgwt_discovery_integration *);
+void pgwt_di_checkpoint(struct pgwt_discovery_integration *, uint64_t now, uint64_t deadline);
+/* Direct copied batch, with the same barrier/order as the producer path.
+ * current is the fresh acceptance gate; census retains its own historical cut. */
+void pgwt_di_batch(struct pgwt_discovery_integration *, const struct pgwt_discovery_attempt *,
+                   size_t count, const struct pgwt_discovery_attempt *census,
+                   const struct pgwt_discovery_checkpoint *current, uint64_t now);
+void pgwt_di_terminal_received(struct pgwt_discovery_integration *,
+                                const struct pgwt_di_terminal_observation *, uint64_t now);
+/* I2 supplies the decoded wire record and its semantic PID/time. Receipt
+ * side effects may append producer records. Drain them before DATA feed;
+ * unknown generation origin is retained with its source position and bytes. */
+void pgwt_di_receive(struct pgwt_discovery_integration *, const struct pgwt_wire_record *,
+                      uint64_t pid, uint64_t time, uint64_t generation,
+                      uint64_t now, uint64_t deadline);
+void pgwt_di_origin(struct pgwt_discovery_integration *, uint64_t pid, uint64_t cookie,
+                     uint64_t generation, const struct pgwt_wire_record *, pgwt_discovery_origin *);
+/* Bridge for capture_config.publish_no_wait_word. The caller's context
+ * wrapper supplies this instance. (a) checks the earlier durable support
+ * acknowledgement; (b) performs no role-support publication. Both retain
+ * the capture's checked FRONTIER and gap path. */
+bool pgwt_di_publish_support(struct pgwt_discovery_integration *, uint64_t pid, uint64_t cookie,
+                              const pgwt_discovery_no_word *, pgwt_merge_observation *post);
+/* Preserve a decoder/transport's already classified reason; do not infer
+ * sequence or dependency faults from an errno. */
+void pgwt_di_transport_fault(struct pgwt_discovery_integration *, pgwt_merge_reason,
+                              int error, uint64_t now);
+void pgwt_di_operation_result(struct pgwt_discovery_integration *, enum pgwt_di_operation,
+                               int error, uint64_t now);
+struct pgwt_di_report pgwt_di_status(struct pgwt_discovery_integration *);
+bool pgwt_di_lifetime_state(struct pgwt_discovery_integration *, uint64_t pid, uint64_t cookie,
+                             struct pgwt_di_lifetime *);
+#endif
