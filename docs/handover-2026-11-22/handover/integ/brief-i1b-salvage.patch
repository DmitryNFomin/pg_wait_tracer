+    h->reject_frontier=!strcmp(id,"V4");complete(h,19);
+    CHECK(!life(s).committed.terminal_released,"voided release never commits terminal discharge");
+    rearm_terminal(h);h->reject_frontier=false;h->counter_after_frontier=false;
