+        s->joined=(struct pgwt_di_terminal_observation){.cpu=1,.destination=2,.sequence=99,.source=3,.position=7,
+            .pid=30,.time=DB+4,.inventory_cookie=DG};s->join_result=PGWT_DI_JOIN_UNIQUE;
+        if(variant==0)s->joined.source=2;
