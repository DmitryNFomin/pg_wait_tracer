+struct mask_case {uint64_t bit;size_t offset;bool construction;};
+#define RM(bit,member) {PGWT_DISC_##bit,offsetof(struct pgwt_discovery_attempt,member),false}
+#define KM(bit,member) {PGWT_DISC_##bit,offsetof(struct pgwt_di_construction,member),true}
+static const struct mask_case masks[]={
+    RM(LIFECYCLE_ACCOUNTING,lifecycle_active),RM(PREEXISTING,no_observed_fork),
+    RM(NO_FORK_PROVENANCE,history_complete),RM(COOKIE_AUTHORITY,cookie_burned),
+    RM(IDENTITY_VISIBLE,identity_visible),RM(INSTALL_BEFORE_ENABLE,install_before_enable),
+    RM(PINNED_BINDING,retained_binding),RM(ADDRESS_CONTINUOUS,address_compared),
+    KM(PRESERVED_STATE,isolated_seed),RM(ENABLED,enable_confirmed),KM(EMISSION_IDENTITY,emission_identity),
+    RM(FAILURE_ACCOUNTING,failure_accounting),KM(BRACKET_ORDER,ordered_operations),
+    RM(THREAD_HISTORY,single_thread_history),RM(OWNERSHIP,no_foreign_writer),RM(CPU_ENROLLED,cpu_enrolled),
+    KM(FRESH_COHERENT_SEED,isolated_seed),KM(RECONCILED,staged_reconciled),RM(COUNTER_NO_WRAP,voluntary_no_wrap),
+    KM(REQUIRED_READS,ordered_operations)};
