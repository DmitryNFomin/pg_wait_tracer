+        case PGWT_DH_INVENTORY:CHECK(life(s).registered && !life(s).committed.admitted,"INVENTORY registers even unknown installation");break;
+        case PGWT_DH_INSTALLED:CHECK(life(s).installed==(state==0),"INSTALLED requires its own visibility evidence");break;
+        case PGWT_DH_NUMERIC:CHECK(pgwt_di_status(s->integration).pending.unresolved_numeric==1,"NUMERIC preserves unknown failed-open time");break;
+        case PGWT_DH_RESOLUTION:CHECK(issued(s,PGWT_DISC_GONE)==(size_t)(state==0),"RESOLUTION requires known journal ineligibility");break;
+        case PGWT_DH_ATTEMPT:CHECK(issued(s,PGWT_DISC_WAIT_ATTEMPT)==1 && life(s).committed.admitted==(state==0),"ATTEMPT separates physical attempt from qualified admission");break;
+        case PGWT_DH_NO_WORD:CHECK(issued(s,PGWT_DISC_TRY_NO_WAIT_WORD)==1 && life(s).committed.admitted==(state==0),"NO_WORD keeps an unknown role pending");break;
+        case PGWT_DH_POINTER:CHECK(life(s).committed.pointer_nonnull==(state==0) && !life(s).committed.pointer_discontinuous,"POINTER unknown snapshot never becomes a read or break");break;
