+static void join_guards(void)
+{
+    for(int variant=0;variant<5;++variant) {
+        struct ih *s=isetup(PGWT_DI_CHECKED_SUPPORT,true,16);registered(s);
+        struct pgwt_discovery_attempt r=valid_record(PGWT_DH_TERMINAL);
