+#undef KM
+static void mask_case(size_t m)
+{
+    struct pgwt_discovery_attempt r=valid_record(PGWT_DH_ATTEMPT);
+    struct pgwt_di_construction k={.emission_identity={true,true},.isolated_seed={true,true},
+        .ordered_operations={true,true},.staged_reconciled={true,true}};
+    struct pgwt_di_translation t;pgwt_di_translate(&r,&k,&t);
+    CHECK(pgwt_discovery_has(t.proof,(UINT64_C(1)<<20)-1),"valid evidence derives every producer proof bit");
+    const struct mask_case *c=&masks[m];
+    fact *f=(fact *)((unsigned char *)(c->construction?(void *)&k:(void *)&r)+c->offset);
+    *f=(fact){false,false};pgwt_di_translate(&r,&k,&t);
+    CHECK(!(t.proof.known&c->bit) && !(t.proof.truth&c->bit),"unknown proof bit stays unknown");
+    *f=(fact){true,false};pgwt_di_translate(&r,&k,&t);
+    CHECK((t.proof.known&c->bit) && !(t.proof.truth&c->bit),"contradictory proof bit is known false");
+    CHECK(!(t.proof.known&(PGWT_DISC_INVENTORIED|PGWT_DISC_STARTUP_OPEN)),"producer cannot set capture facts");
+}
