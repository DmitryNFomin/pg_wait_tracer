+static void journal_case(bool before_receipt,bool contradiction)
+{
+    struct ih *s=isetup(PGWT_DI_CHECKED_SUPPORT,true,16);s->census.inventory_count=1;
+    struct pgwt_discovery_attempt n=valid_record(PGWT_DH_NUMERIC);n.cookie=0;n.failed_open=DB+3;
+    struct pgwt_discovery_attempt j=valid_record(PGWT_DH_RESOLUTION);j.numeric_resolution=PGWT_DISC_NUM_J;
+    j.journal_eligible=(fact){true,true};j.terminal_match=(fact){true,true};
+    j.terminal_transport_known=true;j.terminal_cpu=0;j.terminal_dest=2;j.terminal_seq=77;
+    j.terminal_ns=DB+4;j.terminal_start_ns=j.lifetime_start_ns;j.terminal_cookie=0;
+    /* Journal-only inventory has neither a task handle nor installation. */
+    j.binding_token=0;j.retained_binding=(fact){0};j.identity_visible=(fact){0};
+    struct pgwt_discovery_attempt r=valid_record(PGWT_DH_RESOLUTION);r.numeric_resolution=PGWT_DISC_NUM_G;
+    r.gone_esrch=(fact){true,true};r.gone_at=DB+6;
+    struct pgwt_discovery_attempt batch[3]={r,j,n};
+    s->joined=(struct pgwt_di_terminal_observation){.cpu=0,.destination=2,.sequence=77,.source=3,.position=1,
+        .pid=30,.time=DB+(contradiction?5:4),.inventory_cookie=DG};
+    s->join_result=before_receipt?PGWT_DI_JOIN_PENDING:PGWT_DI_JOIN_UNIQUE;
+    send_batch(s,batch,3);
