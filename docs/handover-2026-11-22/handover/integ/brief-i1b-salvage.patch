+    r=valid_record(PGWT_DH_ATTEMPT);r.accumulator=5;r.cpu_base=4;
+    pgwt_di_translate(&r,&k,&t);CHECK(!pgwt_discovery_has(t.proof,PGWT_DISC_FRESH_COHERENT_SEED),"actual seed must share CPU base");
