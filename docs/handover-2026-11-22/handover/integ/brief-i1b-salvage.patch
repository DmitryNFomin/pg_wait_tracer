+        if(kind==PGWT_DH_FAULT){r.evidence_fault=true;if(state==1)r.evidence_counts_known=false;}
+        if(state==2){r.census_record=kind!=PGWT_DH_CENSUS;r.numeric_record=kind==PGWT_DH_CENSUS;}
