+static void publisher(enum pgwt_di_variant v,bool present,bool reject)
+{
+    struct ih *s=isetup(v,present,16);s->support_reject=reject;registered(s);
+    struct pgwt_discovery_attempt r=valid_record(PGWT_DH_NO_WORD);r.no_wait_word=true;
