+     'if(false && nw && !acceptance_gate(i,l)) return;', 'publication_checkpoint', 'post-publication checkpoint gates confirmation'),
+    ('unknown_inactivity_as_false', 's==PGWT_DISC_UNKNOWN?unknown():yesno(s==PGWT_DISC_INACTIVE)',
+     'yesno(s==PGWT_DISC_INACTIVE)', 'unknown_observations', 'unknown inactivity is not a false observation'),
+    ('unqualified_observation_compared', 'return valid?yesno(a==b):unknown();',
+     'return valid?yesno(a==b):yesno(a==b);', 'unknown_observations', 'unqualified endpoint values stay unknown'),
+    ('current_checkpoint_pending_is_complete', 'i->checkpoint.reconciliation!=PGWT_DREC_COMPLETE || !i->checkpoint.handoff_complete',
+     'false || !i->checkpoint.handoff_complete', 'fresh_gate', 'pending current checkpoint cannot establish a positive census'),
+    ('old_census_repairs_revocation', 'if(i->census_invalidated_at && (r->reconciliation_ns<i->census_invalidated_at ||',
+     'if(false && i->census_invalidated_at && (r->reconciliation_ns<i->census_invalidated_at ||',
+     'revoke_after', 'old census cannot repair committed revocation'),
+    ('ack_fault_before_checked_handling', 'if(fault(i,PGWT_MERGE_UNKNOWN_EVIDENCE)) {',
+     'if(true) {', 'fault_publication_error', 'failed fault publication is explicitly unclean'),
+]
+
+
+def product_block(source, header):
+    start = source.index(header)
+    opening = source.index('{', start)
+    depth = 0
+    for index in range(opening, len(source)):
+        depth += (source[index] == '{') - (source[index] == '}')
+        if depth == 0:
+            return source[start:index + 1]
+    raise AssertionError('unterminated product block: ' + header)
+
+
+# Whole-block movement changes execution order without omitting the operation.
+# All expected values and assertion bodies remain unchanged.
+_product = (ROOT / 'src/discovery_integration.c').read_text()
+_pub = product_block(_product, 'if(i->cfg.variant==PGWT_DI_CHECKED_SUPPORT && !l->support_published)')
+_final = product_block(_product, 'static void final_attachment(')
+_late_pub = _final.replace(_pub, '').replace(
+    'deliver(i,l,&a);l->confirmation_sent=true;',
+    'deliver(i,l,&a);l->confirmation_sent=true;\n    if(nw) {' + _pub + '}')
+_pointer = product_block(_product, 'static void pointer_record(')
+_late_revoke = _pointer.replace('if(nonnull || broken) revoke(i,l);', '').replace(
+    'deliver(i,l,&a);', 'deliver(i,l,&a); if(nonnull || broken) revoke(i,l);')
+_numeric_start = _product.index('    for(size_t n=0;n<count;++n)', _product.index('    /* Numbers precede'))
+_numeric_end = _product.index('    for(size_t n=0;n<count;++n)', _numeric_start + 1)
+_numeric = _product[_numeric_start:_numeric_end]
+_retry = '    for(size_t n=0;n<i->nlives;++n)\n        if(i->lives[n].final_valid'
+_stop = ('    if(p->reconciliation==PGWT_DREC_PERMANENT_FAILURE && !i->report.permanent_failure)\n'
+         '        pgwt_di_operation_result(i,PGWT_DI_PERMANENT,p->error,i->now);\n')
+MUTANTS += [
+    ('permanent_stop_after_fault', [(_stop, ''),
+     ('    if(p->reconciliation==PGWT_DREC_PENDING)', _stop+'    if(p->reconciliation==PGWT_DREC_PENDING)')], None,
+     'permanent_fault_order', 'permanent loss stops attempts before revocation and fault delivery'),
+    ('numeric_after_resolution', [(_numeric, ''), (_retry, _numeric + _retry)], None,
+     'numeric_order', 'numeric registration precedes G resolution'),
+    ('positive_census_before_registration', '    if(census && !tag_valid(census))',
+     '    if(census)result(i,pgwt_capture_discovery_census(i->cfg.capture,census->reconciliation_ns,true,i->now,&i->current));\n'
+     '    if(census && !tag_valid(census))', 'census_order', 'positive census cannot publish before registration'),
+    ('fault_after_admission', [
+        ('if(r->kind==PGWT_DH_FAULT && (r->evidence_fault || r->error))',
+         'if(false && r->kind==PGWT_DH_FAULT && (r->evidence_fault || r->error))'),
+        ('    switch(r->kind) {',
+         '    if(r->kind==PGWT_DH_FAULT && r->evidence_fault) pgwt_di_operation_result(i,PGWT_DI_REQUIRED_FAILURE,r->error,i->now);\n'
+         '    switch(r->kind) {')], None, 'fault_order', 'negative fault precedes release-capable admission'),
+    ('support_after_confirmation', _final, _late_pub, 'publisher_a', 'support publication precedes confirmation'),
+    ('revocation_after_contradiction', _pointer, _late_revoke, 'revoke_after', 'only committed route c triggers durable revocation'),
+    ('finalise_before_retained_witness', '    /* Witnesses survive a receipt-before-controls',
+     '    finalize_terminals(i);\n    /* Witnesses survive a receipt-before-controls',
+     'terminal', 'unique join is not terminal discharge'),
+    ('attempt_after_admission', 'if(l->state.committed.admitted) {',
+     'if(false && l->state.committed.admitted) {', 'attempt_after_admit', 'no new word attempt is forwarded after accepted ADMIT'),
+    ('historical_counters_replace_current', '!i->handoff_lost && current_agrees(i,r,false)',
+     '!i->handoff_lost', 'current_resolution_counter', 'current counters cannot be replaced by historical witness counters'),
+    ('installation_erases_binding', 'if(!(l->bound.known && !l->bound.value) && b.known)l->bound=b;',
+     'l->bound=b;', 'immutable_identity', 'installation cannot erase independently retained binding'),
+    ('installation_erases_start', 'if(l->start_known){l->retained.lifetime_start_ns=l->start;l->retained.start_mono_known=yesno(true);}',
+     'if(!exact)l->start_known=false; if(l->start_known){l->retained.lifetime_start_ns=l->start;l->retained.start_mono_known=yesno(true);}',
+     'immutable_identity', 'installation cannot erase immutable exact start identity'),
+]
+
+
+MUTANTS += [
+    ('complete_checkpoint_as_permanent', 'if(p->reconciliation==PGWT_DREC_PERMANENT_FAILURE && !i->report.permanent_failure)',
+     'if(p->reconciliation!=PGWT_DREC_PENDING && !i->report.permanent_failure)', 'basic', 'attempt admits then confirms once'),
+    ('pending_resolution_as_gone', 'else if(r->numeric_resolution==PGWT_DISC_NUM_G) {',
+     'else if(r->numeric_resolution==PGWT_DISC_NUM_G || r->numeric_resolution==PGWT_DISC_NUM_PENDING) {',
+     'pending_resolution', 'pending resolution selector cannot become GONE'),
+    ('invalid_variant_as_no_support', '(unsigned)cfg->variant>PGWT_DI_NO_SUPPORT',
+     'false', 'invalid_configuration', 'invalid D3 enum cannot select publication-free behaviour'),
+]
+
+
+MUTANTS += [
+    ('reject_final_attempt_N', 'r->attempt>PGWT_DISCOVERY_ATTEMPTS ||',
+     'r->attempt>=PGWT_DISCOVERY_ATTEMPTS ||', 'attempt_ordinals', 'one-based physical ordinals include final fresh attempt N'),
+    ('zero_attempt_is_physical', '!r->attempt || r->attempt>PGWT_DISCOVERY_ATTEMPTS',
+     'r->attempt>PGWT_DISCOVERY_ATTEMPTS', 'attempt_ordinals', 'zero and above-N attempt ordinals are refused'),
+    ('ignore_configured_attempt_limit', 'r->attempt>r->maximum_attempts',
+     'false', 'attempt_ordinals', 'zero and above-N attempt ordinals are refused'),
+]
+
+
+def run(command, tree, check=True):
+    result = subprocess.run(command, cwd=tree, text=True, capture_output=True)
+    if check and result.returncode:
+        raise AssertionError(f'{shlex.join(map(str, command))}\n{result.stdout}{result.stderr}')
+    return result
+
+
+def build(tree):
+    binary = tree / 'integration-host'
+    run(shlex.split(os.environ.get('CC', 'cc')) + FLAGS + shlex.split(os.environ.get('CFLAGS', '')) +
+        SOURCES + ['-o', str(binary)], tree)
+    return binary
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--mutants', action='store_true')
+    parser.add_argument('--case')
+    parser.add_argument('--mutant', action='append', choices=[m[0] for m in MUTANTS], default=[])
+    args = parser.parse_args()
+    with tempfile.TemporaryDirectory(prefix='pgwt-discovery-integration-') as tmp:
+        tree = Path(tmp)
+        shutil.copytree(ROOT / 'src', tree / 'src')
+        shutil.copytree(ROOT / 'tests', tree / 'tests', ignore=shutil.ignore_patterns('results', 'web_snapshots', '__pycache__'))
+        fixture = tree / 'tests/discovery_admission_host.c'
+        source = fixture.read_text()
+        before = 'int main(int argc,char **argv)'
+        assert source.count(before) == 1
+        assertion_start = source.index('    const struct discovery_amended_expected *e=NULL;',
+                                       source.index('static void amended_row('))
+        assertion_end = source.index('    pgwt_capture_destroy(h->capture);free(h);', assertion_start)
+        borrowed = ('\nstatic void integration_amended_state(struct dh *h,const char *id)\n{\n' +
+                    source[assertion_start:assertion_end] + '}\n')
+        (tree / 'tests/discovery_fixture.c').write_text(
+            source.replace(before, 'int discovery_fixture_main(int argc,char **argv)') + borrowed)
+        binary = build(tree)
+        print(run([str(binary)] + ([args.case] if args.case else []), tree).stdout, end='', flush=True)
+        if args.mutants or args.mutant:
+            file = tree / 'src/discovery_integration.c'
+            original = file.read_text()
+            selected = [m for m in MUTANTS if args.mutants or m[0] in args.mutant]
+            for name, before, after, case, assertion in selected:
+                patches = [(before, after)] if isinstance(before, str) else before
+                mutated = original
+                for old, new in patches:
+                    assert mutated.count(old) == 1, (name, mutated.count(old))
+                    mutated = mutated.replace(old, new)
+                file.write_text(mutated)
+                result = run([str(build(tree)), case], tree, False)
+                assert f'REACHED integration {case}' in result.stdout, (name, result.stdout)
+                assert result.returncode == 1 and f'ASSERT integration {case}: {assertion} (line ' in result.stderr, (
+                    name, result.returncode, result.stdout, result.stderr)
+                assert not any(x in result.stderr for x in ['AddressSanitizer', 'runtime error:']), result.stderr
+                print(f'MUTANT {name}: built, reached {case}, RED ({assertion})', flush=True)
+                file.write_text(original)
+            print(f'discovery integration mutants: {len(selected)}/{len(selected)} RED', flush=True)
+
+
+if __name__ == '__main__':
+    main()
