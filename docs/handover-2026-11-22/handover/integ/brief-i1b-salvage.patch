+        s->join_result=PGWT_DI_JOIN_UNIQUE;pgwt_di_terminal_received(s->integration,&s->joined,DB+20);
+        send_batch(s,NULL,0);
+    }
+    CHECK(issued(s,PGWT_DISC_GONE)==0,"eligible J has precedence over G");
+    CHECK(issued(s,PGWT_DISC_JOURNAL)>=1,"journal record translates to JOURNAL");
+    CHECK(pgwt_di_status(s->integration).pending.unresolved_numeric==0 && life(s).registered && !life(s).installed,
+        "journal establishes exact uninstalled inventory and numeric resolution");
+    if(contradiction) {
+        CHECK(issued(s,PGWT_DISC_TERMINAL)==0 && !life(s).committed.terminal_released,
+            "contradictory joined time cannot be overwritten by journal time");
+        CHECK(pgwt_capture_report(s->h->capture).faults[PGWT_MERGE_UNKNOWN_EVIDENCE]>0,"journal time contradiction faults");
+    } else {
