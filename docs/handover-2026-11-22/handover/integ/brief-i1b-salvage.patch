+#include "discovery_integration.h"
+#include "percpu_transport.h"
+#include <errno.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct pgwt_producer_fact fact;
+static int diagnostic_errno(int e) {return e==INT_MIN?EINVAL:e<0?-e:e;}
+static fact yesno(bool v) { return (fact){true, v}; }
+static fact unknown(void) { return (fact){false, false}; }
+static bool holds(fact f) { return f.known && f.value; }
+static fact both(fact a, fact b)
+{
+    if ((a.known && !a.value) || (b.known && !b.value)) return yesno(false);
+    return a.known && b.known ? yesno(true) : unknown();
+}
+static fact either(fact a, fact b)
+{
+    if (holds(a) || holds(b)) return yesno(true);
+    return a.known && b.known ? yesno(false) : unknown();
+}
+static fact all(const fact *v, size_t n)
+{ fact f=yesno(true); for(size_t i=0;i<n;++i) f=both(f,v[i]); return f; }
+#define ALL(...) all((fact[]){__VA_ARGS__}, sizeof((fact[]){__VA_ARGS__})/sizeof(fact))
+static fact nonzero(uint64_t x) { return x ? yesno(true) : unknown(); }
+static fact observed_equal(uint64_t a,uint64_t b,bool valid)
+{return valid?yesno(a==b):unknown();}
+static fact inactive_fact(enum pgwt_discovery_inactive s)
+{return s==PGWT_DISC_UNKNOWN?unknown():yesno(s==PGWT_DISC_INACTIVE);}
+static fact ordered(uint64_t a, uint64_t b, bool strict)
+{ return a && b ? yesno(strict ? a<b : a<=b) : unknown(); }
+static fact vector_equal(const struct pgwt_counter_vector *a,
+                          const struct pgwt_counter_vector *b, bool lifecycle)
+{
+    fact f=yesno(true);
+    for(size_t i=0;i<PGWT_COUNTER_COMPONENTS;++i) {
+        if(lifecycle && i!=0 && i!=1 && i!=2 && i!=10) continue;
+        fact cell=a->components[i].valid && b->components[i].valid ?
+            yesno(a->components[i].value==b->components[i].value) : unknown();
+        f=both(f,cell);
+    }
+    return ALL(f, a->valid ? yesno(true):unknown(), b->valid ? yesno(true):unknown());
+}
+static void bit(pgwt_discovery_facts *m, uint64_t b, fact f)
+{ if(f.known) m->known|=b; if(holds(f)) m->truth|=b; }
+static pgwt_discovery_inactivity inactive(enum pgwt_discovery_inactive s)
+{
+    switch(s) {
+    case PGWT_DISC_INACTIVE: return PGWT_DISC_INACTIVE_SYSCALL;
+    case PGWT_PRODUCER_RUNNING: return PGWT_DISC_RUNNING;
+    case PGWT_PRODUCER_DENIED: return PGWT_DISC_DENIED;
+    case PGWT_PRODUCER_MALFORMED: return PGWT_DISC_MALFORMED;
+    case PGWT_DISC_UNKNOWN: default: return PGWT_DISC_INACTIVITY_UNKNOWN;
+    }
+}
+static fact preexisting(const struct pgwt_discovery_attempt *r)
+{
+    /* The two comparisons are in separately qualified clock domains. */
+    fact exact=ALL(r->start_mono_known, ordered(r->lifetime_start_ns,r->f0_ns,true));
+    fact bound=ALL(r->clock_bound,r->predates_boot,
+                   ordered(r->start_upper_ns,r->boot_lower_ns,true));
+    return ALL(either(exact,bound),r->no_observed_fork,
+               r->history_complete,yesno(r->fork_cookie==0));
+}
+static fact retained_handle(const struct pgwt_discovery_attempt *r)
+{
+    return ALL(nonzero(r->binding_token),r->retained_binding,r->inventory_bound,r->fd_bound,r->memory_bound);
+}
+static fact binding(const struct pgwt_discovery_attempt *r)
+{ return ALL(retained_handle(r),r->postmaster_member); }
+static fact accounting(const struct pgwt_discovery_attempt *r)
+{
+    return ALL(r->failure_accounting,r->counters_unchanged,
+        vector_equal(&r->counters_before,&r->counters_after,false),
+        r->evidence_counts_known?yesno(!r->evidence_fault):unknown(),
+        yesno(r->handoff_complete));
+}
+void pgwt_di_translate(const struct pgwt_discovery_attempt *r,
+                       const struct pgwt_di_construction *k, struct pgwt_di_translation *o)
+{
+    memset(o,0,sizeof(*o));
+    if(!r || !k) return;
+    bool nw=r->kind==PGWT_DH_NO_WORD || r->no_wait_word;
+    uint64_t e=nw?r->pointer_enabled_ns:r->e;
+    fact pin=binding(r), history=ALL(r->history_complete,r->lifecycle_fenced);
+    fact read=ALL(r->v0_valid?yesno(true):unknown(),r->v1_valid?yesno(true):unknown(),
+        r->inactivity_interface,inactive_fact(r->S0),inactive_fact(r->S1),
+        r->address_qualified,r->address_compared,nonzero(r->armed_addr),nonzero(r->resolved_addr),
+        observed_equal(r->armed_addr,r->resolved_addr,r->armed_addr && r->resolved_addr),
+        r->seed_valid?yesno(true):unknown());
+    fact order=ALL(k->ordered_operations,yesno(r->quiet_valid),read,
+                   ordered(r->begin_ns,r->t,false),ordered(r->t,r->e,false),
+                   ordered(r->e,r->end_ns,false),r->enable_confirmed);
+    fact visible=ALL(r->identity_immutable,r->identity_visible,nonzero(r->identity_visible_at));
+    fact address=nw?ALL(r->address_qualified,r->pointer_continuous):
+        ALL(r->address_qualified,r->address_compared,nonzero(r->armed_addr),nonzero(r->resolved_addr),
+            observed_equal(r->armed_addr,r->resolved_addr,r->armed_addr && r->resolved_addr),either(r->stable_address_phase,r->relocation_observed));
+    fact reconciliation=ALL(history,r->producers_complete,r->generations_fenced,
+        nonzero(r->reconciliation_ns),nonzero(r->reconciliation_count),
+        yesno(r->reconciliation==PGWT_DREC_COMPLETE),ordered(e,r->reconciliation_ns,false),k->staged_reconciled);
+    bit(&o->proof,PGWT_DISC_LIFECYCLE_ACCOUNTING,ALL(r->lifecycle_active,history,
+        r->producers_complete,r->counters_unchanged,
+        vector_equal(&r->counters_before,&r->counters_after,true)));
+    bit(&o->proof,PGWT_DISC_PREEXISTING,preexisting(r));
+    bit(&o->proof,PGWT_DISC_NO_FORK_PROVENANCE,ALL(r->no_observed_fork,history,
+        yesno(r->reconciliation==PGWT_DREC_COMPLETE),yesno(r->fork_cookie==0)));
+    bit(&o->proof,PGWT_DISC_COOKIE_AUTHORITY,ALL(r->fork_allocator_partitioned,
+        r->discovery_allocator_serialized,r->cookie_partitioned,r->cookie_burned,
+        r->allocation_no_wrap,yesno(r->cookie>=PGWT_DISCOVERY_COOKIE_MIN)));
+    bit(&o->proof,PGWT_DISC_IDENTITY_VISIBLE,visible);
+    bit(&o->proof,PGWT_DISC_INSTALL_BEFORE_ENABLE,ALL(r->install_before_enable,
+        visible,ordered(r->identity_visible_at,e,false)));
+    bit(&o->proof,PGWT_DISC_PINNED_BINDING,nw?ALL(pin,r->pointer_continuous,r->permanent_role_proved):pin);
+    bit(&o->proof,PGWT_DISC_ADDRESS_CONTINUOUS,address);
+    bit(&o->proof,PGWT_DISC_PRESERVED_STATE,ALL(r->producer_owned,r->generations_fenced,k->isolated_seed));
+    bit(&o->proof,PGWT_DISC_ENABLED,ALL(r->enable_confirmed,nonzero(e),nonzero(r->attachment_generation)));
+    bit(&o->proof,PGWT_DISC_EMISSION_IDENTITY,ALL(k->emission_identity,r->identity_immutable));
+    bit(&o->proof,PGWT_DISC_FAILURE_ACCOUNTING,accounting(r));
+    bit(&o->proof,PGWT_DISC_BRACKET_ORDER,order);
+    bit(&o->proof,PGWT_DISC_THREAD_HISTORY,ALL(r->single_thread_history,history,
+        r->v0_valid?yesno(r->threads0==1):unknown(),r->v1_valid?yesno(r->threads1==1):unknown()));
+    bit(&o->proof,PGWT_DISC_OWNERSHIP,ALL(r->no_foreign_writer,r->producer_owned,
+        r->single_thread_history,history));
+    bit(&o->proof,PGWT_DISC_CPU_ENROLLED,ALL(r->cpu_enrolled,r->lifecycle_active));
+    bit(&o->proof,PGWT_DISC_FRESH_COHERENT_SEED,ALL(r->seed_valid?yesno(true):unknown(),
+        r->cpu_base_valid?yesno(true):unknown(),
+        observed_equal(r->cpu_base,r->accumulator,r->seed_valid && r->cpu_base_valid),
+        r->seed_valid?yesno(r->on_cpu_ts==0):unknown(),
+        read,k->isolated_seed,k->ordered_operations));
+    bit(&o->proof,PGWT_DISC_RECONCILED,reconciliation);
+    bit(&o->proof,PGWT_DISC_COUNTER_NO_WRAP,ALL(r->voluntary_no_wrap,pin,
+        r->v0_valid?yesno(true):unknown(),r->v1_valid?yesno(true):unknown(),
+        observed_equal(r->v0,r->v1,r->v0_valid && r->v1_valid)));
+    bit(&o->proof,PGWT_DISC_REQUIRED_READS,ALL(read,k->ordered_operations));
+    /* INVENTORIED and STARTUP_OPEN are filled only by the coordinator's
+     * accepted registration and capture gap state; never producer fields. */
+    o->quiet=(pgwt_discovery_witness){.t=r->t,.e=r->e,.wait_word=r->X,
+        .v0=r->v0,.v1=r->v1,.armed_address=r->armed_addr,.resolved_address=r->resolved_addr,
+        .accumulator=r->accumulator,.cpu_base=r->cpu_base,.on_cpu_ts=r->on_cpu_ts,
+        .threads0=r->threads0,.threads1=r->threads1,.S0=inactive(r->S0),.S1=inactive(r->S1),
+        .terminal0=r->terminal0,.terminal1=r->terminal1,.cpu_base_valid=r->cpu_base_valid,
+        .facts=o->proof,.claims_completed_coherence=r->claims_completed_coherence};
+    if(holds(pin) && r->v0_valid && r->v1_valid)
+        o->quiet.handle0=o->quiet.handle1=r->binding_token;
+    bool counts=r->pointer_snapshot_valid && holds(r->failure_accounting) &&
+        r->pointer_fires_after>=r->pointer_fires_before;
+    o->no_word=(pgwt_discovery_no_word){.enable=r->pointer_enabled_ns,
+        .read_at=r->pointer_read_ns,.fence=r->pointer_fence_ns,
+        .pointer=r->pointer_snapshot_valid && holds(r->pointer_null) && !r->pointer_nonnull?0:1,
+        .fires=counts?r->pointer_fires_after-r->pointer_fires_before:UINT64_MAX,
+        .role=r->permanent_role,
+        .permanent_role_qualified=holds(ALL(r->permanent_role_proved,r->address_qualified,
+            r->single_thread_history,history,pin)),
+        .visible_before_enable=holds(ALL(visible,r->install_before_enable,
+            ordered(r->identity_visible_at,r->pointer_enabled_ns,false))),
+        .continuous=holds(r->pointer_continuous),
+        .read_ok=r->pointer_snapshot_valid && holds(r->pointer_null) &&
+            holds(ordered(r->pointer_enabled_ns,r->pointer_read_ns,true)),
+        .completed=holds(ALL(reconciliation,ordered(r->pointer_read_ns,r->pointer_fence_ns,false),
+            ordered(r->pointer_fence_ns,r->reconciliation_ns,false))),
+        .counters_unchanged=counts && holds(accounting(r)),
+        .ownership=pgwt_discovery_has(o->proof,PGWT_DISC_OWNERSHIP),.binding=holds(pin),
+        .claims_completed=r->claims_completed_no_word};
+    if(holds(pin) && r->pointer_snapshot_valid)
+        o->no_word.handle0=o->no_word.handle1=r->binding_token;
+    o->resolution=(pgwt_discovery_resolution){.F0=r->f0_ns,
+        .start=holds(r->start_mono_known)?r->lifetime_start_ns:0,
+        .fence=r->reconciliation_ns,.failed_open=r->failed_open,.gone_at=r->gone_at,
+        .handle=holds(retained_handle(r))?r->binding_token:0,.tid=r->tid,.tgid=r->tgid,
+        .parent=r->parent,.postmaster=r->postmaster,.fork_cookie=r->fork_cookie,
+        .exit_time=r->terminal_ns,.start_known=holds(r->start_mono_known) && r->lifetime_start_ns!=0,
+        .clocks_qualified=holds(either(r->start_mono_known,r->clock_bound)),.namespaces=holds(r->namespaces),
+        .history_complete=holds(history),.producers_complete=holds(r->producers_complete),
+        .counters_unchanged=holds(accounting(r)),.journal_complete=holds(r->journal_complete),
+        .journal_eligible=holds(r->journal_eligible),.gone_esrch=holds(r->gone_esrch),
+        .binding=holds(retained_handle(r)),.claims_match=holds(r->terminal_match)};
+}
+
+struct lifetime {
+    uint64_t pid,cookie,token,start;
+    bool start_known;
+    fact bound;
+    struct pgwt_di_lifetime state;
+    struct pgwt_discovery_attempt retained,final;
+    bool final_valid, confirmation_sent, support_published, revoked;
+    pgwt_discovery_no_word published_support;
+    uint64_t failed_claim_generation;
+    uint32_t failed_claim_attempt;
+    bool failed_claim_seen,failed_claim_no_word;
+    uint64_t physical_attempts[PGWT_DISCOVERY_ATTEMPTS];
+    size_t physical_count;
+};
+struct number { uint64_t pid,failed_open; bool resolved; };
+struct candidate { struct pgwt_discovery_attempt record; };
+struct decoded {
+    struct pgwt_wire_record wire;
+    unsigned char payload[272];
+    uint64_t pid,time,generation;
+    size_t token,next;
+    bool active;
+};
+struct terminal {
+    struct pgwt_di_terminal_observation observed;
+    enum pgwt_di_terminal disposition;
+};
+struct pgwt_discovery_integration {
+    struct pgwt_di_config cfg;
+    struct lifetime *lives;
+    struct number *numbers;
+    struct terminal *terminals;
+    struct candidate *candidates;
+    struct decoded *staged;
+    struct pgwt_discovery_attempt *batch;
+    size_t nlives,nnumbers,nterminals,ncandidates,nstaged,cursor;
+    size_t *stage_heads,*stage_tails,stage_free;
+    uint64_t now,census_invalidated_at,census_invalidated_count;
+    ma_snapshot current;
+    struct pgwt_discovery_checkpoint checkpoint;
+    struct pgwt_di_report report;
+    bool busy,baseline_known,handoff_lost,unknown_delivered,handoff_fault_delivered,deferred_fault;
+};
+static bool complete_snapshot(const ma_snapshot *s)
+{
+    if(!s->valid) return false;
+    for(size_t i=0;i<PGWT_MERGE_COUNTERS;++i) if(!s->component_valid[i]) return false;
+    return true;
+}
+static void sync_lifetime(struct pgwt_discovery_integration *i,struct lifetime *l)
+{
+    pgwt_discovery_state s={0};
+    if(!pgwt_capture_discovery_state(i->cfg.capture,l->pid,l->cookie,&s)) return;
+    l->state.committed=s;
+    uint64_t final_bits=(UINT64_C(1)<<PGWT_DISC_ADMIT)|(UINT64_C(1)<<PGWT_DISC_ABANDON);
+    l->state.acceptance_known|=l->state.attempted_controls&final_bits;
+    if(s.admitted) l->state.accepted_controls|=UINT64_C(1)<<PGWT_DISC_ADMIT;
+    if(s.abandoned) l->state.accepted_controls|=UINT64_C(1)<<PGWT_DISC_ABANDON;
+    if(s.confirmed) {
+        uint64_t b=UINT64_C(1)<<(s.no_wait_word?PGWT_DISC_CONFIRM_NO_WAIT_WORD:PGWT_DISC_CONFIRM);
+        l->state.acceptance_known|=b;l->state.accepted_controls|=b;
+    }
+    if(s.terminal_released) {
+        l->state.acceptance_known|=UINT64_C(1)<<PGWT_DISC_TERMINAL;
+        l->state.accepted_controls|=UINT64_C(1)<<PGWT_DISC_TERMINAL;
+    }
+    if(s.abandoned) l->state.attachment=PGWT_DI_ABANDONED;
+    else if(s.admitted) l->state.attachment=s.no_wait_word?PGWT_DI_ADMITTED_NO_WORD:PGWT_DI_ADMITTED_NUMERICAL;
+    if(s.has_lower_bound) l->state.coverage=PGWT_DI_BOUND_COMMITTED;
+    else if(s.terminal_released && l->state.coverage!=PGWT_DI_REVOKED_PENDING)
+        l->state.coverage=PGWT_DI_TERMINAL_COMMITTED;
+}
+static bool snapshot(struct pgwt_discovery_integration *i)
+{
+    struct pgwt_di_observation o={.detected=i->now};
+    int rc=i->cfg.ops.counters?i->cfg.ops.counters(i->cfg.ops.ctx,&o):-ENOSYS;
+    if(rc || o.detected<i->now) {
+        i->report.last_error=rc?diagnostic_errno(rc):EINVAL;
+        ++i->report.outcomes[rc?PGWT_DI_REQUIRED_FAILURE:PGWT_DI_CONTRADICTION];
+        i->current=o.counters; i->current.valid=false;
+        i->report.incomplete=i->report.certification_blocked=true;
+        return false;
+    }
+    i->now=o.detected;i->current=o.counters;
+    return complete_snapshot(&o.counters);
+}
+static bool fault(struct pgwt_discovery_integration *i,pgwt_merge_reason reason)
+{
+    if(i->report.unclean || pgwt_capture_report(i->cfg.capture).status==PGWT_MERGE_EXIT_REQUIRED) {
+        i->report.unclean=i->report.incomplete=i->report.certification_blocked=true;return false;
+    }
+    snapshot(i);
+    int rc=pgwt_capture_fault(i->cfg.capture,reason,i->now,&i->current);
+    i->current=pgwt_capture_last_snapshot(i->cfg.capture);
+    i->report.incomplete=true;
+    pgwt_merge_report observed=pgwt_capture_report(i->cfg.capture);
+    if(observed.void_failed)++i->report.outcomes[PGWT_DI_FAULT_REJECTED];
+    if(rc<0 || observed.void_failed || observed.status==PGWT_MERGE_EXIT_REQUIRED) {
+        i->report.unclean=i->report.certification_blocked=true;
+        if(observed.void_failed || !i->report.last_error)i->report.last_error=rc<0?diagnostic_errno(rc):EIO;
+        return false;
+    }
+    return true;
+}
+static void refused_reentry(struct pgwt_discovery_integration *i)
+{
+    ++i->report.outcomes[PGWT_DI_CONTRADICTION];i->report.last_error=EDEADLK;
+    i->report.incomplete=i->report.certification_blocked=i->deferred_fault=true;
+}
+static void deferred_fault(struct pgwt_discovery_integration *i)
+{if(i->deferred_fault){i->deferred_fault=false;(void)fault(i,PGWT_MERGE_UNKNOWN_EVIDENCE);}}
+void pgwt_di_operation_result(struct pgwt_discovery_integration *i,enum pgwt_di_operation op,
+                               int error,uint64_t now)
+{
+    if(!i) return;
+    i->now=now;
+    if((unsigned)op>=PGWT_DI_OPERATION_COUNT) op=PGWT_DI_UNCLASSIFIED;
+    ++i->report.outcomes[op];
+    if(error) i->report.last_error=diagnostic_errno(error);
+    switch(op) {
+    case PGWT_DI_OPTIONAL_REJECTION: case PGWT_DI_TRANSIENT:
+    case PGWT_DI_SUPPORT_UNAVAILABLE: return;
+    case PGWT_DI_DEADLINE: i->report.incomplete=true; return;
+    case PGWT_DI_PERMANENT:
+        i->report.permanent_failure=i->report.incomplete=i->report.certification_blocked=true;
+        if(!i->report.attempts_stopped && i->cfg.ops.stop_attempts)
+            i->cfg.ops.stop_attempts(i->cfg.ops.ctx);
+        return;
+    case PGWT_DI_CAPACITY:
+        i->report.tracking_failed=i->report.certification_blocked=true;
+        (void)fault(i,PGWT_MERGE_ALLOCATION_FAIL); return;
+    case PGWT_DI_WRITER: case PGWT_DI_SUPPORT_REJECTED:
+        i->report.certification_blocked=true;
+        (void)fault(i,PGWT_MERGE_WRITER_PUSH_FAIL); return;
+    case PGWT_DI_TRANSPORT:
+        (void)fault(i,PGWT_MERGE_MALFORMED_ENVELOPE); return;
+    case PGWT_DI_FAULT_REJECTED:
+        i->report.unclean=i->report.incomplete=i->report.certification_blocked=true;return;
+    default: (void)fault(i,PGWT_MERGE_UNKNOWN_EVIDENCE); return;
+    }
+}
+void pgwt_di_transport_fault(struct pgwt_discovery_integration *i,pgwt_merge_reason reason,
+                              int error,uint64_t now)
+{
+    if(!i) return;
+    i->now=now;i->report.last_error=diagnostic_errno(error);
+    ++i->report.outcomes[PGWT_DI_TRANSPORT];
+    if((unsigned)reason>=PGWT_MERGE_REASON_COUNT)reason=PGWT_MERGE_UNKNOWN_EVIDENCE;
+    (void)fault(i,reason);
+}
+static void result(struct pgwt_discovery_integration *i,int rc)
+{
+    i->current=pgwt_capture_last_snapshot(i->cfg.capture);
+    pgwt_merge_report before=pgwt_capture_report(i->cfg.capture);
+    if(rc<0 && (before.status==PGWT_MERGE_EXIT_REQUIRED || before.void_failed)) {
+        i->report.unclean=i->report.incomplete=i->report.certification_blocked=true;
+        i->report.last_error=diagnostic_errno(rc);
+        if(before.void_failed)++i->report.outcomes[PGWT_DI_FAULT_REJECTED];
+    } else if(rc<0) pgwt_di_operation_result(i,rc==-ENOMEM?PGWT_DI_CAPACITY:
+        rc==-EIO?PGWT_DI_WRITER:PGWT_DI_UNCLASSIFIED,rc,i->now);
+    pgwt_merge_report r=pgwt_capture_report(i->cfg.capture);
+    if(r.status!=PGWT_MERGE_OK) i->report.incomplete=true;
+    if(r.void_failed) i->report.unclean=i->report.certification_blocked=true;
+    deferred_fault(i);
+}
+static struct lifetime *find(struct pgwt_discovery_integration *i,uint64_t pid,uint64_t cookie)
+{
+    for(size_t n=0;n<i->nlives;++n) if(i->lives[n].pid==pid && i->lives[n].cookie==cookie) return &i->lives[n];
+    return NULL;
+}
+static struct number *number(struct pgwt_discovery_integration *i,uint64_t pid)
+{
+    for(size_t n=0;n<i->nnumbers;++n) if(i->numbers[n].pid==pid) return &i->numbers[n];
+    return NULL;
+}
+static bool cut_covered(const struct pgwt_discovery_checkpoint *p,const struct pgwt_discovery_attempt *r)
+{
+    return r->reconciliation_ns && r->reconciliation_count &&
+        r->reconciliation_ns<=p->reconciliation_ns && r->reconciliation_count<=p->reconciliation_count &&
+        (r->reconciliation_count!=p->reconciliation_count || r->reconciliation_ns==p->reconciliation_ns);
+}
+static bool current_agrees(const struct pgwt_discovery_integration *i,
+                            const struct pgwt_discovery_attempt *r,bool lifecycle)
+{
+    if(!complete_snapshot(&i->current)) return false;
+    for(size_t n=0;n<PGWT_MERGE_COUNTERS;++n) {
+        if(lifecycle && n!=0 && n!=1 && n!=2 && n!=10) continue;
+        if(!r->counters_after.components[n].valid ||
+            r->counters_after.components[n].value!=i->current.value[n]) return false;
+    }
+    return true;
+}
+static bool reliable(struct pgwt_discovery_integration *i,const struct pgwt_discovery_attempt *r)
+{
+    return r->f0_ns==i->cfg.f0 && r->reconciliation==PGWT_DREC_COMPLETE && r->reconciliation_ns && r->reconciliation_count &&
+        i->checkpoint.reconciliation==PGWT_DREC_COMPLETE &&
+        cut_covered(&i->checkpoint,r) &&
+        holds(ALL(r->namespaces,r->history_complete,r->producers_complete,
+            r->journal_complete,accounting(r))) && r->handoff_complete &&
+        i->checkpoint.handoff_complete && i->checkpoint.evidence_counts_known &&
+        !i->report.tracking_failed && !i->handoff_lost && current_agrees(i,r,false);
+}
+static bool preexisting_r(struct pgwt_discovery_integration *i,const struct pgwt_discovery_attempt *r)
+{
+    return reliable(i,r) && holds(preexisting(r)) && holds(binding(r)) &&
+        r->journal_eligible.known && !r->journal_eligible.value &&
+        r->tid && r->tgid && r->parent && r->postmaster &&
+        r->tid==r->tgid && r->tgid==r->pid && r->parent==r->postmaster;
+}
+static bool retain_identity(struct pgwt_discovery_integration *i,struct lifetime *l,
+                              const struct pgwt_discovery_attempt *r)
+{
+    bool exact=holds(r->start_mono_known) && r->lifetime_start_ns;
+    if((l->token && r->binding_token && l->token!=r->binding_token) ||
+        (l->start_known && exact && l->start!=r->lifetime_start_ns)) {
+        pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);return false;
+    }
+    if(r->binding_token)l->token=r->binding_token;
+    if(exact){l->start=r->lifetime_start_ns;l->start_known=true;}
+    fact b=binding(r);
+    if(!(l->bound.known && !l->bound.value) && b.known)l->bound=b;
+    l->retained=*r;
+    if(l->start_known){l->retained.lifetime_start_ns=l->start;l->retained.start_mono_known=yesno(true);}
+    return true;
+}
+static struct lifetime *inventory(struct pgwt_discovery_integration *i,const struct pgwt_discovery_attempt *r,
+                                  bool journal)
+{
+    if(i->report.unclean) return NULL;
+    struct lifetime *l=find(i,r->pid,r->cookie);
+    if(l) {
+        if(!retain_identity(i,l,r))return NULL;
+        if(l->state.registered && l->start_known)
+            result(i,pgwt_capture_discovery_start_identity(i->cfg.capture,l->pid,l->cookie,l->start));
+        return l;
+    }
+    if(!r->pid) return NULL;
+    if(!r->cookie) {pgwt_di_operation_result(i,PGWT_DI_CAPACITY,ENOSPC,i->now);return NULL;}
+    if(r->cookie<PGWT_DISCOVERY_COOKIE_MIN) {
+        pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);return NULL;
+    }
+    struct number *q=number(i,r->pid);
+    if(q && !q->resolved && !journal && !preexisting_r(i,r)) return NULL;
+    if(i->nlives==i->cfg.capacity) {
+        pgwt_di_operation_result(i,PGWT_DI_CAPACITY,ENOMEM,i->now); return NULL;
+    }
+    l=&i->lives[i->nlives++];
+    l->pid=r->pid;l->cookie=r->cookie;
+    if(!retain_identity(i,l,r))return NULL;
+    size_t before_numeric=pgwt_capture_discovery_status(i->cfg.capture).unresolved_numeric;
+    int rc=pgwt_capture_discovery_inventory(i->cfg.capture,r->pid,r->cookie);
+    result(i,rc);
+    l->state.registered=rc==0;
+    if(rc) return l;
+    if(q && pgwt_capture_discovery_status(i->cfg.capture).unresolved_numeric<before_numeric) q->resolved=true;
+    if(holds(r->start_mono_known) && r->lifetime_start_ns)
+        result(i,pgwt_capture_discovery_start_identity(i->cfg.capture,r->pid,r->cookie,r->lifetime_start_ns));
+    return l;
+}
+static void installed(struct pgwt_discovery_integration *i,struct lifetime *l,
+                       const struct pgwt_discovery_attempt *r)
+{
+    if(!l || !l->state.registered || i->report.unclean) return;
+    if(!retain_identity(i,l,r) || l->state.installed)return;
+    struct pgwt_di_translation t;pgwt_di_translate(r,&i->cfg.construction,&t);
+    if(!pgwt_discovery_has(t.proof,PGWT_DISC_IDENTITY_VISIBLE|PGWT_DISC_EMISSION_IDENTITY)) return;
+    int rc=pgwt_capture_discovery_installed(i->cfg.capture,l->pid,l->cookie,t.proof);
+    result(i,rc);
+    if(!rc) {l->state.installed=true;l->state.attachment=PGWT_DI_INSTALLED_PENDING;}
+}
+static bool deliver(struct pgwt_discovery_integration *i,struct lifetime *l,pgwt_discovery_attempt *a)
+{
+    if(!l || !l->state.registered || i->report.unclean) return false;
+    uint64_t b=UINT64_C(1)<<a->kind;
+    l->state.attempted_controls|=b;
+    if(i->cfg.ops.control_attempted) i->cfg.ops.control_attempted(i->cfg.ops.ctx,a);
+    deferred_fault(i);
+    snapshot(i);
+    int rc=pgwt_capture_discovery_control(i->cfg.capture,a,i->now,&i->current);
+    if(!rc) l->state.delivered_controls|=b;
+    result(i,rc);sync_lifetime(i,l);return rc==0;
+}
+static bool no_word_valid(const pgwt_discovery_no_word *w)
+{
+    return w->enable && w->read_at>w->enable && w->fence>=w->read_at && !w->pointer &&
+        !w->fires && w->handle0 && w->handle0==w->handle1 && w->role &&
+        w->permanent_role_qualified && w->visible_before_enable && w->continuous &&
+        w->read_ok && w->completed && w->counters_unchanged && w->ownership && w->binding;
+}
+static bool quiet_valid(const pgwt_discovery_witness *w)
+{
+    return w->t && w->e>=w->t && w->S0==PGWT_DISC_INACTIVE_SYSCALL && w->S1==PGWT_DISC_INACTIVE_SYSCALL &&
+        w->v0==w->v1 && w->threads0==1 && w->threads1==1 && !w->terminal0 && !w->terminal1 &&
+        w->handle0 && w->handle0==w->handle1 && w->armed_address && w->armed_address==w->resolved_address &&
+        w->cpu_base_valid && w->cpu_base==w->accumulator && !w->on_cpu_ts &&
+        pgwt_discovery_has(w->facts,PGWT_DISC_QUIET_FACTS);
+}
+static void revoke(struct pgwt_discovery_integration *i,struct lifetime *l)
+{
+    sync_lifetime(i,l);
+    if(l->revoked || !l->state.committed.no_wait_word || !l->state.committed.has_lower_bound) return;
+    l->revoked=true;l->state.coverage=PGWT_DI_REVOKED_PENDING;
+    i->census_invalidated_at=i->now;
+    i->census_invalidated_count=i->checkpoint.reconciliation_count;
+    snapshot(i);
+    int rc=i->cfg.ops.revoke?i->cfg.ops.revoke(i->cfg.ops.ctx,i->cfg.variant,i->cfg.f0,
+        l->pid,l->cookie,i->now,&i->current):-ENOSYS;
+    if(rc) pgwt_di_operation_result(i,PGWT_DI_WRITER,rc,i->now);
+    /* The contradiction must still reach capture when durable revocation
+     * failed. Certification stays blocked; do not acknowledge durability. */
+}
+static void pointer_record(struct pgwt_discovery_integration *i,struct lifetime *l,
+                            const struct pgwt_discovery_attempt *r)
+{
+    if(!l) return;
+    bool nonnull=r->pointer_snapshot_valid && r->pointer_nonnull;
+    bool broken=r->pointer_continuous.known && !r->pointer_continuous.value;
+    l->state.sticky_nonnull|=nonnull;l->state.sticky_break|=broken;
+    if(nonnull || broken) revoke(i,l);
+    /* Core's Boolean continuity cannot represent unknown. An unknown-only
+     * observation stays here; a proved non-NULL read is independently useful. */
+    if(!r->pointer_continuous.known && !nonnull) return;
+    pgwt_discovery_attempt a={.kind=PGWT_DISC_POINTER,.pid=l->pid,.cookie=l->cookie,
+        .pointer_read_ok=r->pointer_snapshot_valid,.pointer_value=nonnull,
+        .pointer_time=0,.pointer_continuous=!broken};
+    deliver(i,l,&a);
+}
+static void negative_checkpoint(struct pgwt_discovery_integration *,const struct pgwt_discovery_checkpoint *);
+static bool acceptance_gate(struct pgwt_discovery_integration *i,struct lifetime *l)
+{
+    if(i->cfg.ops.checkpoint) {
+        struct pgwt_discovery_checkpoint p={0};i->cfg.ops.checkpoint(i->cfg.ops.ctx,&p);
+        negative_checkpoint(i,&p);
+    }
+    if(i->cfg.ops.binding && l->token) {
+        struct pgwt_discovery_binding_snapshot b={0};
+        if(i->cfg.ops.binding(i->cfg.ops.ctx,l->token,&b)) {
+            if(b.inventory.pid!=l->pid || b.inventory.cookie!=l->cookie || b.inventory.binding_token!=l->token) {
+                pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);return false;
+            }
+            if(!retain_identity(i,l,&b.inventory))return false;
+            pointer_record(i,l,&b.inventory);
+        }
+    }
+    if(i->cfg.ops.next) {
+        struct pgwt_discovery_attempt pending={0};size_t probe=i->cursor;
+        if(i->cfg.ops.next(i->cfg.ops.ctx,&probe,&pending)) return false;
+    }
+    return !i->report.certification_blocked && !l->state.sticky_nonnull && !l->state.sticky_break;
+}
+static void final_attachment(struct pgwt_discovery_integration *i,struct lifetime *l,
+                              const struct pgwt_discovery_attempt *r,bool nw)
+{
+    if(!l || !l->state.installed || i->report.unclean) return;
+    sync_lifetime(i,l);
+    if(l->state.committed.abandoned || l->state.coverage==PGWT_DI_REVOKED_PENDING) return;
+    bool watched_null=!nw && l->state.committed.pointer_watched && !l->state.sticky_nonnull;
+    struct pgwt_di_translation t;pgwt_di_translate(r,&i->cfg.construction,&t);
+    bool quiet=quiet_valid(&t.quiet);
+    if((!nw && r->claims_completed_coherence && (!quiet || watched_null)) ||
+        (nw && r->claims_completed_no_word &&
+         (!no_word_valid(&t.no_word) || (!l->state.committed.admitted &&
+            (l->state.sticky_nonnull || l->state.sticky_break))))) {
+        if(!l->failed_claim_seen || l->failed_claim_generation!=r->attachment_generation ||
+            l->failed_claim_attempt!=r->attempt || l->failed_claim_no_word!=nw) {
+            pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);
+            l->failed_claim_seen=true;l->failed_claim_generation=r->attachment_generation;
+            l->failed_claim_attempt=r->attempt;l->failed_claim_no_word=nw;
+        }
+        return;
+    }
+    if(watched_null) return;
+    if(!l->state.committed.admitted) {
+        if(!r->final_attachment || !r->attempts_ended || !r->attachment_generation ||
+            !pgwt_discovery_has(t.proof,PGWT_DISC_ADMISSION_FACTS) ||
+            (nw && (!no_word_valid(&t.no_word) || l->state.sticky_nonnull || l->state.sticky_break))) return;
+        pgwt_discovery_attempt a={.kind=PGWT_DISC_ADMIT,.pid=l->pid,.cookie=l->cookie,
+            .attachment_generation=r->attachment_generation,.e=nw?r->pointer_enabled_ns:r->e,
+            .proof=t.proof,.route=nw?PGWT_DISC_NO_WAIT_WORD:PGWT_DISC_NUMERICAL,.no_word=t.no_word};
+        deliver(i,l,&a);
+    }
+    if(!l->state.committed.admitted || l->confirmation_sent || i->report.certification_blocked) return;
+    if(nw && (l->state.sticky_nonnull || l->state.sticky_break)) return;
+    if(nw) {
+        if(!no_word_valid(&t.no_word)) {
+            if(r->claims_completed_no_word) pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);
+            return;
+        }
+        if(i->cfg.variant==PGWT_DI_CHECKED_SUPPORT && !l->support_published) {
+            if(!i->cfg.ops.support) {
+                pgwt_di_operation_result(i,PGWT_DI_SUPPORT_UNAVAILABLE,ENOSYS,i->now);return;
+            }
+            snapshot(i);
+            int rc=i->cfg.ops.support(i->cfg.ops.ctx,l->pid,l->cookie,&t.no_word,&i->current);
+            if(rc) {pgwt_di_operation_result(i,PGWT_DI_SUPPORT_REJECTED,rc,i->now);return;}
+            l->support_published=true;l->published_support=t.no_word;
+        }
+    } else if(!quiet) return;
+    if(nw && !acceptance_gate(i,l)) return;
+    pgwt_discovery_attempt a={.kind=nw?PGWT_DISC_CONFIRM_NO_WAIT_WORD:PGWT_DISC_CONFIRM,
+        .pid=l->pid,.cookie=l->cookie,.attachment_generation=r->attachment_generation,
+        .witness=t.quiet,.no_word=t.no_word};
+    deliver(i,l,&a);l->confirmation_sent=true;
+}
+bool pgwt_di_publish_support(struct pgwt_discovery_integration *i,uint64_t pid,uint64_t cookie,
+                              const pgwt_discovery_no_word *w,pgwt_merge_observation *post)
+{
+    if(!i || !w || !post) return false;
+    struct lifetime *l=find(i,pid,cookie);
+    if(l)sync_lifetime(i,l);
+    bool ok=l && l->state.committed.admitted && l->state.committed.no_wait_word &&
+        !l->revoked && !i->report.certification_blocked && no_word_valid(w);
+    if(ok && i->cfg.variant==PGWT_DI_CHECKED_SUPPORT) {
+        const pgwt_discovery_no_word *p=&l->published_support;
+        ok=l->support_published && p->enable==w->enable && p->read_at==w->read_at && p->fence==w->fence &&
+            p->pointer==w->pointer && p->fires==w->fires && p->handle0==w->handle0 && p->handle1==w->handle1 &&
+            p->role==w->role && p->permanent_role_qualified==w->permanent_role_qualified &&
+            p->visible_before_enable==w->visible_before_enable && p->continuous==w->continuous &&
+            p->read_ok==w->read_ok && p->completed==w->completed && p->counters_unchanged==w->counters_unchanged &&
+            p->ownership==w->ownership && p->binding==w->binding;
+    }
+    snapshot(i);post->d=i->now;post->counters.known=complete_snapshot(&i->current);
+    for(size_t n=0;n<PGWT_MERGE_COUNTERS;++n)post->counters.value[n]=i->current.value[n];
+    if(!ok) {
+        ++i->report.outcomes[PGWT_DI_SUPPORT_REJECTED];i->report.last_error=EINVAL;
+        i->report.incomplete=i->report.certification_blocked=true;
+    }
+    return ok;
+}
+static void end_attempts(struct pgwt_discovery_integration *i,struct lifetime *l)
+{
+    if(!l) return;
+    l->state.attempts_ended=true;
+    if(l->final_valid) final_attachment(i,l,&l->final,l->final.no_wait_word || l->final.kind==PGWT_DH_NO_WORD);
+    sync_lifetime(i,l);
+    if(l->state.committed.admitted || l->state.committed.abandoned || !l->state.installed ||
+        !holds(l->bound) || pgwt_capture_discovery_status(i->cfg.capture).closed) return;
+    pgwt_discovery_attempt a={.kind=PGWT_DISC_ABANDON,.pid=l->pid,.cookie=l->cookie};
+    deliver(i,l,&a);
+}
+static bool terminal_shape(struct pgwt_discovery_integration *i,const struct pgwt_di_terminal_observation *o)
+{
+    return o->destination==PGWT_WIRE_DEST_L && o->source==i->cfg.cpu_count+1 &&
+        o->sequence && o->position && o->pid && o->time;
+}
+void pgwt_di_terminal_received(struct pgwt_discovery_integration *i,
+                                const struct pgwt_di_terminal_observation *o,uint64_t now)
+{
+    if(!i || !o) return;
+    i->now=now;
+    if(!terminal_shape(i,o)) {pgwt_di_operation_result(i,PGWT_DI_TRANSPORT,EINVAL,now);return;}
+    for(size_t n=0;n<i->nterminals;++n) {
+        struct pgwt_di_terminal_observation *p=&i->terminals[n].observed;
+        bool transport=p->cpu==o->cpu && p->destination==o->destination && p->sequence==o->sequence;
+        bool position=p->source==o->source && p->position==o->position;
+        if(!transport && !position) continue;
+        if(!transport || !position || p->pid!=o->pid || p->cookie!=o->cookie || p->time!=o->time)
+            pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,now);
+        else if(!p->inventory_cookie)p->inventory_cookie=o->inventory_cookie;
+        else if(o->inventory_cookie && p->inventory_cookie!=o->inventory_cookie)p->inventory_cookie=0;
+        return;
+    }
+    if(i->nterminals==i->cfg.capacity) {pgwt_di_operation_result(i,PGWT_DI_CAPACITY,ENOMEM,now);return;}
+    i->terminals[i->nterminals++]=(struct terminal){.observed=*o};
+}
+static struct terminal *terminal_find(struct pgwt_discovery_integration *i,
+                                       const struct pgwt_di_terminal_observation *o)
+{
+    for(size_t n=0;n<i->nterminals;++n) {
+        struct terminal *t=&i->terminals[n];
+        if(t->observed.cpu==o->cpu && t->observed.destination==o->destination &&
+            t->observed.sequence==o->sequence) return t;
+    }
+    return NULL;
+}
+static bool join(struct pgwt_discovery_integration *i,const struct pgwt_discovery_attempt *r,
+                   pgwt_discovery_attempt *a)
+{
+    if(!r->terminal_transport_known || !i->cfg.ops.terminal_join) return false;
+    struct pgwt_di_terminal_observation o={0};
+    enum pgwt_di_join j=i->cfg.ops.terminal_join(i->cfg.ops.ctx,r,&o);
+    if(j==PGWT_DI_JOIN_PENDING) return false;
+    if(j!=PGWT_DI_JOIN_UNIQUE || !terminal_shape(i,&o) || o.cpu!=r->terminal_cpu ||
+        o.destination!=r->terminal_dest || o.sequence!=r->terminal_seq || o.pid!=r->pid ||
+        (o.cookie && o.cookie!=r->cookie)) {
+        pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);return false;
+    }
+    struct terminal *t=terminal_find(i,&o);
+    if(t && t->disposition==PGWT_DI_UNRESOLVED) {
+        pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);return false;
+    }
+    if(!t) {pgwt_di_terminal_received(i,&o,i->now);t=terminal_find(i,&o);}
+    if(!t) return false;
+    if(t->observed.source!=o.source || t->observed.position!=o.position ||
+        t->observed.time!=o.time || t->observed.pid!=o.pid || t->observed.cookie!=o.cookie) {
+        pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);return false;
+    }
+    a->names_exit=true;a->exit_source=o.source;a->exit_position=o.position;
+    a->terminal_time=o.time; /* preserve resolution.exit_time independently */
+    return true;
+}
+static void terminal_disposition(struct pgwt_discovery_integration *i,struct lifetime *l,
+                                  pgwt_discovery_attempt *a)
+{
+    if(!l) return;
+    for(size_t n=0;n<i->nterminals;++n) {
+        struct terminal *t=&i->terminals[n];
+        if(t->observed.source!=a->exit_source || t->observed.position!=a->exit_position) continue;
+        enum pgwt_di_terminal next=a->kind==PGWT_DISC_TERMINAL_UNRESOLVED?PGWT_DI_UNRESOLVED:PGWT_DI_MATCHED;
+        if(t->disposition!=PGWT_DI_UNDECIDED) {
+            if(t->disposition!=next) pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);
+            return;
+        }
+        bool delivered=deliver(i,l,a);
+        /* A successful API call can carry a merge refusal. Do not call that
+         * discharge. Disposition is retained separately from committed state. */
+        if(delivered) t->disposition=next;
+        return;
+    }
+}
+static bool terminal_proof(struct pgwt_discovery_integration *i,const struct pgwt_discovery_attempt *r,
+                            const struct pgwt_di_translation *t)
+{
+    const pgwt_discovery_resolution *p=&t->resolution;
+    bool past_cut=r->f0_ns==i->cfg.f0 && cut_covered(&i->checkpoint,r);
+    return past_cut && r->reconciliation==PGWT_DREC_COMPLETE &&
+        p->namespaces && p->clocks_qualified && p->start_known && p->history_complete &&
+        p->producers_complete && p->counters_unchanged && p->journal_complete &&
+        p->claims_match && p->tid==p->tgid && p->tgid==r->pid && p->parent && p->parent==p->postmaster &&
+        p->start<p->F0 && !p->fork_cookie && holds(r->no_observed_fork) &&
+        (!r->terminal_cookie || r->terminal_cookie==r->cookie) && r->terminal_start_ns==p->start && r->terminal_ns;
+}
+static void resolve(struct pgwt_discovery_integration *i,const struct pgwt_discovery_attempt *r)
+{
+    struct number *q=number(i,r->pid);
+    if(i->report.unclean || !q || !reliable(i,r)) return;
+    struct pgwt_di_translation t;pgwt_di_translate(r,&i->cfg.construction,&t);
+    pgwt_discovery_attempt a={.pid=r->pid,.cookie=r->cookie,.resolution=t.resolution,.proof=t.proof};
+    if(holds(r->journal_eligible)) {
+        if(!terminal_proof(i,r,&t) || !join(i,r,&a)) return;
+        struct lifetime *l=inventory(i,r,true);
+        if(!l || !l->state.registered) return;
+        a.kind=PGWT_DISC_JOURNAL;
+        snapshot(i);
+        if(i->cfg.ops.control_attempted) i->cfg.ops.control_attempted(i->cfg.ops.ctx,&a);
+        size_t before_numeric=pgwt_capture_discovery_status(i->cfg.capture).unresolved_numeric;
+        int rc=pgwt_capture_discovery_control(i->cfg.capture,&a,i->now,&i->current);
+        result(i,rc);
+        if(!rc && pgwt_capture_discovery_status(i->cfg.capture).unresolved_numeric<before_numeric) q->resolved=true;
+        sync_lifetime(i,l);
+        if(r->terminal_ns!=a.terminal_time) return;
+        a.kind=PGWT_DISC_TERMINAL;a.terminal_binding_proved=true;
+        terminal_disposition(i,l,&a);
+        return;
+    }
+    if(q->resolved) return;
+    for(size_t n=0;n<i->ncandidates;++n) {
+        const struct pgwt_discovery_attempt *j=&i->candidates[n].record;
+        if(j->kind==PGWT_DH_RESOLUTION && j->pid==r->pid && holds(j->journal_eligible)) return;
+    }
+    if(!r->journal_eligible.known) return; /* exhausted J precedence is positive evidence */
+    if(r->numeric_resolution==PGWT_DISC_NUM_R) {
+        if(preexisting_r(i,r)) {
+            struct lifetime *l=inventory(i,r,false);installed(i,l,r);
+            return;
+        }
+        if(!r->tid || !r->tgid || !r->parent || !r->postmaster || !holds(retained_handle(r))) return;
+        pgwt_discovery_exit_class c=ma_discovery_exit(&t.resolution);
+        if(c!=PGWT_DISC_EXIT_FORK && c!=PGWT_DISC_EXIT_NONMEMBER) return;
+        a.kind=PGWT_DISC_REBIND;
+    } else if(r->numeric_resolution==PGWT_DISC_NUM_G) {
+        if(!holds(r->gone_esrch) || !q->failed_open || r->gone_at<=q->failed_open ||
+            !r->reconciliation_ns || r->reconciliation_ns<r->gone_at) return;
+        a.kind=PGWT_DISC_GONE;a.cookie=0;
+    } else return;
+    snapshot(i);
+    if(i->cfg.ops.control_attempted) i->cfg.ops.control_attempted(i->cfg.ops.ctx,&a);
+    size_t before_numeric=pgwt_capture_discovery_status(i->cfg.capture).unresolved_numeric;
+    int rc=pgwt_capture_discovery_control(i->cfg.capture,&a,i->now,&i->current);
+    result(i,rc);
+    if(!rc && pgwt_capture_discovery_status(i->cfg.capture).unresolved_numeric<before_numeric) q->resolved=true;
+}
+static void terminal_record(struct pgwt_discovery_integration *i,const struct pgwt_discovery_attempt *r)
+{
+    struct lifetime *l=find(i,r->pid,r->cookie);
+    if(!l || !l->state.registered) return;
+    struct pgwt_di_translation t;pgwt_di_translate(r,&i->cfg.construction,&t);
+    if(!terminal_proof(i,r,&t)) return;
+    if(l->start_known && l->start!=r->lifetime_start_ns) {
+        pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);return;
+    }
+    pgwt_discovery_attempt a={.kind=PGWT_DISC_TERMINAL,.pid=l->pid,.cookie=l->cookie,
+        .terminal_binding_proved=true,.resolution=t.resolution};
+    if(!join(i,r,&a)) return;
+    if(a.terminal_time!=r->terminal_ns) {pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);return;}
+    terminal_disposition(i,l,&a);
+}
+static void finalize_terminals(struct pgwt_discovery_integration *i)
+{
+    for(size_t n=0;n<i->nterminals;++n) {
+        struct terminal *t=&i->terminals[n];
+        const struct pgwt_di_terminal_observation *o=&t->observed;
+        if(t->disposition!=PGWT_DI_UNDECIDED ||
+            (!i->report.permanent_failure &&
+             (i->checkpoint.reconciliation!=PGWT_DREC_COMPLETE || i->checkpoint.reconciliation_ns<o->time))) continue;
+        struct lifetime *l=find(i,o->pid,o->inventory_cookie);
+        if(!l && !o->inventory_cookie) {
+            /* An unresolved disposition claims no lifetime match. Name one
+             * existing reserved obligation deterministically, even if the
+             * retained evidence cannot distinguish several reused lifetimes. */
+            for(size_t k=0;k<i->nlives;++k)
+                if(i->lives[k].pid==o->pid && i->lives[k].state.registered &&
+                    (!l || i->lives[k].cookie<l->cookie)) l=&i->lives[k];
+        }
+        if(!l) {
+            /* Numeric observations reserve no cookie. The frozen capture
+             * API cannot name their held EXIT as unresolved without inventing
+             * an inventory identity. Preserve the obligation and report it. */
+            if(i->report.permanent_failure && number(i,o->pid))
+                i->report.terminal_finalisation_incomplete=i->report.incomplete=true;
+            continue;
+        }
+        pgwt_discovery_attempt a={.kind=PGWT_DISC_TERMINAL_UNRESOLVED,.pid=l->pid,.cookie=l->cookie,
+            .names_exit=true,.exit_source=o->source,.exit_position=o->position,.terminal_time=o->time};
+        terminal_disposition(i,l,&a);
+    }
+}
+static bool tag_valid(const struct pgwt_discovery_attempt *r)
+{
+    return r->kind>=PGWT_DH_CENSUS && r->kind<=PGWT_DH_FAULT &&
+        (!r->census_record || r->kind==PGWT_DH_CENSUS) &&
+        (!r->numeric_record || r->kind==PGWT_DH_NUMERIC || r->kind==PGWT_DH_RESOLUTION) &&
+        (!r->no_wait_word || r->kind==PGWT_DH_NO_WORD || r->kind==PGWT_DH_POINTER ||
+            r->kind==PGWT_DH_FAULT || r->kind==PGWT_DH_END) &&
+        (r->kind!=PGWT_DH_CENSUS || (!r->pid && !r->cookie)) &&
+        (r->kind!=PGWT_DH_NUMERIC || (!r->cookie && r->pid));
+}
+static void process(struct pgwt_discovery_integration *i,const struct pgwt_discovery_attempt *r)
+{
+    struct lifetime *l=find(i,r->pid,r->cookie);
+    if(r->kind!=PGWT_DH_FAULT && r->error>0) {
+        enum pgwt_di_operation op=(r->kind==PGWT_DH_NUMERIC || r->evidence_fault)?
+            PGWT_DI_REQUIRED_FAILURE:PGWT_DI_OPTIONAL_REJECTION;
+        pgwt_di_operation_result(i,op,r->error,i->now);
+    } else if(r->kind!=PGWT_DH_FAULT && r->error<0) pgwt_di_operation_result(i,PGWT_DI_UNCLASSIFIED,r->error,i->now);
+    switch(r->kind) {
+    case PGWT_DH_RESOLUTION: resolve(i,r);break;
+    case PGWT_DH_ATTEMPT:
+        if(!l || !l->state.installed) break;
+        sync_lifetime(i,l);
+        if(l->state.attempts_ended && !r->attempts_ended) break;
+        if(l->state.committed.abandoned) {
+            if(r->final_attachment || r->claims_completed_coherence)
+                pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);
+            break;
+        }
+        if(l->state.committed.admitted) {
+            if(r->attachment_generation==l->state.committed.attachment_generation &&
+                r->e==l->state.committed.baseline.e) final_attachment(i,l,r,false);
+            else pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);
+            break;
+        }
+        if(l->state.committed.pointer_watched && !l->state.sticky_nonnull) {
+            if(r->claims_completed_coherence)final_attachment(i,l,r,false);
+            break;
+        }
+        if(!r->attempt || r->attempt>PGWT_DISCOVERY_ATTEMPTS ||
+            (r->maximum_attempts && (r->maximum_attempts>PGWT_DISCOVERY_ATTEMPTS || r->attempt>r->maximum_attempts)) ||
+            (l->state.maximum_attempts_known && r->maximum_attempts && l->state.maximum_attempts!=r->maximum_attempts)) {
+            pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);break;
+        }
+        if(r->maximum_attempts){l->state.maximum_attempts=r->maximum_attempts;l->state.maximum_attempts_known=true;}
+        {
+            bool duplicate=false;
+            for(size_t n=0;n<l->physical_count;++n) if(l->physical_attempts[n]==r->attempt) duplicate=true;
+            if(!duplicate) {
+                if(l->physical_count==PGWT_DISCOVERY_ATTEMPTS) {pgwt_di_operation_result(i,PGWT_DI_CAPACITY,ENOMEM,i->now);break;}
+                pgwt_discovery_attempt a={.kind=PGWT_DISC_WAIT_ATTEMPT,.pid=l->pid,.cookie=l->cookie};
+                deliver(i,l,&a);l->physical_attempts[l->physical_count++]=r->attempt;
+                l->state.attachment=PGWT_DI_ATTEMPTING;
+            }
+        }
+        if(r->final_attachment) {l->final=*r;l->final_valid=true;}
+        final_attachment(i,l,r,false);
+        if(r->attempts_ended) l->state.attempts_ended=true;
+        break;
+    case PGWT_DH_NO_WORD:
+        if(!l || !l->state.installed) break;
+        sync_lifetime(i,l);
+        if(l->state.committed.abandoned) {
+            if(r->final_attachment || r->claims_completed_no_word)
+                pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);
+            break;
+        }
+        if(!l->state.committed.admitted && !l->state.committed.abandoned && !l->state.attempts_ended) {
+            struct pgwt_di_translation t;pgwt_di_translate(r,&i->cfg.construction,&t);
+            pgwt_discovery_attempt a={.kind=PGWT_DISC_TRY_NO_WAIT_WORD,.pid=l->pid,.cookie=l->cookie,.no_word=t.no_word};
+            /* The native authentication deadline is deliberately unqualified
+             * in I1. No production path issues WAIT_LIMIT. */
+            deliver(i,l,&a);l->state.attachment=PGWT_DI_POINTER_PENDING;
+        }
+        if(r->final_attachment) {l->final=*r;l->final_valid=true;}
+        final_attachment(i,l,r,true);
+        if(r->attempts_ended) l->state.attempts_ended=true;
+        break;
+    case PGWT_DH_TERMINAL: terminal_record(i,r);break;
+    case PGWT_DH_END:
+        if(r->attempts_ended) {
+            if(l && r->final_attachment) {l->final=*r;l->final_valid=true;}
+            end_attempts(i,l);
+        }
+        break;
+    default: break;
+    }
+}
+static void retain_candidate(struct pgwt_discovery_integration *i,const struct pgwt_discovery_attempt *r)
+{
+    for(size_t n=0;n<i->ncandidates;++n) {
+        struct pgwt_discovery_attempt *old=&i->candidates[n].record;
+        if(old->kind!=r->kind || old->pid!=r->pid || old->cookie!=r->cookie ||
+            (r->kind==PGWT_DH_RESOLUTION && old->numeric_resolution!=r->numeric_resolution)) continue;
+        if(old->terminal_ns && r->terminal_ns && old->terminal_ns!=r->terminal_ns) {
+            pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);return;
+        }
+        *old=*r;return;
+    }
+    if(i->ncandidates==i->cfg.capacity) {pgwt_di_operation_result(i,PGWT_DI_CAPACITY,ENOMEM,i->now);return;}
+    i->candidates[i->ncandidates++].record=*r;
+}
+static void barrier(struct pgwt_discovery_integration *i,bool active)
+{
+    i->report.barrier_active=active;
+    if(i->cfg.ops.barrier) i->cfg.ops.barrier(i->cfg.ops.ctx,active);
+}
+static void negative_checkpoint(struct pgwt_discovery_integration *i,
+                                 const struct pgwt_discovery_checkpoint *p)
+{
+    i->checkpoint=*p;
+    if((unsigned)p->reconciliation>PGWT_DREC_PERMANENT_FAILURE) {
+        i->report.certification_blocked=true;
+        pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);return;
+    }
+    if(p->reconciliation==PGWT_DREC_PERMANENT_FAILURE && !i->report.permanent_failure)
+        pgwt_di_operation_result(i,PGWT_DI_PERMANENT,p->error,i->now);
+    if(!p->handoff_complete) i->handoff_lost=i->report.certification_blocked=true;
+    bool totals=p->evidence_counts_known && i->baseline_known;
+    bool changed=totals && (p->kernel_evidence_count!=i->report.kernel_delivered ||
+                            p->user_evidence_count!=i->report.user_delivered);
+    bool unknown_new=!totals && !i->unknown_delivered;
+    bool handoff_new=!p->handoff_complete && !i->handoff_fault_delivered;
+    if(unknown_new || changed || handoff_new) {
+        i->report.certification_blocked=true;
+        /* Unscoped loss may conceal the sole revocation append. Inspect every
+         * previously committed route-c proof before any release-capable input. */
+        for(size_t n=0;n<i->nlives;++n) {
+            struct lifetime *l=&i->lives[n];sync_lifetime(i,l);
+            if(l->state.committed.no_wait_word && l->state.committed.has_lower_bound) {
+                revoke(i,l);
+                pgwt_discovery_attempt a={.kind=PGWT_DISC_POINTER,.pid=l->pid,.cookie=l->cookie,
+                    .pointer_continuous=false};
+                deliver(i,l,&a);
+            }
+        }
+        if(fault(i,PGWT_MERGE_UNKNOWN_EVIDENCE)) {
+            if(unknown_new) i->unknown_delivered=true;
+            if(handoff_new) i->handoff_fault_delivered=true;
+            if(totals && p->kernel_evidence_count>=i->report.kernel_delivered &&
+                p->user_evidence_count>=i->report.user_delivered) {
+                i->report.kernel_delivered=p->kernel_evidence_count;
+                i->report.user_delivered=p->user_evidence_count;
+            }
+        }
+    }
+    if(p->reconciliation==PGWT_DREC_PENDING)
+        pgwt_di_operation_result(i,PGWT_DI_TRANSIENT,p->error,i->now);
+    if(p->attempts_stopped) i->report.attempts_stopped=true;
+    if(p->reconciliation_ns<i->report.reconciliation_ns ||
+        p->reconciliation_count<i->report.reconciliation_count ||
+        (i->report.reconciliation_count && p->reconciliation_count==i->report.reconciliation_count &&
+         p->reconciliation_ns!=i->report.reconciliation_ns))
+        pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);
+    else {i->report.reconciliation_ns=p->reconciliation_ns;i->report.reconciliation_count=p->reconciliation_count;}
+    if(p->error && p->reconciliation!=PGWT_DREC_PENDING && p->reconciliation!=PGWT_DREC_PERMANENT_FAILURE)
+        pgwt_di_operation_result(i,PGWT_DI_UNCLASSIFIED,p->error,i->now);
+}
+static bool census_proved(struct pgwt_discovery_integration *i,const struct pgwt_discovery_attempt *r)
+{
+    if(!r || r->kind!=PGWT_DH_CENSUS || !tag_valid(r) || r->f0_ns!=i->cfg.f0 ||
+        r->reconciliation!=PGWT_DREC_COMPLETE || !cut_covered(&i->checkpoint,r) ||
+        i->checkpoint.reconciliation!=PGWT_DREC_COMPLETE || !i->checkpoint.handoff_complete ||
+        !i->checkpoint.evidence_counts_known || !r->handoff_complete || !r->evidence_counts_known ||
+        !holds(ALL(r->namespaces,r->history_complete,r->producers_complete,r->journal_complete)) ||
+        i->report.certification_blocked || !i->baseline_known || !current_agrees(i,r,true)) return false;
+    if(i->census_invalidated_at && (r->reconciliation_ns<i->census_invalidated_at ||
+        r->reconciliation_count<=i->census_invalidated_count)) return false;
+    bool registered=i->nlives==r->inventory_count;
+    for(size_t n=0;n<i->nlives;++n) registered&=i->lives[n].state.registered;
+    return registered && holds(ALL(r->enumeration,r->lifecycle_active,r->census_fenced,
+        r->lifecycle_fenced,r->counters_unchanged,vector_equal(&r->counters_before,&r->counters_after,true))) &&
+        !pgwt_capture_discovery_status(i->cfg.capture).unresolved_numeric &&
+        r->kernel_evidence_count==i->cfg.failure_baseline.kernel_evidence_count &&
+        r->user_evidence_count==i->cfg.failure_baseline.user_evidence_count;
+}
+static void batch_body(struct pgwt_discovery_integration *i,const struct pgwt_discovery_attempt *records,
+                         size_t count,const struct pgwt_discovery_attempt *census,
+                         const struct pgwt_discovery_checkpoint *current)
+{
+    deferred_fault(i);
+    snapshot(i);negative_checkpoint(i,current);
+    if(i->report.unclean) return;
+    if(census && !tag_valid(census)) pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);
+    /* A transient refresh or a writer failure does not disprove an already
+     * accepted population census. Only actual negative census evidence does.
+     * Registration APIs themselves withdraw completeness for new obligations. */
+    bool negative=!pgwt_capture_discovery_status(i->cfg.capture).census_complete ||
+        current->reconciliation==PGWT_DREC_PERMANENT_FAILURE || !current->handoff_complete ||
+        (census && (!holds(ALL(census->enumeration,census->lifecycle_active,census->census_fenced,
+            census->history_complete,census->producers_complete,census->journal_complete,
+            census->counters_unchanged,vector_equal(&census->counters_before,&census->counters_after,true))) ||
+            !census->handoff_complete));
+    if(negative) {
+        uint64_t fence=census && census->reconciliation_ns?census->reconciliation_ns:
+            pgwt_capture_discovery_status(i->cfg.capture).census_fence;
+        if(fence>=i->cfg.f0)
+            result(i,pgwt_capture_discovery_census(i->cfg.capture,fence,false,i->now,&i->current));
+    }
+    if(count>i->cfg.capacity || (count && !records)) {
+        pgwt_di_operation_result(i,PGWT_DI_CAPACITY,ENOMEM,i->now);return;
+    }
+    for(size_t n=0;n<count;++n) if(!tag_valid(&records[n]))
+        pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);
+    for(size_t n=0;n<count;++n) {
+        const struct pgwt_discovery_attempt *r=&records[n];
+        if(!tag_valid(r)) continue;
+        if(r->kind==PGWT_DH_FAULT && (r->evidence_fault || r->error))
+            pgwt_di_operation_result(i,r->error<0?PGWT_DI_UNCLASSIFIED:PGWT_DI_REQUIRED_FAILURE,r->error,i->now);
+    }
+    if(i->report.unclean) return;
+    /* Numbers precede J/R/G and ordinary inventory, regardless of append
+     * ordering. Independent lifetimes with a reused PID remain separate. */
+    for(size_t n=0;n<count;++n) {
+        const struct pgwt_discovery_attempt *r=&records[n];
+        if(!tag_valid(r) || r->kind!=PGWT_DH_NUMERIC) continue;
+        struct number *q=number(i,r->pid);
+        if(!q) {
+            if(i->nnumbers==i->cfg.capacity) {pgwt_di_operation_result(i,PGWT_DI_CAPACITY,ENOMEM,i->now);continue;}
+            q=&i->numbers[i->nnumbers++];q->pid=r->pid;
+        }
+        if(q->failed_open<r->failed_open) q->failed_open=r->failed_open;
+        result(i,pgwt_capture_discovery_numeric(i->cfg.capture,r->pid,0,r->failed_open));
+    }
+    for(size_t n=0;n<count;++n) {
+        const struct pgwt_discovery_attempt *r=&records[n];
+        if(!tag_valid(r) || !r->binding_token || !i->cfg.ops.binding || find(i,r->pid,r->cookie) ||
+            r->kind==PGWT_DH_CENSUS || r->kind==PGWT_DH_NUMERIC || r->kind==PGWT_DH_RESOLUTION) continue;
+        struct pgwt_discovery_binding_snapshot retained={0};
+        if(!i->cfg.ops.binding(i->cfg.ops.ctx,r->binding_token,&retained)) continue;
+        if(retained.inventory.kind!=PGWT_DH_INVENTORY || retained.inventory.pid!=r->pid ||
+            retained.inventory.cookie!=r->cookie || retained.inventory.binding_token!=r->binding_token) {
+            pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);continue;
+        }
+        struct lifetime *l=inventory(i,&retained.inventory,false);
+        installed(i,l,&retained.inventory);
+    }
+    for(size_t n=0;n<count;++n) {
+        const struct pgwt_discovery_attempt *r=&records[n];
+        if(tag_valid(r) && r->kind==PGWT_DH_INVENTORY) (void)inventory(i,r,false);
+    }
+    for(size_t n=0;n<count;++n) {
+        const struct pgwt_discovery_attempt *r=&records[n];
+        if(tag_valid(r) && r->kind==PGWT_DH_INSTALLED) installed(i,find(i,r->pid,r->cookie),r);
+    }
+    for(size_t n=0;n<i->nlives;++n) {
+        struct lifetime *l=&i->lives[n];
+        if(i->cfg.ops.binding && l->token) {
+            struct pgwt_discovery_binding_snapshot b={0};
+            if(i->cfg.ops.binding(i->cfg.ops.ctx,l->token,&b)) {
+                if(b.inventory.pid!=l->pid || b.inventory.cookie!=l->cookie || b.inventory.binding_token!=l->token)
+                    pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);
+                else if(retain_identity(i,l,&b.inventory)) {
+                    installed(i,l,&b.inventory);
+                    l->state.attempts_ended|=b.inventory.attempts_ended;
+                    pointer_record(i,l,&b.inventory);
+                }
+            }
+        }
+    }
+    for(size_t n=0;n<count;++n) {
+        const struct pgwt_discovery_attempt *r=&records[n];
+        if(!tag_valid(r)) continue;
+        if(r->kind==PGWT_DH_POINTER || r->kind==PGWT_DH_FAULT ||
+           r->kind==PGWT_DH_NO_WORD || r->kind==PGWT_DH_ATTEMPT)
+            pointer_record(i,find(i,r->pid,r->cookie),r);
+    }
+    if(i->report.unclean) return;
+    ma_envelope check={.version=1,.kind=MA_CHECK};
+    snapshot(i);result(i,pgwt_capture_envelope(i->cfg.capture,&check,i->now,&i->current));
+    /* Witnesses survive a receipt-before-controls or controls-before-receipt
+     * schedule. Consume all retained matches before finalising the cut. */
+    for(size_t n=0;n<count;++n) if(tag_valid(&records[n]) &&
+        (records[n].kind==PGWT_DH_RESOLUTION || records[n].kind==PGWT_DH_TERMINAL))
+        retain_candidate(i,&records[n]);
+    for(size_t n=0;n<i->ncandidates;++n) {
+        const struct pgwt_discovery_attempt *r=&i->candidates[n].record;
+        if(r->kind==PGWT_DH_RESOLUTION && holds(r->journal_eligible)) resolve(i,r);
+    }
+    for(size_t n=0;n<count;++n) if(tag_valid(&records[n]) &&
+        records[n].kind!=PGWT_DH_RESOLUTION && records[n].kind!=PGWT_DH_TERMINAL) process(i,&records[n]);
+    for(size_t n=0;n<i->ncandidates;++n) {
+        const struct pgwt_discovery_attempt *r=&i->candidates[n].record;
+        if(r->kind!=PGWT_DH_RESOLUTION || !holds(r->journal_eligible)) process(i,r);
+    }
+    for(size_t n=0;n<i->nlives;++n)
+        if(i->lives[n].final_valid && i->lives[n].state.attempts_ended && !i->lives[n].confirmation_sent)
+            final_attachment(i,&i->lives[n],&i->lives[n].final,
+                i->lives[n].final.kind==PGWT_DH_NO_WORD || i->lives[n].final.no_wait_word);
+    if(i->report.permanent_failure) {
+        for(size_t n=0;n<i->nlives;++n) end_attempts(i,&i->lives[n]);
+        struct pgwt_discovery_checkpoint p={0};
+        if(i->cfg.ops.checkpoint) i->cfg.ops.checkpoint(i->cfg.ops.ctx,&p);
+        i->report.attempts_stopped|=p.attempts_stopped;
+    }
+    finalize_terminals(i);
+    snapshot(i);
+    bool proved=census_proved(i,census);
+    if(proved) result(i,pgwt_capture_discovery_census(i->cfg.capture,census->reconciliation_ns,
+        true,i->now,&i->current)); /* eligible positive census is LAST */
+    for(size_t n=0;n<i->nlives;++n) sync_lifetime(i,&i->lives[n]);
+}
+void pgwt_di_batch(struct pgwt_discovery_integration *i,const struct pgwt_discovery_attempt *records,
+                   size_t count,const struct pgwt_discovery_attempt *census,
+                   const struct pgwt_discovery_checkpoint *current,uint64_t now)
+{
+    if(!i || !current) return;
+    if(i->busy) {refused_reentry(i);return;}
+    i->busy=true;i->now=now;
+    struct pgwt_discovery_attempt saved_census={0};
+    struct pgwt_discovery_checkpoint saved_checkpoint=*current;
+    if(census) saved_census=*census;
+    if(count<=i->cfg.capacity && records) memmove(i->batch,records,count*sizeof(*records));
+    barrier(i,true);
+    batch_body(i,count<=i->cfg.capacity && records?i->batch:NULL,count,
+        census?&saved_census:NULL,&saved_checkpoint);
+    deferred_fault(i);snapshot(i);barrier(i,false);i->busy=false;
+}
+static void checkpoint_body(struct pgwt_discovery_integration *i,uint64_t deadline)
+{
+    uint64_t now=i->now;
+    struct pgwt_discovery_checkpoint refreshed={0},p={0};
+    if(i->cfg.ops.refresh_until) refreshed=i->cfg.ops.refresh_until(i->cfg.ops.ctx,deadline);
+    if(refreshed.reconciliation==PGWT_DREC_PERMANENT_FAILURE)
+        pgwt_di_operation_result(i,PGWT_DI_PERMANENT,refreshed.error,now);
+    else if(refreshed.error || !i->cfg.ops.refresh_until)
+        pgwt_di_operation_result(i,refreshed.reconciliation==PGWT_DREC_PENDING?
+            PGWT_DI_TRANSIENT:PGWT_DI_UNCLASSIFIED,refreshed.error?refreshed.error:ENOSYS,now);
+    struct pgwt_discovery_attempt census={0};size_t zero=0;
+    bool have_census=i->cfg.ops.next && i->cfg.ops.next(i->cfg.ops.ctx,&zero,&census);
+    if(i->cfg.ops.checkpoint) i->cfg.ops.checkpoint(i->cfg.ops.ctx,&p);
+    size_t count=0;
+    while(i->cfg.ops.next && count<i->cfg.capacity) {
+        size_t previous=i->cursor;
+        if(!i->cfg.ops.next(i->cfg.ops.ctx,&i->cursor,&i->batch[count])) break;
+        if(i->cursor<=previous) {pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,now);break;}
+        ++count;
+    }
+    if(count==i->cfg.capacity && i->cfg.ops.next) {
+        struct pgwt_discovery_attempt extra={0};size_t probe=i->cursor;
+        if(i->cfg.ops.next(i->cfg.ops.ctx,&probe,&extra))
+            pgwt_di_operation_result(i,PGWT_DI_CAPACITY,ENOMEM,now);
+    }
+    batch_body(i,i->batch,count,have_census?&census:NULL,&p);
+}
+static void release_staged(struct pgwt_discovery_integration *i,uint64_t deadline)
+{
+    if(i->report.unclean) return;
+    for(size_t source=0;source<i->cfg.cpu_count+2;++source) {
+        while(i->stage_heads[source]!=SIZE_MAX) {
+            size_t slot=i->stage_heads[source];struct decoded *d=&i->staged[slot];
+            ma_envelope *e=&d->wire.envelope;
+            if(e->kind==MA_TRACE && e->cookie>=PGWT_DISCOVERY_COOKIE_MIN) {
+                pgwt_di_origin(i,d->pid,e->cookie,d->generation,&d->wire,&e->discovery_origin);
+                if(!e->discovery_origin.membership_proved) break;
+            } else e->discovery_origin=(pgwt_discovery_origin){0};
+            snapshot(i);
+            if(deadline && i->now>=deadline) return;
+            result(i,pgwt_capture_envelope_token(i->cfg.capture,e,d->token,i->now,&i->current));
+            i->stage_heads[source]=d->next;
+            if(d->next==SIZE_MAX)i->stage_tails[source]=SIZE_MAX;
+            d->active=false;--i->nstaged;d->next=i->stage_free;i->stage_free=slot;
+        }
+    }
+}
+void pgwt_di_checkpoint(struct pgwt_discovery_integration *i,uint64_t now,uint64_t deadline)
+{
+    if(!i) return;
+    if(i->busy) {refused_reentry(i);return;}
+    i->busy=true;i->now=now;barrier(i,true);
+    checkpoint_body(i,deadline);release_staged(i,deadline);
+    deferred_fault(i);snapshot(i);barrier(i,false);i->busy=false;
+}
+static uint64_t decoded_integer(const unsigned char *p,size_t n)
+{uint64_t v=0;for(size_t k=0;k<n;++k)v|=(uint64_t)p[k]<<(8*k);return v;}
+void pgwt_di_receive(struct pgwt_discovery_integration *i,const struct pgwt_wire_record *r,
+                      uint64_t pid,uint64_t time,uint64_t generation,uint64_t now,uint64_t deadline)
+{
+    if(!i || !r) return;
+    if(i->busy) {refused_reentry(i);return;}
+    i->busy=true;i->now=now;barrier(i,true);
+    checkpoint_body(i,deadline);
+    if(i->report.unclean) goto done;
+    const ma_envelope *e=&r->envelope;
+    if(e->source>=i->cfg.cpu_count+2 || e->size>272 || (e->size && !e->bytes) || !e->position ||
+        (e->kind!=MA_TRACE && e->kind!=MA_LIFECYCLE && e->kind!=MA_TEXT && e->kind!=MA_BOUNDARY)) {
+        pgwt_di_operation_result(i,PGWT_DI_TRANSPORT,EINVAL,i->now);goto done;
+    }
+    bool data=e->kind==MA_TRACE || e->kind==MA_LIFECYCLE || e->kind==MA_TEXT;
+    if(data && (e->size!=(e->kind==MA_TRACE?48u:e->kind==MA_TEXT?272u:24u) ||
+        decoded_integer(e->bytes+(e->kind==MA_TRACE?8:4),4)!=pid ||
+        (e->kind!=MA_TEXT && decoded_integer(e->bytes+(e->kind==MA_TRACE?0:16),8)!=time))) {
+        pgwt_di_operation_result(i,PGWT_DI_CONTRADICTION,EINVAL,i->now);goto done;
+    }
+    size_t slot=i->stage_free;
+    if(slot==SIZE_MAX) {
+        pgwt_di_operation_result(i,PGWT_DI_CAPACITY,ENOMEM,i->now);goto done;
+    }
+    struct decoded *d=&i->staged[slot];i->stage_free=d->next;
+    *d=(struct decoded){.wire=*r,.pid=pid,.time=time,.generation=generation,.next=SIZE_MAX};
+    if(e->size){memcpy(d->payload,e->bytes,e->size);d->wire.envelope.bytes=d->payload;}
+    if(e->kind==MA_LIFECYCLE && decoded_integer(e->bytes,2)==PGWT_LIFECYCLE_EXIT) {
+        struct pgwt_di_terminal_observation o={.cpu=r->cpu,.destination=r->dest,.sequence=r->seq,
+            .source=e->source,.position=e->position,.pid=pid,.cookie=e->cookie,.time=time,
+            .inventory_cookie=find(i,pid,e->cookie)?e->cookie:0};
+        pgwt_di_terminal_received(i,&o,i->now);
+    }
+    pgwt_capture_discovery_report before=pgwt_capture_discovery_status(i->cfg.capture);
+    int rc=pgwt_capture_received_token(i->cfg.capture,&d->wire.envelope,i->now,&d->token);
+    pgwt_capture_discovery_report after=pgwt_capture_discovery_status(i->cfg.capture);
+    if((before.census_complete && !after.census_complete) || (before.closed && !after.closed)) {
+        i->census_invalidated_at=i->now;i->census_invalidated_count=i->checkpoint.reconciliation_count;
+    }
+    if(rc<0) {result(i,rc);d->next=i->stage_free;i->stage_free=slot;goto done;}
+    bool exit=e->kind==MA_LIFECYCLE && decoded_integer(e->bytes,2)==PGWT_LIFECYCLE_EXIT;
+    if(rc==0 || (rc==2 && exit)) {
+        d->active=true;++i->nstaged;
+        if(i->stage_tails[e->source]!=SIZE_MAX)i->staged[i->stage_tails[e->source]].next=slot;
+        else i->stage_heads[e->source]=slot;
+        i->stage_tails[e->source]=slot;
+    } else {d->next=i->stage_free;i->stage_free=slot;}
+    /* Receipt can synchronously generate attachment handoff. Keep the same
+     * barrier and the same absolute deadline for its second checkpoint. */
+    checkpoint_body(i,deadline);
+    release_staged(i,deadline);
+done:
+    deferred_fault(i);snapshot(i);barrier(i,false);i->busy=false;
+}
+void pgwt_di_origin(struct pgwt_discovery_integration *i,uint64_t pid,uint64_t cookie,
+                     uint64_t generation,const struct pgwt_wire_record *r,pgwt_discovery_origin *o)
+{
+    if(!o) return;
+    *o=(pgwt_discovery_origin){0}; /* TEXT shared; markers never refresh baselines */
+    if(!i || !r || !generation || !find(i,pid,cookie) || !i->cfg.ops.generation_member ||
+        !r->envelope.cookie_present || r->envelope.cookie!=cookie) return;
+    o->marker=r->envelope.discovery_origin.marker;
+    o->attachment_generation=generation;
+    o->membership_proved=i->cfg.ops.generation_member(i->cfg.ops.ctx,pid,cookie,generation,r);
+}
+struct pgwt_di_report pgwt_di_status(struct pgwt_discovery_integration *i)
+{
+    if(!i) return (struct pgwt_di_report){.incomplete=true};
+    for(size_t n=0;n<i->nlives;++n) sync_lifetime(i,&i->lives[n]);
+    i->report.pending=pgwt_capture_discovery_status(i->cfg.capture);
+    i->report.pending_totals_available=!i->report.tracking_failed;
+    i->report.lifetimes=i->nlives;i->report.numbers=i->nnumbers;
+    i->report.terminals=i->nterminals;i->report.append_cursor=i->cursor;i->report.staged_records=i->nstaged;
+    i->report.undecided_terminals=0;
+    for(size_t n=0;n<i->nterminals;++n)i->report.undecided_terminals+=i->terminals[n].disposition==PGWT_DI_UNDECIDED;
+    return i->report;
+}
+bool pgwt_di_lifetime_state(struct pgwt_discovery_integration *i,uint64_t pid,uint64_t cookie,
+                             struct pgwt_di_lifetime *out)
+{
+    if(!i || !out) return false;
+    struct lifetime *l=find(i,pid,cookie);if(!l) return false;
+    sync_lifetime(i,l);*out=l->state;return true;
+}
+static void *di_allocate(const struct pgwt_di_config *cfg,size_t count,size_t size)
+{
+    if(size && count>SIZE_MAX/size) return NULL;
+    void *p=cfg->allocate?cfg->allocate(cfg->ops.ctx,count,size):calloc(count,size);
+    if(p && cfg->allocate)memset(p,0,count*size);
+    return p;
+}
+static void di_deallocate(const struct pgwt_di_config *cfg,void *p)
+{if(p){if(cfg->deallocate)cfg->deallocate(cfg->ops.ctx,p);else free(p);}}
+static void creation_failed(const struct pgwt_di_config *cfg,int error)
+{
+    if(!cfg) return;
+    struct pgwt_di_report r={.last_error=error,.tracking_failed=error==ENOMEM,.incomplete=true,
+        .certification_blocked=true,.unclean=true};
+    r.outcomes[error==ENOMEM?PGWT_DI_CAPACITY:PGWT_DI_UNCLASSIFIED]=1;
+    if(error==ENOMEM && cfg->capture) {
+        struct pgwt_di_observation o={.detected=cfg->f0,.counters=cfg->baseline};
+        if(cfg->ops.counters && cfg->ops.counters(cfg->ops.ctx,&o))o.counters.valid=false;
+        int begun=pgwt_capture_coverage_begin(cfg->capture,cfg->f0,NULL,0,NULL);
+        if(begun<0){++r.outcomes[PGWT_DI_UNCLASSIFIED];r.last_error=diagnostic_errno(begun);}
+        int rc=pgwt_capture_fault(cfg->capture,PGWT_MERGE_ALLOCATION_FAIL,o.detected,&o.counters);
+        r.unclean=begun<0 || rc<0 || pgwt_capture_report(cfg->capture).void_failed ||
+            !cfg->ops.startup_gap_ready || !cfg->ops.startup_gap_ready(cfg->ops.ctx);
+        r.pending=pgwt_capture_discovery_status(cfg->capture);
+    }
+    if(cfg->creation_outcome)*cfg->creation_outcome=r;
+}
+struct pgwt_discovery_integration *pgwt_di_create(const struct pgwt_di_config *cfg)
+{
+    if(!cfg || !cfg->capture || !cfg->capacity || cfg->capacity>PGWT_CAPTURE_LIFETIME_CAPACITY ||
+        !cfg->cpu_count || cfg->cpu_count>MAX_CPUS || !cfg->f0 || !cfg->baseline_time || cfg->baseline_time>cfg->f0 ||
+        (unsigned)cfg->variant>PGWT_DI_NO_SUPPORT || cfg->capacity>SIZE_MAX/sizeof(struct lifetime) ||
+        (!!cfg->allocate!=!!cfg->deallocate)) {creation_failed(cfg,EINVAL);return NULL;}
+    struct pgwt_discovery_integration *i=di_allocate(cfg,1,sizeof(*i));
+    if(!i) {creation_failed(cfg,ENOMEM);return NULL;}
+    i->cfg=*cfg;i->cursor=1;i->current=cfg->baseline;i->now=cfg->f0;
+    i->lives=di_allocate(cfg,cfg->capacity,sizeof(*i->lives));i->numbers=di_allocate(cfg,cfg->capacity,sizeof(*i->numbers));
+    i->terminals=di_allocate(cfg,cfg->capacity,sizeof(*i->terminals));i->batch=di_allocate(cfg,cfg->capacity,sizeof(*i->batch));
+    i->candidates=di_allocate(cfg,cfg->capacity,sizeof(*i->candidates));
+    i->staged=di_allocate(cfg,cfg->capacity,sizeof(*i->staged));
+    i->stage_heads=di_allocate(cfg,cfg->cpu_count+2,sizeof(*i->stage_heads));
+    i->stage_tails=di_allocate(cfg,cfg->cpu_count+2,sizeof(*i->stage_tails));
+    if(!i->lives || !i->numbers || !i->terminals || !i->batch || !i->candidates || !i->staged || !i->stage_heads || !i->stage_tails) {pgwt_di_destroy(i);creation_failed(cfg,ENOMEM);return NULL;}
+    for(size_t n=0;n<cfg->capacity;++n)i->staged[n].next=n+1<cfg->capacity?n+1:SIZE_MAX;
+    i->stage_free=0;
+    for(size_t n=0;n<cfg->cpu_count+2;++n)i->stage_heads[n]=i->stage_tails[n]=SIZE_MAX;
+    i->baseline_known=cfg->failure_baseline.evidence_counts_known && complete_snapshot(&cfg->baseline);
+    i->handoff_lost=!cfg->failure_baseline.handoff_complete;
+    if(i->handoff_lost)i->report.certification_blocked=i->report.incomplete=true;
+    i->report.kernel_delivered=cfg->failure_baseline.kernel_evidence_count;
+    i->report.user_delivered=cfg->failure_baseline.user_evidence_count;
+    result(i,pgwt_capture_coverage_begin(cfg->capture,cfg->f0,NULL,0,NULL));
+    if(!cfg->ops.startup_gap_ready || !cfg->ops.startup_gap_ready(cfg->ops.ctx))
+        pgwt_di_operation_result(i,PGWT_DI_WRITER,EIO,cfg->f0);
+    if(!i->baseline_known) (void)fault(i,PGWT_MERGE_UNKNOWN_EVIDENCE);
+    if(cfg->creation_outcome)*cfg->creation_outcome=pgwt_di_status(i);
+    return i;
+}
+void pgwt_di_destroy(struct pgwt_discovery_integration *i)
+{
+    if(!i) return;
+    struct pgwt_di_config cfg=i->cfg;
+    di_deallocate(&cfg,i->stage_tails);di_deallocate(&cfg,i->stage_heads);di_deallocate(&cfg,i->staged);
+    di_deallocate(&cfg,i->candidates);di_deallocate(&cfg,i->batch);di_deallocate(&cfg,i->terminals);
+    di_deallocate(&cfg,i->numbers);di_deallocate(&cfg,i->lives);di_deallocate(&cfg,i);
+}
