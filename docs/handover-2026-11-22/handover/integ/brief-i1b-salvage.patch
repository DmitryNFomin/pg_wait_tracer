+    r=valid_record(PGWT_DH_ATTEMPT);r.lifecycle_active=(fact){false,true};pgwt_di_translate(&r,&k,&t);
+    CHECK(!(t.proof.known&PGWT_DISC_LIFECYCLE_ACCOUNTING) && !(t.proof.truth&PGWT_DISC_LIFECYCLE_ACCOUNTING),
