+    r=valid_record(PGWT_DH_ATTEMPT);r.v0_valid=false;r.v0=9;r.threads0=2;pgwt_di_translate(&r,&k,&t);
+    CHECK(!(t.proof.known&(PGWT_DISC_COUNTER_NO_WRAP|PGWT_DISC_THREAD_HISTORY)),"unqualified endpoint values stay unknown");
+    r=valid_record(PGWT_DH_ATTEMPT);r.seed_valid=false;r.accumulator=5;r.cpu_base=3;r.on_cpu_ts=20;
+    pgwt_di_translate(&r,&k,&t);CHECK(!(t.proof.known&PGWT_DISC_FRESH_COHERENT_SEED),"unavailable seed contents cannot prove mismatch");
+    r=valid_record(PGWT_DH_ATTEMPT);r.armed_addr=0;pgwt_di_translate(&r,&k,&t);
