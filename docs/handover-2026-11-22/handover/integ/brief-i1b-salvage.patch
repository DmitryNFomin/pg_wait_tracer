+            if(state==1)r.journal_eligible=(fact){0};
+        }
+        if(kind==PGWT_DH_ATTEMPT && state==1)r.enable_confirmed=(fact){0};
+        if(kind==PGWT_DH_NO_WORD && state==1)r.permanent_role_proved=(fact){0};
+        if(kind==PGWT_DH_POINTER){r.pointer_nonnull=1;if(state==1){r.pointer_snapshot_valid=false;r.pointer_continuous=(fact){0};}}
+        if(kind==PGWT_DH_TERMINAL) {
+            r.terminal_transport_known=true;r.terminal_cpu=0;r.terminal_dest=2;r.terminal_seq=100;
+            r.terminal_ns=DB+18;r.terminal_start_ns=r.lifetime_start_ns;r.terminal_cookie=DG;
+            r.terminal_match=state==1?(fact){0}:(fact){true,true};
+            s->joined=(struct pgwt_di_terminal_observation){.cpu=0,.destination=2,.sequence=100,.source=3,
+                .position=1,.pid=30,.cookie=DG,.time=DB+18,.inventory_cookie=DG};s->join_result=PGWT_DI_JOIN_UNIQUE;
+        }
