+        CHECK(t.quiet.S0==expected[n] && t.quiet.S1==expected[n],"inactivity enum is explicitly translated");}
+    r.S0=r.S1=(enum pgwt_discovery_inactive)99;pgwt_di_translate(&r,&k,&t);
+    CHECK(t.quiet.S0==PGWT_DISC_INACTIVITY_UNKNOWN && t.quiet.S1==PGWT_DISC_INACTIVITY_UNKNOWN,"invalid enum remains unknown");
+}
