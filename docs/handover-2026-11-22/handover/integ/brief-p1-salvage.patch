+            ('token-overflow', 'if (s->next_binding_token == UINT64_MAX)', 'if (false)', 'P1 binding token no wrap'),
+            ('reserve-before-install', 'e->cookie = pgwt_discovery_allocate(&s->next_cookie, &s->exhausted);', 'e->cookie = 0;', 'P1 cookie reserved at bind'),
+            ('reused-token', 'entry->binding_token = ++s->next_binding_token;', 'entry->binding_token = 1; ++s->next_binding_token;', 'P1 token reuse prevention'),
+            ('journal-reservation', 'entry->kernel_only = entry->excluded = true;', 'entry->kernel_only = entry->excluded = true; entry->cookie = 0;', 'P1 journal-only inventory'),
+            ('seed-measurement', 'seed.cpu_ns_total = cpu.total;', 'seed.cpu_ns_total = 0;', 'P1 measured seed accumulator'),
+            ('immutable-B', '            a->producers_fenced_ns = disc_now(c);', '            a->producers_fenced_ns = disc_now(c);\n            if (c->entry && c->entry->generation_count>1) for(size_t j=0;j<ncpu;++j) c->entry->generations[1].pre_enable[j] = acks[pgwt_percpu_transport_cpu_id(d, j)];', 'P1 immutable B'),
+            ('detach', 'if (entry->pointer_enabled) pointer_break(d, entry);', 'if (false) pointer_break(d, entry);', 'P1 detach carried'),
+            ('cursor', '    size_t offset = 1;', '    size_t offset = 0;', 'P1 stable cursor after ready'),
+            ('stub-error', '.error = ENOSYS};', '.error = 0};', 'P1 refresh stub PENDING'),
+            ('generation-id', 'b->attachment_generation = a->attachment_generation;', 'b->attachment_generation = 1;', 'P1 attachment_generation'),
