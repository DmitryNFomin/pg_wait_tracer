+#!/usr/bin/env python3
+"""P1 physical handoff cases and product mutants at their named assertions."""
+from pathlib import Path
+import tempfile
+from test_discovery_producer import ROOT, compile_run, daemon_source
+from transport_producers_host import replace_once, function
+
+
+def source(adapter):
+    return daemon_source(adapter).replace('#include "discovery_daemon_cases.h"',
+        '#define main legacy_discovery_cases_main\n#include "discovery_daemon_cases.h"\n'
+        '#undef main\n#include "discovery_handoff_cases.h"')
+
+
+def main():
+    engine = (ROOT / 'src/discovery_attempt.c').read_text()
+    adapter = (ROOT / 'src/discovery_producer.c').read_text()
+    with tempfile.TemporaryDirectory(prefix='pgwt-discovery-handoff-') as temp:
+        directory = Path(temp)
+        def run(name, body=adapter, bracket=engine):
+            return compile_run(directory, name, [('engine', bracket), ('daemon', source(body))])
+        result = run('production')
+        assert result.returncode == 0, result.stdout + result.stderr
+        print(result.stdout, end='')
+        mutants = []
+        def emitted(name, assignment, assertion, predicate='true'):
+            mutants.append((name, replace_once(adapter, '    s->records[s->record_count++] = record;',
+                f'    if ({predicate}) {{ {assignment} }}\n    s->records[s->record_count++] = record;'), assertion))
+        emitted('premature-history', 'record.history_complete = (struct pgwt_producer_fact){true,true};', 'P1 unknown history_complete', 'record.kind == PGWT_DH_POINTER && record.maximum_attempts')
+        emitted('premature-finality', 'record.attempts_ended = true;', 'P1 unknown finality', 'record.kind == PGWT_DH_POINTER && record.maximum_attempts')
+        emitted('premature-seed', 'record.seed_valid = true;', 'P1 unknown seed', 'record.kind == PGWT_DH_POINTER && record.maximum_attempts')
+        emitted('premature-coherence', 'record.claims_completed_coherence = true;', 'P1 unknown completed claims', 'record.kind == PGWT_DH_POINTER && record.maximum_attempts')
+        emitted('premature-pointer-snapshot', 'record.pointer_snapshot_valid = true;', 'P1 unknown pointer counts', 'record.kind == PGWT_DH_POINTER && record.maximum_attempts')
+        emitted('counter-vectors-swapped', 'struct pgwt_counter_vector swap=record.counters_before; record.counters_before=record.counters_after; record.counters_after=swap;', 'P1 record local rejection counters', 'record.kind == PGWT_DH_ATTEMPT && record.error')
+        emitted('handoff-restored', 'record.handoff_complete = true;', 'P1 handoff failure sticky')
+        emitted('wrap-known', 'record.evidence_counts_known = true;', 'P1 evidence wrap unknown')
+        emitted('kind', 'record.kind = PGWT_DH_INVALID;', 'P1 required record kind')
+        emitted('binding-token', 'record.binding_token = 0;', 'P1 binding_token')
+        emitted('cookie-reservation', 'record.cookie = 0;', 'P1 reservation')
+        emitted('installation-time', 'record.identity_visible_at = 0;', 'P1 identity_visible_at')
+        for member in ('tid', 'tgid', 'parent', 'postmaster'):
+            emitted(member, f'record.{member} = 0;', 'P1 task identifiers', 'record.kind == PGWT_DH_ATTEMPT')
+        for member in ('namespaces', 'retained_binding', 'history_complete', 'producers_complete',
+                       'journal_complete', 'install_before_enable', 'failure_accounting', 'voluntary_no_wrap'):
+            emitted(member, f'record.{member}.known = false;', 'P1 ' + member)
+        for member in ('reconciliation_ns', 'reconciliation_count'):
+            emitted(member, f'record.{member} = 0;', 'P1 ' + member)
+        emitted('reconciliation-state', 'record.reconciliation = PGWT_DREC_PENDING;', 'P1 reconciliation')
+        emitted('accumulator', 'record.accumulator = 1;', 'P1 accumulator', 'record.kind == PGWT_DH_ATTEMPT && record.quiet_valid')
+        emitted('on-cpu', 'record.on_cpu_ts = 1;', 'P1 on_cpu_ts', 'record.kind == PGWT_DH_ATTEMPT && record.quiet_valid')
+        emitted('seed-valid', 'record.seed_valid = false;', 'P1 seed_valid')
+        emitted('finality', 'record.attempts_ended = false;', 'P1 attempts_ended')
+        emitted('completed-coherence', 'record.claims_completed_coherence = false;', 'P1 claims_completed_coherence')
+        emitted('evidence-validity', 'record.evidence_counts_known = false;', 'P1 evidence_counts_known')
+        emitted('handoff-integrity', 'record.handoff_complete = false;', 'P1 handoff_complete')
+        emitted('failed-open', 'record.failed_open = 0;', 'P1 failed_open')
+        emitted('gone-time', 'record.gone_at = 0;', 'P1 gone_at')
+        emitted('journal-terminal-match', 'record.terminal_match.value = false;', 'P1 terminal_match', 'record.kind == PGWT_DH_RESOLUTION')
+        emitted('gone-esrch', 'record.gone_esrch.value = false;', 'P1 gone_esrch')
+        emitted('journal-eligibility', 'record.journal_eligible.known = false;', 'P1 G journal ineligibility')
+        emitted('exact-start', 'record.start_mono_known.value = false;', 'P1 start_mono_known')
+        emitted('fork-cookie', 'record.fork_cookie = 0;', 'P1 fork_cookie')
+        emitted('pointer-snapshot', 'record.pointer_snapshot_valid = false;', 'P1 pointer_snapshot_valid')
+        emitted('completed-no-word', 'record.claims_completed_no_word = false;', 'P1 claims_completed_no_word')
+        emitted('counters-after', 'record.counters_after = (struct pgwt_counter_vector){0};', 'P1 record-local counters')
+        emitted('invent-tick-start', 'record.lifetime_start_ns = record.start_upper_ns; record.start_mono_known = (struct pgwt_producer_fact){true,true};', 'P1 unknown start_mono_known', 'record.kind == PGWT_DH_INVENTORY')
