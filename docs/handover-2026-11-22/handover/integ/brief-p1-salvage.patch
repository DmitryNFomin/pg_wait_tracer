@@ -0,0 +1,352 @@
+/* P1 physical facts, independently scheduled from the legacy regression main. */
+static struct pgwt_discovery_attempt handoff(struct pgwt_daemon *d, enum pgwt_discovery_handoff_kind kind)
+{
+    if(kind==PGWT_DH_POINTER)
+        for(size_t i=d->discovery_admission->record_count;i>0;--i)
+            if(d->discovery_admission->records[i-1].kind==kind)return d->discovery_admission->records[i-1];
+    for(size_t i=0;i<d->discovery_admission->record_count;++i)
+        if(d->discovery_admission->records[i].kind==kind)return d->discovery_admission->records[i];
+    CHECK("P1 required record kind",false);
+    return (struct pgwt_discovery_attempt){0};
+}
+#define FTRUE(a, member) CHECK("P1 " #member,(a).member.known && (a).member.value)
+#define UNKNOWN(a, member) CHECK("P1 unknown " #member,!(a).member.known && !(a).member.value)
+#define NONZERO(a, member) CHECK("P1 " #member,(a).member!=0)
+static void unknown_facts(void)
+{
+    struct pgwt_daemon *d=setup();withhold_helper=true;
+    (void)pgwt_discovery_attach(d,&d->backends.entries[0]);
+    struct pgwt_discovery_attempt a=handoff(d,PGWT_DH_POINTER);
+    UNKNOWN(a,start_mono_known);UNKNOWN(a,namespaces);UNKNOWN(a,retained_binding);
+    UNKNOWN(a,history_complete);UNKNOWN(a,producers_complete);UNKNOWN(a,journal_complete);
+    UNKNOWN(a,journal_eligible);UNKNOWN(a,gone_esrch);
+    UNKNOWN(a,install_before_enable);UNKNOWN(a,failure_accounting);UNKNOWN(a,voluntary_no_wrap);
+    CHECK("P1 unknown task identifiers",!a.tid && !a.tgid && !a.parent && !a.postmaster && !a.fork_cookie);
+    CHECK("P1 unknown operation times",!a.failed_open && !a.gone_at && !a.identity_visible_at);
+    CHECK("P1 unknown reconciliation",a.reconciliation==PGWT_DREC_PENDING && !a.reconciliation_ns && !a.reconciliation_count);
+    CHECK("P1 unknown seed",!a.seed_valid && !a.accumulator && !a.on_cpu_ts && !a.cpu_base_valid);
+    CHECK("P1 unknown finality",!a.attempts_ended);
+    CHECK("P1 unknown completed claims",!a.claims_completed_coherence && !a.claims_completed_no_word);
+    CHECK("P1 unknown pointer counts",!a.pointer_snapshot_valid && !a.pointer_fires_before && !a.pointer_fires_after && !a.pointer_nonnull);
+    CHECK("P1 unknown accounting",!a.failure_accounting.known && a.counters_after.valid);
+    teardown(d);
+    d=setup();kernel_wait_fault=counter_wait_baseline=1;
+    (void)pgwt_discovery_attach(d,&d->backends.entries[0]);a=handoff(d,PGWT_DH_POINTER);
+    CHECK("P1 rejected fence retains numeric totals",a.counters_after.valid &&
+        a.counters_after.components[PGWT_C_WAIT_READ_FAIL].value==1 && !a.failure_accounting.known &&
+        a.reconciliation==PGWT_DREC_PENDING);
+    teardown(d);
+    d=setup();clock_read_failure=true;
+    (void)observe_number(d,42);a=handoff(d,PGWT_DH_NUMERIC);
+    CHECK("P1 unknown failed-open time",!a.failed_open && !a.cookie && !a.binding_token);
+    teardown(d);
+}
+static void installed_facts(void)
+{
+    struct pgwt_daemon *d=setup();
+    CHECK("P1 cookie reserved at bind",d->discovery_admission->entries[0].cookie==PGWT_DISCOVERY_FIRST && d->discovery_admission->next_cookie==PGWT_DISCOVERY_FIRST+1);
+    CHECK("P1 attach completes",!pgwt_discovery_attach(d,&d->backends.entries[0]));
+    struct pgwt_discovery_attempt i=handoff(d,PGWT_DH_INVENTORY);
+    struct pgwt_discovery_attempt v=handoff(d,PGWT_DH_INSTALLED);
+    struct pgwt_discovery_attempt a=handoff(d,PGWT_DH_ATTEMPT);
+    CHECK("P1 authoritative kind",i.kind==PGWT_DH_INVENTORY && v.kind==PGWT_DH_INSTALLED && a.kind==PGWT_DH_ATTEMPT);
+    CHECK("P1 reservation",i.cookie==PGWT_DISCOVERY_FIRST && v.cookie==i.cookie && a.cookie==i.cookie);
+    CHECK("P1 binding_token",i.binding_token && v.binding_token==i.binding_token && a.binding_token==i.binding_token);
+    CHECK("P1 identity_visible_at",v.identity_visible_at && a.identity_visible_at==v.identity_visible_at &&
+        v.identity_visible_at<=a.generation_published_ns);
+    CHECK("P1 installation ordering",!i.identity_visible.value && v.identity_visible.value &&
+        d->discovery_admission->records[0].kind==PGWT_DH_INVENTORY &&
+        d->discovery_admission->records[1].kind==PGWT_DH_INSTALLED);
+    CHECK("P1 task identifiers",a.tid==42 && a.tgid==42 && a.parent==1 && a.postmaster==1);
+    UNKNOWN(i,start_mono_known);CHECK("P1 tick start is not exact",!i.lifetime_start_ns && i.start_upper_ns==110000000);
