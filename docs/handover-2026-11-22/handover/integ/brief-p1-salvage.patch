+/* A failed route-c bracket can still contain a positively bound pointer read.
+ * Its failure to certify a baseline does not erase that observation. */
+static inline bool pgwt_discovery_nonnull_witness(const pgwt_discovery_attempt *d)
+{
+    return (d->kind == PGWT_DISC_TRY_NO_WAIT_WORD ||
+        d->kind == PGWT_DISC_CONFIRM_NO_WAIT_WORD ||
+        (d->kind == PGWT_DISC_ADMIT && d->route == PGWT_DISC_NO_WAIT_WORD)) &&
+        d->no_word.read_ok && d->no_word.binding && d->no_word.handle0 &&
+        d->no_word.handle0 == d->no_word.handle1 && d->no_word.pointer;
+}
+typedef struct {
+    uint64_t attachment_generation;
+    bool membership_proved, marker, baselines_refreshed;
+    /* Retained producer attribution: metadata belongs only to (pid,cookie).
+     * Shared metadata never sets this flag. */
+    bool exclusive_text;
+} pgwt_discovery_origin;
+typedef struct {
+    bool admitted, confirmed, has_lower_bound, terminal_released, abandoned;
+    /* Capture-lifetime evidence, written on receipt before release or disposal. */
+    bool has_attributable, has_provenance_uncertified, numerical_seen;
+    bool terminal_claimed, terminal_refuted, admission_recorded;
+    uint64_t attributable_through, provenance_uncertified_through;
+    uint64_t claimed_terminal_time, terminal_source, terminal_position;
+    bool terminal_names_exit, has_exit_evidence, exit_conflicting;
+    /* Raw control receipt is distinct from validated admission/confirmation. */
+    pgwt_discovery_control_kind last_control;
+    uint64_t control_observed_at, control_attachment_generation;
+    uint64_t exit_stamp, exit_source, exit_position;
+    bool no_wait_word, pointer_watched, pointer_nonnull, waiting_limit_exceeded;
+    bool pointer_discontinuous; /* retained even before route-c ADMIT */
+    uint64_t wait_word_attempts, pointer_observations, authentication_deadline;
+    pgwt_discovery_no_word no_word_witness;
+    bool has_uncertified;
+    uint64_t uncertified_through; /* greatest validated consumed numerical stamp */
+    uint64_t attachment_generation, lower_bound, terminal_time;
+    uint64_t source, position;
+    pgwt_discovery_witness baseline;
+} pgwt_discovery_state;
