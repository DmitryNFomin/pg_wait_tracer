+            ('cpu-index', 'memcpy(b->cpu_ids, a->cpu_ids, a->cpu_count * sizeof(*b->cpu_ids));', 'memset(b->cpu_ids, 0, sizeof(b->cpu_ids));', 'P1 CPU membership'),
+            ('pre-enable-vector', 'memcpy(b->pre_enable, a->producers_after, a->cpu_count * sizeof(*b->pre_enable));', 'memset(b->pre_enable, 0, sizeof(b->pre_enable));', 'P1 pre_enable'),
+            ('pre-enable-time', '    if (!b->pre_enable_valid) return -1;', '    if (!b->pre_enable_valid) return -1;\n    b->pre_enable_completed_ns = 0;', 'P1 pre_enable_completed_ns'),
+            ('pre-enable-valid', '    if (!b->pre_enable_valid) return -1;', '    if (!b->pre_enable_valid) return -1;\n    b->pre_enable_valid = false;', 'P1 pre_enable_valid'),
+            ('lost-fire', 'count_after == UINT64_MAX || observed.fires != count_after || observed.nonnull == UINT64_MAX', 'false', 'P1 observation loss refuses snapshot'),
+            ('append-total', 's->handoff_lost = true; user_evidence(s); c->d->counters.writer_push_fail_total++; return;', 's->handoff_lost = true; c->d->counters.writer_push_fail_total++; return;', 'P1 full append counted'),
+            ('rejected-fence-totals-dropped', 'a->address_qualified = fact(false); return incomplete_cut(c, a);', 'a->address_qualified = fact(false); return -1;', 'P1 rejected fence retains numeric totals'),
+            ('no-word-rebased-counters', 'before = entry->pointer_counters_before; a.counters_before = before;', 'before = pgwt_daemon_counter_vector(d); a.counters_before = before;', 'P1 no-word retries retain original accounting'),
+            ('strict-after-enable', 'a.pointer_read_ns > a.e &&', 'a.pointer_read_ns >= a.e &&', 'P1 equality cannot prove no-word'),
+            ('stub-pending', '.reconciliation = PGWT_DREC_PENDING,\n        .attempts_stopped', '.reconciliation = PGWT_DREC_COMPLETE,\n        .attempts_stopped', 'P1 refresh stub PENDING'),
