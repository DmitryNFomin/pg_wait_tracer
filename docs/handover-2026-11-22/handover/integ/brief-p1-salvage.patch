+    FTRUE(a,history_complete);FTRUE(a,producers_complete);FTRUE(a,journal_complete);
+    NONZERO(a,reconciliation_ns);NONZERO(a,reconciliation_count);
+    CHECK("P1 reconciliation",a.reconciliation==PGWT_DREC_COMPLETE && a.reconciliation_ns>=a.producers_fenced_ns);
+    CHECK("P1 accumulator",a.accumulator==a.cpu_base && a.accumulator==0);
+    CHECK("P1 on_cpu_ts",a.on_cpu_ts==0);
+    CHECK("P1 seed_valid",a.seed_valid && a.cpu_base_valid);
+    FTRUE(a,install_before_enable);FTRUE(a,failure_accounting);FTRUE(a,voluntary_no_wrap);
+    CHECK("P1 attempts_ended",a.attempts_ended && d->discovery_admission->entries[0].attempts_ended);
+    CHECK("P1 claims_completed_coherence",a.claims_completed_coherence && a.quiet_valid);
+    CHECK("P1 no false no-word claim",!a.claims_completed_no_word);
+    CHECK("P1 evidence_counts_known",a.evidence_counts_known);
+    CHECK("P1 kernel_evidence_count zero",a.kernel_evidence_count==0);
+    CHECK("P1 user_evidence_count zero",a.user_evidence_count==0);
+    CHECK("P1 handoff_complete",a.handoff_complete);
+    CHECK("P1 record-local counters",a.counters_before.valid && a.counters_after.valid && a.counters_unchanged.value);
+    struct pgwt_discovery_attempt saved=a;
+    d->counters.discovery_read_fail_total=9;
+    a=handoff(d,PGWT_DH_ATTEMPT);
+    CHECK("P1 historical accounting immutable",!memcmp(&saved,&a,sizeof(saved)));
+    teardown(d);
+    d=setup();cpu_consumed=37;
+    (void)pgwt_discovery_attach(d,&d->backends.entries[0]);a=handoff(d,PGWT_DH_ATTEMPT);
+    CHECK("P1 measured seed accumulator",a.accumulator==37 && a.cpu_base==37 && a.seed_valid && !a.on_cpu_ts);
+    teardown(d);
+}
+static void binding_and_inventory_facts(void)
+{
+    struct pgwt_daemon *d=setup();pointer_open_fail=true;
+    (void)pgwt_discovery_attach(d,&d->backends.entries[0]);
+    struct pgwt_discovery_attempt a=handoff(d,PGWT_DH_INVENTORY);
+    CHECK("P1 reservation before failure",a.cookie && a.binding_token && !a.identity_visible.value && !identity_exists);
+    uint64_t cookie=a.cookie,token=a.binding_token;
+    struct disc_entry *next=new_inventory(d->discovery_admission,42,10);
+    next->proc=10;next->mem=14;next->status_known=true;
+    struct pgwt_discovery_status status={.known=true,.start_ticks=10,.parent=1,.tgid=42};
+    publish_inventory(d,next,&status);
+    CHECK("P1 token reuse prevention",next->binding_token>token && next->cookie>cookie);
+    teardown(d);
+    d=setup();d->discovery_admission->entries[0].mem=-1;
+    (void)pgwt_discovery_attach(d,&d->backends.entries[0]);
+    a=handoff(d,PGWT_DH_END);
+    CHECK("P1 unreadable memory ends setup",a.attempts_ended && a.error==EACCES && !identity_exists && !d->counters.discovery_read_fail_total);
+    teardown(d);
+    d=setup();d->discovery_admission->next_binding_token=UINT64_MAX;
+    (void)pgwt_discovery_attach(d,&d->backends.entries[0]);
+    a=handoff(d,PGWT_DH_INVENTORY);
+    CHECK("P1 binding token no wrap",!a.binding_token && d->discovery_admission->next_binding_token==UINT64_MAX &&
+        d->discovery_admission->user_evidence_count && !identity_exists);
+    teardown(d);
+    d=setup();identity_insert_fail=true;
+    (void)pgwt_discovery_attach(d,&d->backends.entries[0]);
+    CHECK("P1 failed installation stays inventory",handoff(d,PGWT_DH_INVENTORY).cookie && !identity_exists);
+    for(size_t j=0;j<d->discovery_admission->record_count;++j)
+        CHECK("P1 failed installation cannot publish installed",d->discovery_admission->records[j].kind!=PGWT_DH_INSTALLED);
+    teardown(d);
+    d=setup();empty_inventory(d);d->backends.count=MAX_BACKENDS;d->backends.entries[0].pid=0;
+    (void)pgwt_discovery_scan(d);
