+#!/usr/bin/env python3
+"""Compile the exact producer/merge header pair in both inclusion orders."""
+import os
+from pathlib import Path
+import shlex
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def main():
+    with tempfile.TemporaryDirectory(prefix='pgwt-discovery-headers-') as temporary:
+        for merge_first in (False, True):
+            binary = str(Path(temporary) / 'headers')
+            command = shlex.split(os.environ.get('CC', 'cc')) + [
+                '-std=c11', '-Wall', '-Wextra', '-Werror', '-pedantic', '-Isrc',
+                'tests/discovery_headers_host.c', '-o', binary]
+            if merge_first:
+                command.append('-DPGWT_HEADERS_MERGE_FIRST')
+            subprocess.run(command, cwd=ROOT, check=True)
+            subprocess.run([binary], cwd=ROOT, check=True)
+    print('discovery headers: 2/2 inclusion orders PASS')
+
+
+if __name__ == '__main__':
+    main()
