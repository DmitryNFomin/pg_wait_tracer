diff --git a/tests/discovery_integration_i2.h b/tests/discovery_integration_i2.h
index 44458707..358686dc 100644
--- a/tests/discovery_integration_i2.h
+++ b/tests/discovery_integration_i2.h
@@ -560,3 +560,30 @@ static void integration_u_row(const char *id)
         "the coordinator finalises exactly when the frozen row allows it");
     printf("SECOND_AMENDMENT %s through coordinator PASS\n",id);cleanup(s);
 }
+
+/* P rows ([D3] variant b presentation) driven through the coordinator and
+ * asserted by the consumer fixture's own r9_expect. */
+static const char *const integration_p_rows[]={"P1","P2","P3"};
+static void integration_p_row(const char *id)
+{
+    struct ih *s=isetup(16);struct dh *h=s->h;discovery_case=id;
+    h->capture->config.coverage_gap=r9_ordinary;
+    s->checkpoint.reconciliation_ns=DB+30;s->checkpoint.reconciliation_count=3;
+    struct pgwt_discovery_attempt reg[2]={valid_record(PGWT_DH_INVENTORY),valid_record(PGWT_DH_INSTALLED)};
+    o_send(s,reg,2);
+    struct pgwt_discovery_attempt nw=valid_record(PGWT_DH_NO_WORD);nw.no_wait_word=true;nw.pointer_fence_ns=DB+7;o_send(s,&nw,1);
+    CHECK(issued(s,PGWT_DISC_CONFIRM_NO_WAIT_WORD)==1,"route c confirmed without role-support publication");
+    r9_complete(h,6);r9_complete(h,8);
+    if(!strcmp(id,"P2")) {
+        struct pgwt_discovery_attempt p=valid_record(PGWT_DH_POINTER);p.pointer_continuous=(fact){true,false};o_send(s,&p,1);
+        r9_complete(h,14);
+    }
+    if(!strcmp(id,"P3")) {
+        struct pgwt_discovery_attempt p=valid_record(PGWT_DH_POINTER);p.pointer_nonnull=0;o_send(s,&p,1);
+        o_terminal(s,30,DG,12);r9_exit(h,12);r9_complete(h,13);
+    }
+    if(!strcmp(id,"P2")) r9_expect(h,"F5[C0] F7[C0] VOID20[C0,unknown_evidence]",-1,-1,-1,1,false,1,0);
+    else r9_expect(h,!strcmp(id,"P3")?"F5[C0] F7[C0] EXIT_D12 F12[C0]":"F5[C0] F7[C0]",6,-1,6,0,true,0,0);
+    DC(!pgwt_capture_a2_observed_births(h->capture,DB,DB+100),"P no backend population contribution");
+    printf("P_ROW %s through coordinator PASS\n",id);cleanup(s);
+}
